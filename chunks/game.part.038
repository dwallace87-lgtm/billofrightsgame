4, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"5c0ee96c-c46b-42a8-ad8c-e5ed6328caa2\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"4fb7fbef-4569-4ec3-b6cb-b8bf6c9b9af3\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"41acc3f9-a9df-42e9-8a22-2a7f573f93ef\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"511b55cb-ed56-4943-88ee-7de1cc642304\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'VT323';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"229fee0b-33cd-4eef-8cdb-ad87ca4be0c5\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'VT323';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"6f8a4a90-77b7-47de-95f1-0c17ac225f3a\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'VT323';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"989fb3b0-d56e-42a3-9934-262c63aca8a5\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<script src=\"604d4ea8-337d-46a5-8da1-1b155a783046\"><\u002Fscript>\n<script src=\"26218f18-2f50-4e33-a6f0-b823d7bf5894\"><\u002Fscript>\n<style>\nhtml,body{margin:0;padding:0;background:#070a18;}\n*{box-sizing:border-box;}\na{color:#38e8ff;} a:hover{color:#8ff3ff;}\nbutton{font:inherit;color:inherit;}\n*:focus-visible{outline:3px solid #ffb347 !important;outline-offset:2px;}\n[data-rm=\"1\"] *{animation:none !important;transition:none !important;}\n@keyframes rpPulse{0%,100%{opacity:.35;transform:translate(-50%,0) scale(.85)}50%{opacity:1;transform:translate(-50%,-3px) scale(1)}}\n@keyframes rpBlink{0%,49%{opacity:1}50%,100%{opacity:0}}\n@keyframes rpFlicker{0%,100%{opacity:1}92%{opacity:1}93%{opacity:.75}94%{opacity:1}97%{opacity:.85}}\n@keyframes rpScan{0%{transform:translateY(-100%)}100%{transform:translateY(100vh)}}\n@keyframes rpRise{0%{opacity:0;transform:translateY(14px)}100%{opacity:1;transform:none}}\n@keyframes rpDrive{0%{top:-12%}100%{top:108%}}\n@keyframes rpCarE{0%{left:-6%}100%{left:103%}}\n@keyframes rpCarW{0%{left:103%}100%{left:-6%}}\n@keyframes rpCarS{0%{top:19%;opacity:0}6%{opacity:1}94%{opacity:1}100%{top:78%;opacity:0}}\n@keyframes rpCarN{0%{top:78%;opacity:0}6%{opacity:1}94%{opacity:1}100%{top:19%;opacity:0}}\n@keyframes rpF2{to{background-position-x:200%}}\n@keyframes rpF3{to{background-position-x:150%}}\n@keyframes rpTrain{0%{left:-34%}55%{left:104%}100%{left:104%}}\n@keyframes rpFlick{0%,100%{opacity:.75}40%{opacity:.95}44%{opacity:.45}48%{opacity:.9}70%{opacity:.65}}\n@keyframes rpMoon{0%,100%{opacity:.45;transform:translate(-50%,-50%) scale(1)}50%{opacity:.8;transform:translate(-50%,-50%) scale(1.12)}}\n@keyframes rpCloud{0%{transform:translateX(-12vw)}100%{transform:translateX(110vw)}}\n@keyframes rpWater{to{background-position-y:112.5%}}\n@keyframes rpTwinkle{0%,100%{opacity:0;transform:scale(.4)}50%{opacity:1;transform:scale(1)}}\n@keyframes rpPin{0%,100%{box-shadow:0 0 0 0 rgba(255,179,71,.8)}70%{box-shadow:0 0 0 12px rgba(255,179,71,0)}}\n@keyframes rpBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6%)}}\n@keyframes rpPop{0%{transform:scale(.3) rotate(-12deg);opacity:0}60%{transform:scale(1.12) rotate(4deg);opacity:1}100%{transform:scale(1) rotate(0)}}\n@keyframes rpGlitch{0%,100%{transform:none;text-shadow:3px 0 #ff3fb4,-3px 0 #38e8ff}20%{transform:translateX(-2px)}40%{transform:translateX(2px);text-shadow:-3px 0 #ff3fb4,3px 0 #38e8ff}60%{transform:none}}\n@media print{body *{visibility:hidden !important;} [data-print=\"1\"],[data-print=\"1\"] *{visibility:visible !important;} [data-print=\"1\"]{position:absolute !important;left:0;top:0;width:100% !important;max-height:none !important;overflow:visible !important;background:#fff !important;color:#000 !important;box-shadow:none !important;border:none !important;} [data-noprint=\"1\"]{display:none !important;}}\n<\u002Fstyle>\n<\u002Fhelmet>\n<div data-rm=\"{{ rm }}\" style=\"position:fixed;inset:0;background:#070a18;color:#e6ecff;font-family:'Figtree',system-ui,sans-serif;font-size:{{ fs }};line-height:1.45;overflow:hidden;\">\n\n<sc-if value=\"{{ loading }}\" hint-placeholder-val=\"{{ true }}\">\n  <div style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'VT323',monospace;font-size:28px;color:#38e8ff;letter-spacing:.08em;\">BOOTING CIVICLOCK…<span style=\"animation:rpBlink 1s steps(1) infinite;\">_<\u002Fspan><\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isTitle }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:absolute;inset:0;overflow:auto;background:linear-gradient(#05070f 0%,#0b1026 45%,#211a47 78%,#352870 100%);\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.22) 0 1px,transparent 1px 3px);z-index:3;\"><\u002Fdiv>\n    <sc-for list=\"{{ stars }}\" as=\"s\" hint-placeholder-count=\"0\"><div style=\"position:absolute;left:{{ s.l }};top:{{ s.t }};width:3px;height:3px;background:{{ s.c }};\"><\u002Fdiv><\u002Fsc-for>\n    <div style=\"position:absolute;left:0;right:0;bottom:0;height:42%;display:flex;align-items:flex-end;justify-content:center;gap:0;pointer-events:none;\">\n      <sc-for list=\"{{ sky }}\" as=\"b\" hint-placeholder-count=\"0\"><div style=\"width:{{ b.w }};aspect-ratio:{{ b.ar }};background-image:url({{ b.img }});background-size:{{ b.bs }};background-position:{{ b.bp }};background-repeat:no-repeat;image-rendering:pixelated;flex:none;margin-left:-0.6%;\"><\u002Fdiv><\u002Fsc-for>\n    <\u002Fdiv>\n    <div style=\"position:relative;z-index:2;min-height:100%;display:flex;flex-direction:column;justify-content:center;padding:6vh 7vw 34vh;gap:22px;max-width:1100px;\">\n      <div style=\"font-family:'VT323',monospace;font-size:22px;letter-spacing:.14em;color:#ffb347;\">MR. WALLACE’S U.S. HISTORY · NEW LIBERTY, 1997<\u002Fdiv>\n      <div style=\"display:flex;flex-direction:column;gap:8px;\">\n        <h1 style=\"margin:0;font-family:'Silkscreen',monospace;font-weight:700;font-size:clamp(38px,7vw,92px);line-height:.95;color:#e6ecff;animation:rpGlitch 4s steps(2) infinite;\">THE RIGHTS<br>PROTOCOL<\u002Fh1>\n        <div style=\"font-family:'Silkscreen',monospace;font-size:clamp(14px,1.8vw,22px);color:#ff3355;letter-spacing:.06em;animation:rpFlicker 5s infinite;\">CONSTITUTION.EXE HAS BEEN CORRUPTED<\u002Fdiv>\n      <\u002Fdiv>\n      <p style=\"margin:0;max-width:560px;font-size:18px;color:#c6d2f5;text-wrap:pretty;\">Investigate the cases. Recover the amendments. Escape the constitutional lockdown.<\u002Fp>\n      <div style=\"display:flex;flex-wrap:wrap;gap:12px;\">\n        <button sc-camel-on-click=\"{{ onNew }}\" style=\"min-height:52px;padding:0 26px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:17px;cursor:pointer;box-shadow:4px 4px 0 #04060d;\" style-hover=\"background:#8ff3ff;\">NEW INVESTIGATION<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onContinue }}\" disabled=\"{{ noSave }}\" style=\"min-height:52px;padding:0 26px;border:2px solid #ff3fb4;background:#0d1330;color:#ffd3ee;font-family:'Silkscreen',monospace;font-size:17px;cursor:pointer;box-shadow:4px 4px 0 #04060d;opacity:{{ contOpacity }};\" style-hover=\"background:#2a1240;\">CONTINUE<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onHow }}\" style=\"min-height:52px;padding:0 22px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">HOW TO PLAY<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onSettings }}\" style=\"min-height:52px;padding:0 22px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">SETTINGS<\u002Fbutton>\n      <\u002Fdiv>\n      <div style=\"display:flex;flex-wrap:wrap;gap:18px;font-size:14px;color:#9fb0e0;\">\n        <button sc-camel-on-click=\"{{ onSources }}\" style=\"background:none;border:none;padding:0;color:#38e8ff;cursor:pointer;text-decoration:underline;\">Sources &amp; Historical Notes<\u002Fbutton>\n        <a href=\"Teacher Guide.dc.html\" target=\"_blank\">Teacher Guide<\u002Fa>\n        <a href=\"{{ selfHref }}\" target=\"_blank\">Open in a new tab<\u002Fa>\n        <span>{{ storageMsg }}<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isBoot }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:absolute;inset:0;background:#04060d;display:flex;align-items:center;justify-content:center;padding:24px;overflow:auto;\">\n    <div style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(56,232,255,.04) 0 1px,transparent 1px 3px);\"><\u002Fdiv>\n    <div style=\"position:relative;width:100%;max-width:820px;border:3px solid #1b2652;border-radius:18px;background:radial-gradient(ellipse at center,#0b1a2a 0%,#04060d 80%);padding:36px 32px 120px;box-shadow:inset 0 0 80px rgba(56,232,255,.12);animation:rpFlicker 6s infinite;\">\n      <div style=\"font-family:'VT323',monospace;font-size:26px;color:#4dff9a;display:flex;flex-direction:column;gap:6px;\">\n        <div style=\"color:#38e8ff;\">CIVICLOCK v4.0 — CITY OF NEW LIBERTY<\u002Fdiv>\n        <sc-for list=\"{{ bootLines }}\" as=\"l\" hint-placeholder-count=\"0\"><div style=\"color:{{ l.c }};animation:rpRise .3s ease-out;\">&gt; {{ l.t }}<\u002Fdiv><\u002Fsc-for>\n        <span style=\"animation:rpBlink 1s steps(1) infinite;\">_<\u002Fspan>\n      <\u002Fdiv>\n      <sc-if value=\"{{ showAccept }}\" hint-placeholder-val=\"{{ false }}\">\n        <div style=\"margin-top:28px;display:flex;justify-content:center;\">\n          <button sc-camel-on-click=\"{{ onAccept }}\" style=\"min-height:60px;padding:0 34px;border:3px solid #4dff9a;background:#4dff9a;color:#04060d;font-family:'Silkscreen',monospace;font-size:20px;cursor:pointer;box-shadow:0 0 30px rgba(77,255,154,.45);\" style-hover=\"background:#a8ffcf;\">[ ACCEPT THE MISSION ]<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fsc-if>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isGame }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:absolute;inset:0;display:flex;flex-direction:column;\">\n    <header style=\"flex:none;display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;padding:8px 14px;background:#060916;border-bottom:2px solid #1b2652;\">\n      <div style=\"display:flex;align-items:center;gap:10px;min-width:0;\">\n        <div style=\"font-family:'Silkscreen',monospace;font-size:15px;color:#04060d;background:#38e8ff;padding:4px 8px;\">R.R.U.<\u002Fdiv>\n        <div style=\"font-family:'VT323',monospace;font-size:20px;color:#9fb0e0;white-space:nowrap;\">{{ chapter }}<\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"flex:1 1 280px;min-width:0;display:flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid #6b4a1f;background:#1a1206;border-radius:4px;\">\n        <span style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;flex:none;\">OBJECTIVE<\u002Fspan>\n        <span style=\"font-size:14px;color:#ffe2b8;min-width:0;\">{{ objective }}<\u002Fspan>\n      <\u002Fdiv>\n      <div style=\"display:flex;align-items:center;gap:10px;\" title=\"Recovered amendments\">\n        <span style=\"font-family:'Silkscreen',monospace;font-size:12px;color:#4dff9a;\">FILES {{ filesN }}/10<\u002Fspan>\n        <div style=\"display:flex;gap:2px;\"><sc-for list=\"{{ segs }}\" as=\"g\" hint-placeholder-count=\"10\"><div style=\"width:8px;height:16px;background:{{ g.bg }};\"><\u002Fdiv><\u002Fsc-for><\u002Fdiv>\n        <span style=\"font-family:'Silkscreen',monospace;font-size:12px;color:#38e8ff;\">CLUES {{ cluesN }}<\u002Fspan>\n      <\u002Fdiv>\n      <nav style=\"display:flex;flex-wrap:wrap;gap:6px;\">\n        <button sc-camel-on-click=\"{{ onInv }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">EVIDENCE<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onDb }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">DATABASE<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onGloss }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">GLOSSARY<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onHelp }}\" style=\"min-height:36px;padding:0 12px;border:2px solid #ffb347;background:#2a1a06;color:#ffd08a;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"background:#4a2e0a;\">HELP / CLUE<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onSet }}\" aria-label=\"Settings\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">SETTINGS<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onMenu }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">MENU<\u002Fbutton>\n      <\u002Fnav>\n    <\u002Fheader>\n\n    <main style=\"flex:1;min-height:0;overflow:auto;display:flex;flex-wrap:wrap;align-content:flex-start;gap:14px;padding:14px 14px 190px;\">\n      <section style=\"flex:1 1 620px;min-width:0;display:flex;flex-direction:column;gap:10px;align-items:center;\">\n        <div style=\"width:min(100%,calc((100vh - 230px) * 1.7778));min-width:min(100%,520px);display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;\">\n          <span style=\"font-family:'VT323',monospace;font-size:20px;color:#ff3fb4;\">{{ locCode }}<\u002Fspan>\n          <h2 style=\"margin:0;font-family:'Silkscreen',monospace;font-size:20px;line-height:1.2;font-weight:700;color:#e6ecff;\">{{ locTitle }}<\u002Fh2>\n          <span style=\"font-size:14px;color:#9fb0e0;flex:1;min-width:120px;\">{{ locPlace }}<\u002Fspan>\n          <sc-if value=\"{{ hasNext }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ onNextStep }}\" style=\"margin-left:auto;min-height:40px;padding:0 14px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;box-shadow:3px 3px 0 #04060d;\" style-hover=\"background:#8ff3ff;\">▶ NEXT STEP<\u002Fbutton><\u002Fsc-if>\n        <\u002Fdiv>\n        <div style=\"position:relative;width:min(100%,calc((100vh - 230px) * 1.7778));min-width:min(100%,520px);aspect-ratio:16/9;background:#04060d;border:3px solid #1b2652;box-shadow:0 0 0 3px #04060d,0 10px 40px rgba(0,0,0,.6);overflow:hidden;\">\n          <sc-if value=\"{{ isRoom }}\" hint-placeholder-val=\"{{ false }}\">\n            <div role=\"img\" aria-label=\"{{ sceneAlt }}\" style=\"position:absolute;inset:0;background-image:url({{ sceneImg }});background-size:100% 100%;image-rendering:pixelated;\"><\u002Fdiv>\n            <div style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.12) 0 1px,transparent 1px 3px);\"><\u002Fdiv>\n            <sc-for list=\"{{ hotspots }}\" as=\"h\" hint-placeholder-count=\"0\">\n              <button sc-camel-on-click=\"{{ h.onClick }}\" aria-label=\"{{ h.label }}\" title=\"{{ h.label }}\" style=\"position:absolute;left:{{ h.l }};top:{{ h.t }};width:{{ h.w }};height:{{ h.h }};background:transparent;border:2px solid {{ h.bd }};border-radius:3px;cursor:pointer;padding:0;transition:background .15s,border-color .15s,box-shadow .15s;\" style-hover=\"background:rgba(56,232,255,.14);border-color:#38e8ff;box-shadow:0 0 16px rgba(56,232,255,.55);\">\n                <sc-if value=\"{{ h.isNext }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"position:absolute;inset:-4px;border:3px solid #38e8ff;box-shadow:0 0 18px #38e8ff,inset 0 0 12px rgba(56,232,255,.4);pointer-events:none;animation:rpFlicker 2s infinite;\"><\u002Fspan><span style=\"position:absolute;left:50%;top:-26px;transform:translateX(-50%);font-family:'Silkscreen',monospace;font-size:11px;padding:2px 6px;background:#38e8ff;color:#04060d;white-space:nowrap;pointer-events:none;\">▼ NEXT<\u002Fspan><\u002Fsc-if>\n                <sc-if value=\"{{ h.marker }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"position:absolute;left:50%;top:-10px;width:7px;height:7px;background:#ffb347;transform:translate(-50%,0) rotate(45deg);opacity:.55;\"><\u002Fspan><\u002Fsc-if>\n                <sc-if value=\"{{ h.isNew }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"position:absolute;right:2px;bottom:2px;font-family:'Silkscreen',monospace;font-size:9px;color:#04060d;background:#4dff9a;padding:0 3px;\">✓<\u002Fspan><\u002Fsc-if>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fsc-if>\n          <sc-if value=\"{{ isMap }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);aspect-ratio:1650/953;overflow:hidden;\">\n              <img src=\"{{ RES.map_city }}\" alt=\"Pixel-art night map of New Liberty with eleven locations\" style=\"position:absolute;inset:0;width:100%;height:100%;display:block;image-rendering:pixelated;\">\n              <div style=\"position:absolute;left:0;right:0;top:10.4%;height:5.4%;background-image:url({{ RES.water }});background-size:9.7% 900%;background-repeat:repeat-x;mix-blend-mode:screen;opacity:.42;animation:rpWater 2.2s steps(8) infinite;pointer-events:none;\"><\u002Fdiv>\n              <div style=\"position:absolute;left:77.8%;top:3.4%;width:9%;aspect-ratio:1;border-radius:999px;background:radial-gradient(circle,rgba(190,215,255,.55),rgba(120,150,255,0) 65%);mix-blend-mode:screen;animation:rpMoon 5s ease-in-out infinite;pointer-events:none;\"><\u002Fdiv>\n              <sc-for list=\"{{ clouds }}\" as=\"c\" hint-placeholder-count=\"0\"><div style=\"position:absolute;left:0;top:{{ c.t }};width:{{ c.w }};aspect-ratio:160/60;background-image:url({{ RES.cloud }});background-size:100% 100%;opacity:.7;animation:rpCloud {{ c.dur }} linear infinite;animation-delay:{{ c.delay }};pointer-events:none;image-rendering:pixelated;\"><\u002Fdiv><\u002Fsc-for>\n              <sc-for list=\"{{ lamps }}\" as=\"g\" hint-placeholder-count=\"0\"><div style=\"position:absolute;left:{{ g.l }};top:{{ g.t }};width:4.4%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:999px;background:radial-gradient(circle,rgba(255,200,110,.6),rgba(255,170,60,.18) 40%,rgba(255,170,60,0) 70%);mix-blend-mode:screen;animation:rpFlick {{ g.dur }} ease-in-out infinite;animation-delay:{{ g.delay }};pointer-events:none;\"><\u002Fdiv><\u002Fsc-for>\n              <sc-for list=\"{{ flies }}\" as=\"f\" hint-placeholder-count=\"0\"><div style=\"position:absolute;left:{{ f.l }};top:{{ f.t }};width:4px;height:4px;border-radius:999px;background:#ffe58a;box-shadow:0 0 6px 2px rgba(255,220,120,.8);animation:rpTwinkle {{ f.dur }} ease-in-out infinite;animation-delay:{{ f.delay }};pointer-events:none;\"><\u002Fdiv><\u002Fsc-for>\n              <sc-for list=\"{{ carsH }}\" as=\"c\" hint-placeholder-count=\"0\"><div style=\"position:absolute;left:{{ c.l0 }};top:{{ c.t }};width:4.2%;aspect-ratio:160/100;background-image:url({{ RES.cars_h }});background-size:200% 1200%;background-position-x:0%;background-position-y:{{ c.row }};background-repeat:no-repeat;image-rendering:pixelated;animation:{{ c.anim }} {{ c.dur }} linear infinite,rpF2 .5s steps(2) infinite;animation-delay:{{ c.delay }},0s;pointer-events:none;\"><\u002Fdiv><\u002Fsc-for>\n              <sc-for list=\"{{ carsV }}\" as=\"c\" hint-placeholder-count=\"0\"><div style=\"position:absolute;left:{{ c.l }};top:{{ c.t0 }};width:2.3%;aspect-ratio:80/164;background-image:url({{ RES.cars_v }});background-size:300% 1200%;background-position-x:0%;background-position-y:{{ c.row }};background-repeat:no-repeat;image-rendering:pixelated;animation:{{ c.anim }} {{ c.dur }} linear infinite,rpF3 .6s steps(3) infinite;animation-delay:{{ c.delay }},0s;pointer-events:none;\"><\u002Fdiv><\u002Fsc-for>\n              <div style=\"position:absolute;left:-34%;top:84.6%;width:31%;aspect-ratio:740/76;background-image:url({{ RES.train }});background-size:100% 100%;image-rendering:pixelated;animation:rpTrain 26s linear infinite;animation-delay:-6s;pointer-events:none;filter:drop-shadow(0 0 6px rgba(255,200,120,.45));\"><\u002Fdiv>\n              <sc-for list=\"{{ mapLocs }}\" as=\"b\" hint-placeholder-count=\"0\">\n                <button sc-camel-on-click=\"{{ b.onClick }}\" aria-label=\"{{ b.aria }}\" title=\"{{ b.place }}\" style=\"position:absolute;left:{{ b.l }};top:{{ b.t }};width:{{ b.w }};height:{{ b.h }};background:{{ b.shade }};border:2px solid {{ b.ring }};border-radius:14px;padding:0;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;transition:background .2s,border-color .2s,box-shadow .2s;\" style-hover=\"background:rgba(56,232,255,.14);border-color:#38e8ff;box-shadow:0 0 22px rgba(56,232,255,.55);\">\n                  <span style=\"position:absolute;left:50%;top:{{ b.pinTop }};width:34%;aspect-ratio:1;transform:translate(-50%,0);border-radius:10px;animation:{{ b.pinAnim }};pointer-events:none;\"><\u002Fspan>\n                  <sc-if value=\"{{ b.badgeOn }}\" hint-placeholder-val=\"{{ false }}\"><span style=\"position:absolute;right:-2%;top:-6%;min-width:24px;height:24px;padding:0 6px;border-radius:999px;display:flex;align-items:center;justify-content:center;background:{{ b.badgeBg }};color:{{ b.badgeFg }};font-family:'Silkscreen',monospace;font-size:11px;border:2px solid #04060d;\">{{ b.badge }}<\u002Fspan><\u002Fsc-if>\n                  <span style=\"margin-bottom:4%;font-family:'Silkscreen',monospace;font-size:clamp(8px,0.8vw,11px);line-height:1.1;padding:3px 7px;border-radius:999px;background:{{ b.tagBg }};color:{{ b.tagFg }};border:2px solid {{ b.tagBd }};white-space:nowrap;box-shadow:0 2px 0 #04060d;\">{{ b.label }}<\u002Fspan>\n                <\u002Fbutton>\n              <\u002Fsc-for>\n              <div aria-hidden=\"true\" style=\"position:absolute;left:{{ botL }};top:{{ botT }};width:4.2%;aspect-ratio:112/200;background-image:url({{ RES.robot_walk }});background-size:2700% 100%;background-position:{{ botPos }} 0%;background-repeat:no-repeat;image-rendering:pixelated;pointer-events:none;filter:drop-shadow(0 3px 2px rgba(0,0,0,.7)) drop-shadow(0 0 6px rgba(255,138,61,.5));animation:{{ botAnim }};\"><\u002Fdiv>\n              <div style=\"position:absolute;left:1.5%;bottom:1.5%;font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;letter-spacing:.1em;background:rgba(4,6,13,.7);padding:3px 8px;border-radius:999px;\">NEW LIBERTY · CITY GRID<\u002Fdiv>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Fsection>\n\n      <aside style=\"flex:1 1 280px;max-width:420px;min-width:0;display:flex;flex-direction:column;gap:12px;\">\n        <div style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:6px;\">\n          <div style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;\">CURRENT OBJECTIVE<\u002Fdiv>\n          <div style=\"font-size:15px;color:#e6ecff;text-wrap:pretty;\">{{ objective }}<\u002Fdiv>\n          <sc-if value=\"{{ locAmOn }}\" hint-placeholder-val=\"{{ false }}\"><div style=\"font-size:13px;color:#9fb0e0;\">{{ locAm }}<\u002Fdiv><\u002Fsc-if>\n        <\u002Fdiv>\n        <sc-if value=\"{{ hasNext }}\" hint-placeholder-val=\"{{ false }}\">\n          <button sc-camel-on-click=\"{{ onNextStep }}\" style=\"text-align:left;display:flex;align-items:center;gap:12px;min-height:60px;padding:10px 14px;background:#38e8ff;border:3px solid #38e8ff;color:#04060d;cursor:pointer;box-shadow:4px 4px 0 #04060d;\" style-hover=\"background:#8ff3ff;\">\n            <span style=\"font-family:'Silkscreen',monospace;font-size:22px;flex:none;\">▶<\u002Fspan>\n            <span style=\"display:flex;flex-direction:column;gap:2px;\"><span style=\"font-family:'Silkscreen',monospace;font-size:11px;\">DO THIS NEXT<\u002Fspan><span style=\"font-size:16px;font-weight:800;line-height:1.25;\">{{ nextLabel }}<\u002Fspan><\u002Fspan>\n          <\u002Fbutton>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ isRoom }}\" hint-placeholder-val=\"{{ false }}\">\n          <sc-if value=\"{{ hasTerminals }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:8px;\">\n              <div style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">CASE TERMINALS<\u002Fdiv>\n              <sc-for list=\"{{ terminals }}\" as=\"p\" hint-placeholder-count=\"0\">\n                <button sc-camel-on-click=\"{{ p.onClick }}\" disabled=\"{{ p.disabled }}\" style=\"text-align:left;display:flex;gap:10px;align-items:center;min-height:44px;padding:6px 10px;background:{{ p.bg }};border:2px solid {{ p.bd }};color:{{ p.fg }};cursor:{{ p.cursor }};\" style-hover=\"filter:brightness(1.2);\">\n                  <span style=\"font-family:'Silkscreen',monospace;font-size:11px;flex:none;width:58px;\">{{ p.tag }}<\u002Fspan>\n                  <span style=\"font-size:14px;font-weight:600;\">{{ p.title }}<span style=\"display:block;font-weight:400;font-size:12px;color:#9fb0e0;\">{{ p.sub }}<\u002Fspan><\u002Fspan>\n                <\u002Fbutton>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fsc-if>\n          <div style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:6px;\">\n            <div style=\"display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">MORE TO EXPLORE (OPTIONAL)<\u002Fspan><span style=\"font-size:12px;color:#9fb0e0;\">{{ foundN }}<\u002Fspan><\u002Fdiv>\n            <sc-for list=\"{{ inspect }}\" as=\"h\" hint-placeholder-count=\"0\">\n              <button sc-camel-on-click=\"{{ h.onClick }}\" style=\"text-align:left;display:flex;gap:8px;align-items:center;min-height:38px;padding:4px 8px;background:transparent;border:1px solid #1f2a5a;color:#e6ecff;cursor:pointer;font-size:14px;\" style-hover=\"background:#16204a;border-color:#38e8ff;\">\n                <span style=\"width:18px;flex:none;font-family:'Silkscreen',monospace;font-size:11px;color:{{ h.mc }};\">{{ h.mark }}<\u002Fspan><span>{{ h.label }}<\u002Fspan>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <sc-if value=\"{{ isMap }}\" hint-placeholder-val=\"{{ false }}\">\n          <div style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:6px;\">\n            <div style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">LOCATIONS<\u002Fdiv>\n            <sc-for list=\"{{ mapLocs }}\" as=\"b\" hint-placeholder-count=\"0\">\n              <button sc-camel-on-click=\"{{ b.onClick }}\" style=\"text-align:left;display:flex;gap:8px;align-items:center;min-height:38px;padding:4px 8px;background:transparent;border:1px solid #1f2a5a;color:{{ b.listFg }};cursor:pointer;font-size:14px;\" style-hover=\"background:#16204a;border-color:#38e8ff;\">\n                <span style=\"width:74px;flex:none;font-family:'Silkscreen',monospace;font-size:10px;color:{{ b.tagFg }};\">{{ b.listStatus }}<\u002Fspan><span>{{ b.place }}<\u002Fspan>\n              <\u002Fbutton>\n            <\u002Fsc-for>\n          <\u002Fdiv>\n        <\u002Fsc-if>\n        <div style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n          <sc-if value=\"{{ showBackMap }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ onBackMap }}\" style=\"flex:1;min-height:44px;padding:0 14px;border:2px solid #38e8ff;background:#0d1330;color:#38e8ff;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"background:#13305a;\">◂ CITY MAP<\u002Fbutton><\u002Fsc-if>\n          <sc-if value=\"{{ showBackHq }}\" hint-placeholder-val=\"{{ false }}\"><button sc-camel-on-click=\"{{ onBackHq }}\" style=\"flex:1;min-height:44px;padding:0 14px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">◂ R.R.U. HQ<\u002Fbutton><\u002Fsc-if>\n        <\u002Fdiv>\n      <\u002Faside>\n    <\u002Fmain>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ isVictory }}\" hint-placeholder-val=\"{{ false }}\">\n  <div style=\"position:absolute;inset:0;overflow:auto;background:{{ vicBg }};transition:background 2.5s ease;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;padding:40px 20px 200px;\">\n    <div style=\"font-family:'VT323',monospace;font-size:26px;color:{{ vicSubColor }};letter-spacing:.1em;text-align:center;\">{{ vicSub }}<\u002Fdiv>\n    <div style=\"display:grid;grid-template-columns:repeat(5,minmax(0,120px));gap:12px;max-width:680px;width:100%;\">\n      <sc-for list=\"{{ vicTiles }}\" as=\"t\" hint-placeholder-count=\"10\">\n        <div style=\"aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;border:3px solid {{ t.bd }};background:{{ t.bg }};box-shadow:{{ t.sh }};transition:all .6s ease;\">\n          <span style=\"font-family:'Silkscreen',monospace;font-size:28px;color:{{ t.fg }};\">{{ t.roman }}<\u002Fspan>\n          <span style=\"font-size:11px;color:{{ t.fg }};text-align:center;padding:0 4px;\">{{ t.title }}<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fsc-for>\n    <\u002Fdiv>\n    <sc-if value=\"{{ vicText }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"font-family:'VT323',monospace;font-size:28px;line-height:1.25;color:#4dff9a;text-align:center;animation:rpRise .6s ease-out;\">\n        <div>SYSTEM RESTORED<\u002Fdiv><div>BILL OF RIGHTS: 10/10<\u002Fdiv><div>NEW LIBERTY PROTOCOL: SECURE<\u002Fdiv><div style=\"color:#f5c542;\">INVESTIGATOR STATUS: CERTIFIED<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ vicDone }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"display:flex;flex-direction:column;align-items:center;gap:18px;animation:rpRise .6s ease-out;\">\n        <div style=\"font-family:'Silkscreen',monospace;font-size:clamp(20px,3vw,34px);color:#f5c542;text-align:center;\">MISSION COMPLETE — THE CONSTITUTION IS BACK ONLINE.<\u002Fdiv>\n        <div style=\"display:flex;flex-wrap:wrap;gap:12px;justify-content:center;\">\n          <button sc-camel-on-click=\"{{ onReport }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #f5c542;background:#f5c542;color:#04060d;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"background:#ffe08a;\">INVESTIGATOR REPORT<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ onDb }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #38e8ff;background:#0d1330;color:#38e8ff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"background:#13305a;\">REVIEW FILES<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ onPlayAgain }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">PLAY AGAIN<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ onBackHq }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">EXPLORE CITY<\u002Fbutton>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fsc-if>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ dlgOn }}\" hint-placeholder-val=\"{{ false }}\">\n  <div role=\"dialog\" aria-live=\"polite\" style=\"position:fixed;left:50%;bottom:14px;transform:translateX(-50%);width:min(900px,calc(100% - 20px));z-index:80;display:flex;gap:14px;align-items:stretch;padding:14px;background:#070b1c;border:3px solid {{ dlgColor }};box-shadow:0 0 0 3px #04060d,0 12px 40px rgba(0,0,0,.7);\">\n    <sc-if value=\"{{ dlgHasImg }}\" hint-placeholder-val=\"{{ false }}\">\n      <div style=\"flex:none;width:96px;height:96px;border:2px solid {{ dlgColor }};background:#04060d;\"><div style=\"width:100%;height:100%;background-image:url({{ dlgImg }});background-size:100% 100%;image-rendering:pixelated;\"><\u002Fdiv><\u002Fdiv>\n    <\u002Fsc-if>\n    <sc-if value=\"{{ dlgAnim }}\" hint-placeholder-val=\"{{ false }}\">\n      <div data-portrait=\"wallace\" aria-hidden=\"true\" style=\"flex:none;width:96px;height:131px;align-self:center;border:2px solid {{ dlgColor }};background-color:#04060d;background-image:url({{ RES.wallace }});background-size:1400% 100%;background-position:{{ dlgFramePos }};background-repeat:no-repeat;image-rendering:pixelated;\"><\u002Fdiv>\n    <\u002Fsc-if>\n    <div style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;\">\n      <div style=\"font-family:'Silkscreen',monospace;font-size:13px;color:{{ dlgColor }};\">{{ dlgName }}<\u002Fdiv>\n      <div style=\"font-size:19px;line-height:1.6;color:#eef2ff;min-height:56px;text-wrap:pretty;letter-spacing:.005em;\"><sc-for list=\"{{ dlgSeg }}\" as=\"sg\" hint-placeholder-count=\"0\"><span sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}<\u002Fspan><\u002Fsc-for><\u002Fdiv>\n      <div style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:auto;\">\n        <button sc-camel-on-click=\"{{ onSkipDlg }}\" style=\"min-height:40px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;font-size:13px;cursor:pointer;\" style-hover=\"color:#e6ecff;border-color:#9fb0e0;\">Skip scene<\u002Fbutton>\n        <button sc-camel-on-click=\"{{ onNext }}\" autofocus=\"{{ true }}\" style=\"min-height:40px;padding:0 18px;border:2px solid {{ dlgColor }};background:{{ dlgColor }};color:#04060d;font-family:'Silkscreen',monospace;font-size:13px;cursor:pointer;\" style-hover=\"filter:brightness(1.2);\">{{ dlgNextLabel }}<\u002Fbutton>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fdiv>\n<\u002Fsc-if>\n\n<sc-if value=\"{{ toastOn }}\" hint-placeholder-val=\"{{ false }}\">\n  <div role=\"status\" style=\"position:fixed;bottom:150px;right:16px;z-index:95;padding:10px 14px;background:#062a1a;border:2px solid #4dff9a;color:#bfffdc;font-family:'Silkscreen',monospace;font-size:12px;box-shadow:0 6px 20px rgba(0,0,0,.5);animation:rpRise .25s ease-out;\">{{ toastText }}<\u002Fdiv>\n<\u002Fsc-if>\n\n<!-- PUZZLE TERMINAL -->\n<sc-if value=\"{{ ovPz }}\" hint-placeholder-val=\"{{ false }}\">\n  <div data-pzscroll=\"1\" style=\"position:fixed;inset:0;z-index:60;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    <div role=\"dialog\" aria-label=\"{{ pzTitle }}\" style=\"width:100%;max-width:960px;margin:auto 0;background:#0a0f24;border:2px solid #38e8ff;box-shadow:0 0 0 4px #04060d,0 0 50px rgba(56,232,255,.22);display:flex;flex-direction:column;\">\n      <div style=\"display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;padding:10px 16px;background:#0e1a3a;border-bottom:2px solid #1b2652;\">\n        <span style=\"font-family:'VT323',monospace;font-size:18px;color:#38e8ff;\">CASE TERMINAL · {{ pzCode }}<\u002Fspan>\n        <span style=\"font-family:'Silkscreen',monospace;font-size:15px;color:#e6ecff;flex:1;min-width:200px;\">{{ pzTitle }}<\u002Fspan>\n        <div style=\"display:flex;gap:4px;align-items:center;\"><sc-for list=\"{{ pzDots }}\" as=\"d\" hint-placeholder-count=\"0\"><span style=\"width:22px;height:8px;background:{{ d.bg }};\"><\u002Fspan><\u002Fsc-for><span style=\"font-size:12px;color:#9fb0e0;margin-left:6px;white-space:nowrap;\">{{ pzStepLabel }}<\u002Fspan><\u002Fdiv>\n        <button sc-camel-on-click=\"{{ closeOv }}\" aria-label=\"Close terminal\" style=\"min-height:36px;padding:0 10px;border:1px solid #2f4