loseMiniGame()}\n  init(){\n    const D=window.RP_DATA;this.D=D;this.SC=window.RP_SCENES;this.M={};this.EV={};this.AM={};\n    D.missions.forEach(m=>{this.M[m.id]=m;m.hotspots.forEach(h=>{if(h.doc)this.EV[h.doc.id]={...h.doc,mid:m.id,place:m.place,hid:h.id}});(m.extraDocs||[]).forEach(d=>this.EV[d.id]={...d,mid:m.id,place:m.place,hid:null})});\n    D.amendments.forEach(a=>this.AM[a.n]=a);D.speakers.reyes=D.speakers.reyes_smile=D.speakers.wallace;\n    this._miniMessage=e=>this.onMiniMessage(e);window.addEventListener('message',this._miniMessage);\n    this.HQ={id:'hq',scene:'hq',code:'HEADQUARTERS',title:'Rights Recovery Unit',place:'Sub-level 3, City Archives',hotspots:D.hq.hotspots,puzzles:[],am:0};\n    let ok=true;try{localStorage.setItem('rp.t','1');localStorage.removeItem('rp.t')}catch(e){ok=false}\n    const sv=lsGet(SK);const set={...DEF_SET,...(lsGet(SS)||{})};\n    this.setState({ready:true,set,storageOk:ok,saved:sv&&sv.v===1?sv:null});\n    if(set.music)this.startMusic();\n  }\n  // ── persistence\n  fresh(){return {v:1,started:Date.now(),loc:'hq',files:[],found:{},inv:[],nulls:[],solved:{},steps:{},stats:{},miniGames:{},hints:0,intro:{},asked:{},log:[],done:false,doneAt:null,name:'',introDone:false}}\n  update(fn){const s=JSON.parse(JSON.stringify(this.state.save||this.fresh()));fn(s);if(s.log.length>300)s.log=s.log.slice(-300);this.setState({save:s,saved:s});lsSet(SK,s);return s}\n  setSet(k,v){const set={...this.state.set,[k]:v};this.setState({set});lsSet(SS,set);if(k==='music'){v?this.startMusic():this.stopMusic()}if(k==='sfx'&&v)this.sfx('ok')}\n  // ── audio (muted by default)\n  ac(){if(!this._ac){try{this._ac=new (window.AudioContext||window.webkitAudioContext)()}catch(e){return null}}if(this._ac.state==='suspended')this._ac.resume();return this._ac}\n  beep(f,d,type,g,when){const a=this.ac();if(!a)return;try{const o=a.createOscillator(),v=a.createGain();o.type=type||'square';o.frequency.value=f;const t=a.currentTime+(when||0);const gg=Math.max(0.0001,(g||0.05)*this.state.set.vol);v.gain.setValueAtTime(gg,t);v.gain.exponentialRampToValueAtTime(0.0001,t+d);o.connect(v);v.connect(a.destination);o.start(t);o.stop(t+d+0.03)}catch(e){}}\n  sfx(k){if(!this.state.set.sfx)return;const B=(...a)=>this.beep(...a);({click:()=>B(660,.05),type:()=>B(1200,.02,'square',.012),ok:()=>{B(523,.1);B(659,.1,'square',.05,.1);B(784,.22,'square',.05,.2)},bad:()=>B(190,.18,'sawtooth',.035),hint:()=>B(880,.12,'triangle',.05),unlock:()=>[392,523,659,784,1046].forEach((f,i)=>B(f,.16,'triangle',.06,i*.09))}[k]||(()=>{}))()}\n  startMusic(){if(this._mus)return;const n=[220,261.6,329.6,392,329.6,261.6,196,246.9];let i=0;this._mus=setInterval(()=>{if(!this.state.set.music)return;this.beep(n[i%8],.32,'triangle',.022);if(i%4===0)this.beep(n[i%8]/2,.7,'sine',.03);i++},420)}\n  stopMusic(){clearInterval(this._mus);this._mus=null}\n  // ── toast & log\n  toast(t){clearTimeout(this._tt);this.setState({toast:t});this._tt=setTimeout(()=>this.setState({toast:null}),2600)}\n  addLog(s,who,t){s.log.push({w:who,t})}\n  // ── dialogue\n  say(lines,cb){if(!lines||!lines.length){cb&&cb();return}this._cb=cb||null;if(this.state.save)this.update(s=>lines.forEach(l=>this.addLog(s,l.s,l.t)));this.setState({dlg:{lines,i:0,n:0}},()=>this.type())}\n  restE(e){return e==='happy'?13:e==='anger'?6:8}\n  vis(t,n,e){const ch=(t[n-1]||' ').toLowerCase(),pr=(t[n-2]||'').toLowerCase(),nx=(t[n]||'').toLowerCase();\n    if(!/[a-z]/.test(ch))return /[.!?…]/.test(ch)?this.restE(e):(e==='anger'&&/[,—-]/.test(ch)?6:8);\n    if(ch==='h'&&pr==='t')return 1;if(ch==='h'&&(pr==='s'||pr==='c'))return 7;if(ch==='t'&&nx==='h')return 1;if((ch==='s'||ch==='c')&&nx==='h')return 7;\n    if(ch==='e'&&(pr==='e'||nx==='e'))return 3;if(ch==='o'&&nx==='o')return 4;\n    const M={a:0,e:0,i:0,o:2,u:4,l:5,j:7,b:8,m:8,p:8,f:9,v:9,w:10,q:10,g:12,k:12,y:3,h:0,r:11};return M[ch]!=null?M[ch]:11}\n  speak(text,e,field){field=field||'mouth';clearInterval(this._mt);if(this.state.set.rm){this.setState({[field]:this.restE(e)});return}let n=0,last=0;this._mt=setInterval(()=>{n++;if(n>=text.length){clearInterval(this._mt);this.setState({[field]:this.restE(e)});return}const now=Date.now();if(now-last>=70){const f=this.vis(text,n,e);if(f!==this.state[field]){this.setState({[field]:f});last=now}}},30)}\n  type(){clearInterval(this._tw);clearInterval(this._mt);const st=this.state.set;const d0=this.state.dlg;if(!d0)return;const l0=d0.lines[d0.i];const anim=!!(this.D.speakers[l0.s]||{}).anim&&!st.rm;this._lastM=0;\n    if(st.rm||!st.tw){this.setState(p=>({dlg:p.dlg?{...p.dlg,n:99999}:null,mouth:this.restE(l0.e)}));if(anim)this.speak(l0.t,l0.e);return}\n    let k=0;this.setState({mouth:this.restE(l0.e)});this._tw=setInterval(()=>{const d=this.state.dlg;if(!d){clearInterval(this._tw);return}const l=d.lines[d.i];const len=l.t.length;if(d.n>=len){clearInterval(this._tw);this.setState({mouth:this.restE(l.e)});return}const n=d.n+1;const o={dlg:{...d,n}};if(anim){const now=Date.now();if(now-this._lastM>=70){const f=this.vis(l.t,n,l.e);if(f!==this.state.mouth){o.mouth=f;this._lastM=now}}}this.setState(o);if(k++%4===0)this.sfx('type')},28)}\n  next(){const d=this.state.dlg;if(!d)return;const len=d.lines[d.i].t.length;if(d.n\u003Clen){clearInterval(this._tw);clearInterval(this._mt);this.setState({dlg:{...d,n:len},mouth:this.restE(d.lines[d.i].e)});return}if(d.i+1\u003Cd.lines.length){this.setState({dlg:{...d,i:d.i+1,n:0}},()=>this.type())}else this.endDlg()}\n  endDlg(){clearInterval(this._tw);clearInterval(this._mt);this.setState({dlg:null,mouth:8});const cb=this._cb;this._cb=null;cb&&cb()}\n  onKey(e){const tag=(e.target&&e.target.tagName)||'';if(e.key==='Escape'){if(this.state.sub)this.setState({sub:null});else if(this.state.ov&&this.state.ov!=='rec')this.closeOv();return}\n    if(this.state.dlg&&(e.key===' '||e.key==='Enter')&&!['BUTTON','INPUT','TEXTAREA','A'].includes(tag)){e.preventDefault();this.next()}}\n  // ── flow\n  newGame(){if(this.state.saved&&this.state.saved.introDone&&!this._confirmNew){this._confirmNew=true;this.openInfo('confirmNew');return}this._confirmNew=false;const s=this.fresh();this.setState({save:s,saved:s,ov:null,sub:null,pz:null});lsSet(SK,s);this.boot()}\n  boot(){this.setState({screen:'boot',boot:0,showAccept:false});clearInterval(this._bt);const fast=this.state.set.rm;this._bt=setInterval(()=>{const b=this.state.boot+1;this.setState({boot:b});if(b>=4){clearInterval(this._bt);setTimeout(()=>this.say(this.D.intro.lines,()=>this.setState({showAccept:true})),fast?100:700)}},fast?150:750)}\n  accept(){this.sfx('unlock');this.update(s=>{s.introDone=true;s.loc='hq'});this.setState({screen:'game',showAccept:false});setTimeout(()=>this.say(this.D.intro.accept),250)}\n  cont(){const s=this.state.saved;if(!s)return;this.setState({save:s,ov:null,sub:null});if(!s.introDone){this.boot();return}this.setState({screen:'game'});if(s.done&&s.loc==='vault')this.update(x=>{x.loc='hq'})}\n  toTitle(){this.setState({screen:'title',ov:null,sub:null,dlg:null,pz:null});clearInterval(this._tw)}\n  enter(loc){this.sfx('click');if(loc==='map'){const prev=this.state.save&&this.state.save.loc;const P=STAND[prev]||STAND.hq;this.setState({bot:{x:P[0],y:P[1],f:0,moving:false}})}this.setState({ov:null,sub:null,pz:null});this.update(s=>{s.loc=loc});const m=this.M[loc];if(m&&!this.state.save.intro[loc]){this.update(s=>{s.intro[loc]=1});setTimeout(()=>this.say(m.intro),200)}}\n  mDone(m){const s=this.state.save;return m.kind==='vault'?!!s.done:s.files.includes(m.am)}\n  mOpen(m){return m.req.every(id=>this.mDone(this.M[id]))}\n  curM(){const l=this.state.save&&this.state.save.loc;return l==='hq'?this.HQ:this.M[l]}\n  // ── hotspots / evidence\n  markFound(mid,hid){const k=mid+'.'+hid;if(!this.state.save.found[k])this.update(s=>{s.found[k]=1})}\n  collect(id,silent){const e=this.EV[id];if(!e)return;const isNull=e.icon==='null';const s=this.state.save;if(isNull?s.nulls.includes(id):s.inv.includes(id))return false;this.update(x=>{(isNull?x.nulls:x.inv).push(id);this.addLog(x,'doc','Collected: '+e.name)});if(!silent){this.sfx('ok');this.toast(isNull?'NULL FRAGMENT FOUND: '+e.name:'+ EVIDENCE: '+e.name)}return true}\n  hsClick(m,h){this.sfx('click');this.markFound(m.id,h.id);\n    switch(h.kind){\n      case 'doc':case 'null':this.collect(h.doc.id);this.openDoc(h.doc.id,m.id,h.id);break;\n      case 'talk':this.setState({ov:'talk',talk:{mid:m.id,hid:h.id,who:h.who,last:null,gave:null},talkMouth:8});if((this.D.speakers[h.who]||{}).anim)this.speak('What do you want to know?',null,'talkMouth');break;\n      case 'flavor':this.say(h.lines);break;\n      case 'terminal':this.terminal(m,h.id);break;\n      case 'map':this.enter('map');break;\n      case 'board':this.openInfo('board');break;\n      case 'database':this.panel('db');break;\n      case 'vault':{const v=this.M.vault;if(this.mOpen(v))this.enter('vault');else this.say([{s:'wallace',t:'The vault is sealed. It needs all ten amendment files — you have '+this.state.save.files.length+' of 10.'}]);break}\n    }}\n  openDoc(id,mid,hid){this.setState(p=>p.ov==='pz'||(p.ov&&p.ov!=='doc')?{sub:'doc',doc:{id,mid,hid}}:{ov:'doc',doc:{id,mid,hid}})}\n  ask(t,i){const m=this.M[t.mid]||this.HQ;const h=m.hotspots.find(x=>x.id===t.hid);const q=h.topics[i];let gave=null;if(q.gives){if(this.collect(q.gives,true))gave=q.gives;else gave=q.gives}this.update(s=>{s.asked[t.mid+'.'+t.hid+'.'+i]=1;this.addLog(s,'you',q.q);q.a.forEach(l=>this.addLog(s,l.s,l.t))});this.sfx('click');this.setState({talk:{...t,last:i,gave}});if((this.D.speakers[h.who]||{}).anim)this.speak(q.a.map(l=>l.t).join(' '),q.a[q.a.length-1].e,'talkMouth');if(gave)this.toast('+ EVIDENCE: '+this.EV[gave].name)}\n  // ── puzzles\n  pKey(mid,pid,i){return mid+'.'+pid+'.'+i}\n  pState(m,idx){const s=this.state.save;const p=m.puzzles[idx];if(s.solved[m.id+'.'+p.id])return 'solved';if(idx>0&&!s.solved[m.id+'.'+m.puzzles[idx-1].id])return 'wait';return p.needs.some(e=>!s.inv.includes(e))?'needs':'open'}\n  terminal(m,hid){const ps=m.puzzles;const open=ps.findIndex((p,i)=>p.at===hid&&this.pState(m,i)==='open');if(open>=0)return this.openPz(m.id,open);\n    const any=ps.findIndex((p,i)=>this.pState(m,i)==='open');const j=ps.findIndex((p,i)=>this.pState(m,i)!=='solved');\n    if(j\u003C0){this.say([{s:'sys',t:'All case terminals in this location are restored.'}]);return}\n    if(any>=0){this.openPz(m.id,any);return}\n    const miss=ps[j].needs.filter(e=>!this.state.save.inv.includes(e)).length;this.say([{s:'sys',t:'TERMINAL LOCKED — “'+ps[j].title+'” needs '+miss+' more clue'+(miss>1?'s':'')+'. Keep investigating the room.'}])}\n  openPz(mid,idx){const m=this.M[mid];const p=m.puzzles[idx];const s=this.state.save;const att=[...p.needs,...(p.attach||[])];p.steps.forEach(x=>{if(x.type==='evidence')att.push(...x.correct);if(x.doc)att.push(x.doc)});let added=0;[...new Set(att)].forEach(id=>{if(this.EV[id]&&this.collect(id,true))added++});if(added)setTimeout(()=>this.toast('+ '+added+' CASE FILE'+(added>1?'S':'')+' ATTACHED TO EVIDENCE'),50);let step=p.steps.findIndex((st,i)=>!s.steps[this.pKey(mid,p.id,i)]);if(step\u003C0)step=0;this.sfx('click');this.setState({ov:'pz',sub:null,pz:this.blank(mid,idx,step)})}\n  blank(mid,idx,step){return {miss:0,seed:Math.random().toString(36).slice(2),typeReq:null,typed:'',mid,idx,step,sel:null,multi:[],assign:{},active:null,seq:[],ev:[],build:{},fb:null,ok:false,hint:-1,tried:false}}\n  pzCur(){const z=this.state.pz;if(!z)return null;const m=this.M[z.mid];const p=m.puzzles[z.idx];return {z,m,p,st:p.steps[z.step],key:this.pKey(m.id,p.id,z.step)}}\n  setPz(o){this.setState(p=>({pz:{...p.pz,...o}}))}\n  stat(key,fn){this.update(s=>{const x=s.stats[key]||(s.stats[key]={t:0,h:0});fn(x,s)})}\n  wrong(text,responseOverride){const c=this.pzCur();if(!c||this.pzLocked(c))return;if(window.__rpTrackAttempt)window.__rpTrackAttempt(c,false,c.z,text,responseOverride);const misses=(c.z.miss||0)+1;const reset=misses>=3;const clue=c.st.hints&&c.st.hints.length?c.st.hints[Math.