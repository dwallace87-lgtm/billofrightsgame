gt[0],RY],[tgt[0],tgt[1]]];const segs=[];let tot=0;for(let i=1;i\u003Cpts.length;i++){const L=Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1]);if(L>0.5){segs.push([pts[i-1],pts[i],L]);tot+=L}}\n    if(tot\u003C2){cb&&cb();return}const dur=Math.min(1700,Math.max(500,tot/1.1));this._walking=true;const t0=performance.now();let lastF=0,step=0;this.sfx('click');\n    const tick=now=>{const p=Math.min(1,(now-t0)/dur);let dist=p*tot,x=pts[0][0],y=pts[0][1],dx=0,dy=1;for(const [a,b,L] of segs){if(dist\u003C=L){const k=dist/L;x=a[0]+(b[0]-a[0])*k;y=a[1]+(b[1]-a[1])*k;dx=b[0]-a[0];dy=b[1]-a[1];break}dist-=L;x=b[0];y=b[1];dx=b[0]-a[0];dy=b[1]-a[1]}\n      if(now-lastF>75){step++;lastF=now}const base=Math.abs(dx)>Math.abs(dy)?(dx>0?14:21):(dy>0?0:7);const n=base===21?6:7;\n      this.setState({bot:{x,y,f:base+(step%n),moving:p\u003C1}});if(p\u003C1)this._raf=requestAnimationFrame(tick);else{this._walking=false;this.setState({bot:{x,y,f:0,moving:false}});setTimeout(()=>cb&&cb(),120)}};\n    this._raf=requestAnimationFrame(tick)}\n  perm(key,n){const seed=String((this.state.save&&this.state.save.started)||1)+'|'+key;let hsh=2166136261;for(let i=0;i\u003Cseed.length;i++){hsh^=seed.charCodeAt(i);hsh=Math.imul(hsh,16777619)>>>0}const a=Array.from({length:n},(_,i)=>i);let r=hsh||1;for(let i=n-1;i>0;i--){r=Math.imul(r^(r>>>15),2246822507)>>>0;r=(r^(r>>>13))>>>0;const j=r%(i+1);[a[i],a[j]]=[a[j],a[i]]}return a}\n  openWord(k){if(!this.D.freedomWords[k])return;this.sfx('click');this.setState(p=>p.ov?{word:k,sub:'word'}:{word:k,ov:'word'})}\n  normT(t){return (t||'').toLowerCase().replace(/['’‘`“”]/g,'').replace(/[^a-z0-9 ]+/g,' ').replace(/\\s+/g,' ').trim()}\n  typeState(z){if(!z||!z.typeReq)return null;const tw=this.normT(z.typeReq).split(' '),uw=this.normT(z.typed).split(' ').filter(Boolean);const eq=(a,b)=>{if(a===b)return true;if(b.length\u003C5||Math.abs(a.length-b.length)>1)return false;let i=0,j=0,e=0;while(i\u003Ca.length&&j\u003Cb.length){if(a[i]===b[j]){i++;j++;continue}if(++e>1)return false;if(a.length>b.length)i++;else if(a.length\u003Cb.length)j++;else{i++;j++}}return e+(a.length-i)+(b.length-j)\u003C=1};let k=0;while(k\u003Cuw.length&&k\u003Ctw.length&&eq(uw[k],tw[k]))k++;const partial=k\u003Cuw.length&&k\u003Ctw.length&&tw[k].startsWith(uw[k])&&k===uw.length-1;const done=k===tw.length&&uw.length===tw.length;const off=!done&&k\u003Cuw.length&&!partial;return {done,k,total:tw.length,off,next:tw[k]||''}}\n  check(){const c=this.pzCur();if(!c||c.z.ok)return;const {st,z}=c;\n    if(st.type==='choice'){if(z.sel==null)return this.setPz({fb:{k:'hint',t:'Pick an answer first.'}});const o=st.options[z.sel];return o.ok?this.right(o.why):this.wrong(o.fb||'Not quite. Re-read the evidence and try again.')}\n    if(st.type==='multi'){if(!z.multi.length)return this.setPz({fb:{k:'hint',t:'Select at least one.'}});const bad=z.multi.map(i=>st.options[i]).find(o=>!o.ok);if(bad)return this.wrong(bad.fb||'One of your selections doesn’t fit.');const need=st.options.filter(o=>o.ok).length;if(z.multi.length\u003Cneed)return this.wrong('Everything you picked is correct — but you’re missing '+(need-z.multi.length)+'.');return this.right()}\n    if(st.type==='order'){const seq=z.seq;const bad=seq.map(id=>st.frags.find(f=>f.id===id)).find(f=>!st.answer.includes(f.id));if(bad)return this.wrong(bad.fb||'One fragment doesn’t belong.');if(seq.length\u003Cst.answer.length)return this.wrong('Not complete yet — '+(st.answer.length-seq.length)+' more real fragment(s) needed.');if(seq.join()!==st.answer.join())return this.wrong('All the right pieces — but the order doesn’t read correctly yet.');return this.right()}\n    if(st.type==='evidence'){if(!z.ev.length)return this.setPz({fb:{k:'hint',t:'Select evidence first.'}});const bad=z.ev.find(id=>!st.correct.includes(id));if(bad)return this.wrong((st.fb&&st.fb[bad])||'That piece doesn’t support this conclusion.');if(z.ev.length\u003Cst.correct.length)return this.wrong('Good start. You need '+st.correct.length+' pi