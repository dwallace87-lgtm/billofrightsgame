s.setPz({seq:z.seq.filter((x,j)=>j!==i)})}}));V.pzSeqEmpty=!z.seq.length;const orderKey=key+'|'+z.seed;if(!this._shuf||this._shuf.k!==orderKey){this._shuf={k:orderKey,o:this.perm(key,st.frags.length).map(i=>st.frags[i].id)}}V.pzPool=this._shuf.o.filter(id=>!z.seq.includes(id)).map(id=>({t:st.frags.find(f=>f.id===id).t,onClick:()=>{if(!dis)this.setPz({seq:z.seq.concat(id)})}}))}\n    if(T==='evidence')V.pzEv=this.perm(key,st.pool.length).map(i=>st.pool[i]).filter(id=>this.EV[id]).map(id=>{const e=this.EV[id];const sel=z.ev.includes(id);const ic=ICON[e.icon]||ICON.memo;const w=z.ok&&st.correct.includes(id);return {name:e.name,icon:ic[0],ic:ic[1],sel,bg:w?'#062a1a':sel?SEL.bg:UNS.bg,bd:w?'#4dff9a':sel?SEL.bd:UNS.bd,onClick:()=>{if(dis)return;this.setPz({ev:sel?z.ev.filter(x=>x!==id):z.ev.concat(id)})},onRead:()=>this.openDoc(id,e.mid,e.hid)}});\n    if(T==='build')V.pzCols=st.cols.map((col,ci)=>({label:col.label,options:this.perm(key+'c'+ci,col.options.length).map(oi=>{const o=col.options[oi];const sel=z.build[ci]===oi;const w=z.ok&&o.ok;return {t:o.t,seg:rich(o.t,this.state.set.hl),sel,bg:w?'#062a1a':sel?SEL.bg:UNS.bg,bd:w?'#4dff9a':sel?SEL.bd:UNS.bd,onClick:()=>{if(!dis)this.setPz({build:{...z.build,[ci]:oi}})}}})}));\n    const fb=z.fb;V.pzFbOn=!!fb;if(fb){const K={ok:['#062a1a','#4dff9a','CONFIRMED'],bad:['#2a0a12','#ff3355','NOT QUITE — HERE’S WHY'],hint:['#2a1a06','#ffb347',z.hint>=0&&fb.t===(st.hints||[])[z.hint]?'HINT '+(z.hint+1)+'/'+(st.hints||[]).length:'NOTE']}[fb.k];const isHint=fb.k==='hint'&&z.hint>=0&&fb.t===(st.hints||[])[z.hint];const emo=fb.k==='ok'?(z.miss?1:4):fb.k==='bad'?((z.miss||1)%2?2:5):isHint?3:0;V.pzEmoPos=(emo/5*100)+'%';V.pzFbBg=K[0];V.pzFbBd=K[1];V.pzFbHead=K[2];V.pzFbText=fb.t;V.pzFbSeg=rich(fb.t,this.state.set.hl)}\n    V.pzCanHint=!!(st.hints&&st.hints.length)&&!z.ok;V.pzHintLabel='HINT '+Math.min(z.hint+2,(st.hints||[]).length)+'/'+(st.hints||[]).length;\n    V.pzShowCheck=T!=='info'&&T!=='match'&&!z.ok;V.pzCheckLabel=this.pzLocked(c