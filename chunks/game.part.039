e60a3\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Figtree';\n  font-style: normal;\n  font-weight: 800;\n  font-display: swap;\n  src: url(\"9377a548-8133-4875-8312-1cdbc339d631\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"5c0ee96c-c46b-42a8-ad8c-e5ed6328caa2\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"4fb7fbef-4569-4ec3-b6cb-b8bf6c9b9af3\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"41acc3f9-a9df-42e9-8a22-2a7f573f93ef\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Silkscreen';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"511b55cb-ed56-4943-88ee-7de1cc642304\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'VT323';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"229fee0b-33cd-4eef-8cdb-ad87ca4be0c5\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'VT323';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"6f8a4a90-77b7-47de-95f1-0c17ac225f3a\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'VT323';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"989fb3b0-d56e-42a3-9934-262c63aca8a5\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\u003C/style>\n\u003Cscript src=\"604d4ea8-337d-46a5-8da1-1b155a783046\">\u003C/script>\n\u003Cscript src=\"26218f18-2f50-4e33-a6f0-b823d7bf5894\">\u003C/script>\n\u003Cstyle>\nhtml,body{margin:0;padding:0;background:#070a18;}\n*{box-sizing:border-box;}\na{color:#38e8ff;} a:hover{color:#8ff3ff;}\nbutton{font:inherit;color:inherit;}\n*:focus-visible{outline:3px solid #ffb347 !important;outline-offset:2px;}\n[data-rm=\"1\"] *{animation:none !important;transition:none !important;}\n@keyframes rpPulse{0%,100%{opacity:.35;transform:translate(-50%,0) scale(.85)}50%{opacity:1;transform:translate(-50%,-3px) scale(1)}}\n@keyframes rpBlink{0%,49%{opacity:1}50%,100%{opacity:0}}\n@keyframes rpFxPulse{0%,100%{opacity:.35}50%{opacity:1}}\n@keyframes rpFxDrift{0%{transform:translateY(0)}50%{transform:translateY(-.6%)}100%{transform:translateY(0)}}\n@keyframes rpFxFlicker{0%{opacity:.9}18%{opacity:.35}22%{opacity:.8}47%{opacity:.5}52%{opacity:1}71%{opacity:.3}75%{opacity:.85}100%{opacity:.9}}\n@keyframes rpFlicker{0%,100%{opacity:1}92%{opacity:1}93%{opacity:.75}94%{opacity:1}97%{opacity:.85}}\n@keyframes rpScan{0%{transform:translateY(-100%)}100%{transform:translateY(100vh)}}\n@keyframes rpRise{0%{opacity:0;transform:translateY(14px)}100%{opacity:1;transform:none}}\n@keyframes rpDrive{0%{top:-12%}100%{top:108%}}\n@keyframes rpCarE{0%{left:-6%}100%{left:103%}}\n@keyframes rpCarW{0%{left:103%}100%{left:-6%}}\n@keyframes rpCarS{0%{top:19%;opacity:0}6%{opacity:1}94%{opacity:1}100%{top:78%;opacity:0}}\n@keyframes rpCarN{0%{top:78%;opacity:0}6%{opacity:1}94%{opacity:1}100%{top:19%;opacity:0}}\n@keyframes rpF2{to{background-position-x:200%}}\n@keyframes rpF3{to{background-position-x:150%}}\n@keyframes rpTrain{0%{left:-34%}55%{left:104%}100%{left:104%}}\n@keyframes rpFlick{0%,100%{opacity:.75}40%{opacity:.95}44%{opacity:.45}48%{opacity:.9}70%{opacity:.65}}\n@keyframes rpMoon{0%,100%{opacity:.45;transform:translate(-50%,-50%) scale(1)}50%{opacity:.8;transform:translate(-50%,-50%) scale(1.12)}}\n@keyframes rpCloud{0%{transform:translateX(-12vw)}100%{transform:translateX(110vw)}}\n@keyframes rpWater{to{background-position-y:112.5%}}\n@keyframes rpTwinkle{0%,100%{opacity:0;transform:scale(.4)}50%{opacity:1;transform:scale(1)}}\n@keyframes rpPin{0%,100%{box-shadow:0 0 0 0 rgba(255,179,71,.8)}70%{box-shadow:0 0 0 12px rgba(255,179,71,0)}}\n@keyframes rpBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6%)}}\n@keyframes rpPop{0%{transform:scale(.3) rotate(-12deg);opacity:0}60%{transform:scale(1.12) rotate(4deg);opacity:1}100%{transform:scale(1) rotate(0)}}\n@keyframes rpGlitch{0%,100%{transform:none;text-shadow:3px 0 #ff3fb4,-3px 0 #38e8ff}20%{transform:translateX(-2px)}40%{transform:translateX(2px);text-shadow:-3px 0 #ff3fb4,3px 0 #38e8ff}60%{transform:none}}\n@media print{body *{visibility:hidden !important;} [data-print=\"1\"],[data-print=\"1\"] *{visibility:visible !important;} [data-print=\"1\"]{position:absolute !important;left:0;top:0;width:100% !important;max-height:none !important;overflow:visible !important;background:#fff !important;color:#000 !important;box-shadow:none !important;border:none !important;} [data-noprint=\"1\"]{display:none !important;}}\n\u003C/style>\n\u003C/helmet>\n\u003Cdiv data-rm=\"{{ rm }}\" style=\"position:fixed;inset:0;background:#070a18;color:#e6ecff;font-family:'Figtree',system-ui,sans-serif;font-size:{{ fs }};line-height:1.45;overflow:hidden;\">\n\n\u003Csc-if value=\"{{ loading }}\" hint-placeholder-val=\"{{ true }}\">\n  \u003Cdiv style=\"position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'VT323',monospace;font-size:28px;color:#38e8ff;letter-spacing:.08em;\">BOOTING CIVICLOCK…\u003Cspan style=\"animation:rpBlink 1s steps(1) infinite;\">_\u003C/span>\u003C/div>\n\u003C/sc-if>\n\n\u003Csc-if value=\"{{ isTitle }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:absolute;inset:0;overflow:auto;background:linear-gradient(#05070f 0%,#0b1026 45%,#211a47 78%,#352870 100%);\">\n    \u003Cdiv style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.22) 0 1px,transparent 1px 3px);z-index:3;\">\u003C/div>\n    \u003Csc-for list=\"{{ stars }}\" as=\"s\" hint-placeholder-count=\"0\">\u003Cdiv style=\"position:absolute;left:{{ s.l }};top:{{ s.t }};width:3px;height:3px;background:{{ s.c }};\">\u003C/div>\u003C/sc-for>\n    \u003Cdiv style=\"position:absolute;left:0;right:0;bottom:0;height:42%;display:flex;align-items:flex-end;justify-content:center;gap:0;pointer-events:none;\">\n      \u003Csc-for list=\"{{ sky }}\" as=\"b\" hint-placeholder-count=\"0\">\u003Cdiv style=\"width:{{ b.w }};aspect-ratio:{{ b.ar }};background-image:url({{ b.img }});background-size:{{ b.bs }};background-position:{{ b.bp }};background-repeat:no-repeat;image-rendering:pixelated;flex:none;margin-left:-0.6%;\">\u003C/div>\u003C/sc-for>\n    \u003C/div>\n    \u003Cdiv style=\"position:relative;z-index:2;min-height:100%;display:flex;flex-direction:column;justify-content:center;padding:6vh 7vw 34vh;gap:22px;max-width:1100px;\">\n      \u003Cdiv style=\"font-family:'VT323',monospace;font-size:22px;letter-spacing:.14em;color:#ffb347;\">MR. WALLACE’S U.S. HISTORY · NEW LIBERTY, 1997\u003C/div>\n      \u003Cdiv style=\"display:flex;flex-direction:column;gap:8px;\">\n        \u003Ch1 style=\"margin:0;font-family:'Silkscreen',monospace;font-weight:700;font-size:clamp(38px,7vw,92px);line-height:.95;color:#e6ecff;animation:rpGlitch 4s steps(2) infinite;\">THE RIGHTS\u003Cbr>PROTOCOL\u003C/h1>\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:clamp(14px,1.8vw,22px);color:#ff3355;letter-spacing:.06em;animation:rpFlicker 5s infinite;\">CONSTITUTION.EXE HAS BEEN CORRUPTED\u003C/div>\n      \u003C/div>\n      \u003Cp style=\"margin:0;max-width:560px;font-size:18px;color:#c6d2f5;text-wrap:pretty;\">Investigate the cases. Recover the amendments. Escape the constitutional lockdown.\u003C/p>\n      \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:12px;\">\n        \u003Cbutton sc-camel-on-click=\"{{ onNew }}\" style=\"min-height:52px;padding:0 26px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:17px;cursor:pointer;box-shadow:4px 4px 0 #04060d;\" style-hover=\"background:#8ff3ff;\">NEW INVESTIGATION\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onContinue }}\" disabled=\"{{ noSave }}\" style=\"min-height:52px;padding:0 26px;border:2px solid #ff3fb4;background:#0d1330;color:#ffd3ee;font-family:'Silkscreen',monospace;font-size:17px;cursor:pointer;box-shadow:4px 4px 0 #04060d;opacity:{{ contOpacity }};\" style-hover=\"background:#2a1240;\">CONTINUE\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onHow }}\" style=\"min-height:52px;padding:0 22px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">HOW TO PLAY\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onSettings }}\" style=\"min-height:52px;padding:0 22px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">SETTINGS\u003C/button>\n      \u003C/div>\n      \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:18px;font-size:14px;color:#9fb0e0;\">\n        \u003Cbutton sc-camel-on-click=\"{{ onSources }}\" style=\"background:none;border:none;padding:0;color:#38e8ff;cursor:pointer;text-decoration:underline;\">Sources &amp; Historical Notes\u003C/button>\n        \u003Ca href=\"Teacher Guide.dc.html\" target=\"_blank\">Teacher Guide\u003C/a>\n        \u003Ca href=\"{{ selfHref }}\" target=\"_blank\">Open in a new tab\u003C/a>\n        \u003Cspan>{{ storageMsg }}\u003C/span>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003Csc-if value=\"{{ isBoot }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:absolute;inset:0;background:#04060d;display:flex;align-items:center;justify-content:center;padding:24px;overflow:auto;\">\n    \u003Cdiv style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(56,232,255,.04) 0 1px,transparent 1px 3px);\">\u003C/div>\n    \u003Cdiv style=\"position:relative;width:100%;max-width:820px;border:3px solid #1b2652;border-radius:18px;background:radial-gradient(ellipse at center,#0b1a2a 0%,#04060d 80%);padding:36px 32px 120px;box-shadow:inset 0 0 80px rgba(56,232,255,.12);animation:rpFlicker 6s infinite;\">\n      \u003Cdiv style=\"font-family:'VT323',monospace;font-size:26px;color:#4dff9a;display:flex;flex-direction:column;gap:6px;\">\n        \u003Cdiv style=\"color:#38e8ff;\">CIVICLOCK v4.0 — CITY OF NEW LIBERTY\u003C/div>\n        \u003Csc-for list=\"{{ bootLines }}\" as=\"l\" hint-placeholder-count=\"0\">\u003Cdiv style=\"color:{{ l.c }};animation:rpRise .3s ease-out;\">&gt; {{ l.t }}\u003C/div>\u003C/sc-for>\n        \u003Cspan style=\"animation:rpBlink 1s steps(1) infinite;\">_\u003C/span>\n      \u003C/div>\n      \u003Csc-if value=\"{{ showAccept }}\" hint-placeholder-val=\"{{ false }}\">\n        \u003Cdiv style=\"margin-top:28px;display:flex;justify-content:center;\">\n          \u003Cbutton sc-camel-on-click=\"{{ onAccept }}\" style=\"min-height:60px;padding:0 34px;border:3px solid #4dff9a;background:#4dff9a;color:#04060d;font-family:'Silkscreen',monospace;font-size:20px;cursor:pointer;box-shadow:0 0 30px rgba(77,255,154,.45);\" style-hover=\"background:#a8ffcf;\">[ ACCEPT THE MISSION ]\u003C/button>\n        \u003C/div>\n      \u003C/sc-if>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003Csc-if value=\"{{ isGame }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:absolute;inset:0;display:flex;flex-direction:column;\">\n    \u003Cheader style=\"flex:none;display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;padding:8px 14px;background:#060916;border-bottom:2px solid #1b2652;\">\n      \u003Cdiv style=\"display:flex;align-items:center;gap:10px;min-width:0;\">\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:15px;color:#04060d;background:#38e8ff;padding:4px 8px;\">R.R.U.\u003C/div>\n        \u003Cdiv style=\"font-family:'VT323',monospace;font-size:20px;color:#9fb0e0;white-space:nowrap;\">{{ chapter }}\u003C/div>\n      \u003C/div>\n      \u003Cdiv style=\"flex:1 1 280px;min-width:0;display:flex;align-items:center;gap:8px;padding:6px 12px;border:1px solid #6b4a1f;background:#1a1206;border-radius:4px;\">\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;flex:none;\">OBJECTIVE\u003C/span>\n        \u003Cspan style=\"font-size:14px;color:#ffe2b8;min-width:0;\">{{ objective }}\u003C/span>\n      \u003C/div>\n      \u003Cdiv style=\"display:flex;align-items:center;gap:10px;\" title=\"Recovered amendments\">\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:12px;color:#4dff9a;\">FILES {{ filesN }}/10\u003C/span>\n        \u003Cdiv style=\"display:flex;gap:2px;\">\u003Csc-for list=\"{{ segs }}\" as=\"g\" hint-placeholder-count=\"10\">\u003Cdiv style=\"width:8px;height:16px;background:{{ g.bg }};\">\u003C/div>\u003C/sc-for>\u003C/div>\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:12px;color:#38e8ff;\">CLUES {{ cluesN }}\u003C/span>\n      \u003C/div>\n      \u003Cnav style=\"display:flex;flex-wrap:wrap;gap:6px;\">\n        \u003Cbutton sc-camel-on-click=\"{{ onInv }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">EVIDENCE\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onDb }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">DATABASE\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onGloss }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">GLOSSARY\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onHelp }}\" style=\"min-height:36px;padding:0 12px;border:2px solid #ffb347;background:#2a1a06;color:#ffd08a;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"background:#4a2e0a;\">HELP / CLUE\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onSet }}\" aria-label=\"Settings\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">SETTINGS\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onMenu }}\" style=\"min-height:36px;padding:0 10px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">MENU\u003C/button>\n      \u003C/nav>\n    \u003C/header>\n\n    \u003Cmain style=\"flex:1;min-height:0;overflow:auto;display:flex;flex-wrap:wrap;align-content:flex-start;gap:14px;padding:14px 14px 190px;\">\n      \u003Csection style=\"flex:1 1 620px;min-width:0;display:flex;flex-direction:column;gap:10px;align-items:center;\">\n        \u003Cdiv style=\"width:min(100%,calc((100vh - 230px) * 1.7778));min-width:min(100%,520px);display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;\">\n          \u003Cspan style=\"font-family:'VT323',monospace;font-size:20px;color:#ff3fb4;\">{{ locCode }}\u003C/span>\n          \u003Ch2 style=\"margin:0;font-family:'Silkscreen',monospace;font-size:20px;line-height:1.2;font-weight:700;color:#e6ecff;\">{{ locTitle }}\u003C/h2>\n          \u003Cspan style=\"font-size:14px;color:#9fb0e0;flex:1;min-width:120px;\">{{ locPlace }}\u003C/span>\n          \u003Csc-if value=\"{{ hasNext }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onNextStep }}\" style=\"margin-left:auto;min-height:40px;padding:0 14px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;box-shadow:3px 3px 0 #04060d;\" style-hover=\"background:#8ff3ff;\">▶ NEXT STEP\u003C/button>\u003C/sc-if>\n        \u003C/div>\n        \u003Cdiv style=\"position:relative;width:min(100%,calc((100vh - 230px) * 1.7778));min-width:min(100%,520px);aspect-ratio:16/9;background:#04060d;border:3px solid #1b2652;box-shadow:0 0 0 3px #04060d,0 10px 40px rgba(0,0,0,.6);overflow:hidden;\">\n          \u003Csc-if value=\"{{ isRoom }}\" hint-placeholder-val=\"{{ false }}\">\n            \u003Cdiv role=\"img\" aria-label=\"{{ sceneAlt }}\" style=\"position:absolute;inset:0;background-image:url({{ sceneImg }});background-size:100% 100%;image-rendering:pixelated;\">\u003C/div>\n            \u003Csc-if value=\"{{ hasSceneFx }}\" hint-placeholder-val=\"{{ false }}\">\n              \u003Cdiv aria-hidden=\"true\" style=\"position:absolute;inset:0;pointer-events:none;background-image:url({{ sceneFx }});background-size:100% 100%;image-rendering:pixelated;mix-blend-mode:screen;animation:rpFxPulse 3.2s ease-in-out infinite;\">\u003C/div>\n              \u003Cdiv aria-hidden=\"true\" style=\"position:absolute;inset:0;pointer-events:none;background-image:url({{ sceneFx }});background-size:100% 100%;image-rendering:pixelated;mix-blend-mode:screen;animation:rpFxDrift 5.5s steps(11) infinite, rpFxFlicker 2.3s steps(1) infinite;\">\u003C/div>\n            \u003C/sc-if>\n            \u003Cdiv style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(0,0,0,.12) 0 1px,transparent 1px 3px);\">\u003C/div>\n            \u003Csc-for list=\"{{ hotspots }}\" as=\"h\" hint-placeholder-count=\"0\">\n              \u003Cbutton sc-camel-on-click=\"{{ h.onClick }}\" aria-label=\"{{ h.label }}\" title=\"{{ h.label }}\" style=\"position:absolute;left:{{ h.l }};top:{{ h.t }};width:{{ h.w }};height:{{ h.h }};background:transparent;border:2px solid {{ h.bd }};border-radius:3px;cursor:pointer;padding:0;transition:background .15s,border-color .15s,box-shadow .15s;\" style-hover=\"background:rgba(56,232,255,.14);border-color:#38e8ff;box-shadow:0 0 16px rgba(56,232,255,.55);\">\n                \u003Csc-if value=\"{{ h.isNext }}\" hint-placeholder-val=\"{{ false }}\">\u003Cspan style=\"position:absolute;inset:-4px;border:3px solid #38e8ff;box-shadow:0 0 18px #38e8ff,inset 0 0 12px rgba(56,232,255,.4);pointer-events:none;animation:rpFlicker 2s infinite;\">\u003C/span>\u003Cspan style=\"position:absolute;left:50%;top:-26px;transform:translateX(-50%);font-family:'Silkscreen',monospace;font-size:11px;padding:2px 6px;background:#38e8ff;color:#04060d;white-space:nowrap;pointer-events:none;\">▼ NEXT\u003C/span>\u003C/sc-if>\n                \u003Csc-if value=\"{{ h.marker }}\" hint-placeholder-val=\"{{ false }}\">\u003Cspan style=\"position:absolute;left:50%;top:-10px;width:7px;height:7px;background:#ffb347;transform:translate(-50%,0) rotate(45deg);opacity:.55;\">\u003C/span>\u003C/sc-if>\n                \u003Csc-if value=\"{{ h.isNew }}\" hint-placeholder-val=\"{{ false }}\">\u003Cspan style=\"position:absolute;right:2px;bottom:2px;font-family:'Silkscreen',monospace;font-size:9px;color:#04060d;background:#4dff9a;padding:0 3px;\">✓\u003C/span>\u003C/sc-if>\n              \u003C/button>\n            \u003C/sc-for>\n          \u003C/sc-if>\n          \u003Csc-if value=\"{{ isMap }}\" hint-placeholder-val=\"{{ false }}\">\n            \u003Cdiv style=\"position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);aspect-ratio:1650/953;overflow:hidden;\">\n              \u003Cimg src=\"{{ RES.map_city }}\" alt=\"Pixel-art night map of New Liberty with eleven locations\" style=\"position:absolute;inset:0;width:100%;height:100%;display:block;image-rendering:pixelated;\">\n              \u003Cdiv style=\"position:absolute;left:0;right:0;top:10.4%;height:5.4%;background-image:url({{ RES.water }});background-size:9.7% 900%;background-repeat:repeat-x;mix-blend-mode:screen;opacity:.42;animation:rpWater 2.2s steps(8) infinite;pointer-events:none;\">\u003C/div>\n              \u003Cdiv style=\"position:absolute;left:77.8%;top:3.4%;width:9%;aspect-ratio:1;border-radius:999px;background:radial-gradient(circle,rgba(190,215,255,.55),rgba(120,150,255,0) 65%);mix-blend-mode:screen;animation:rpMoon 5s ease-in-out infinite;pointer-events:none;\">\u003C/div>\n              \u003Csc-for list=\"{{ clouds }}\" as=\"c\" hint-placeholder-count=\"0\">\u003Cdiv style=\"position:absolute;left:0;top:{{ c.t }};width:{{ c.w }};aspect-ratio:160/60;background-image:url({{ RES.cloud }});background-size:100% 100%;opacity:.7;animation:rpCloud {{ c.dur }} linear infinite;animation-delay:{{ c.delay }};pointer-events:none;image-rendering:pixelated;\">\u003C/div>\u003C/sc-for>\n              \u003Csc-for list=\"{{ lamps }}\" as=\"g\" hint-placeholder-count=\"0\">\u003Cdiv style=\"position:absolute;left:{{ g.l }};top:{{ g.t }};width:4.4%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:999px;background:radial-gradient(circle,rgba(255,200,110,.6),rgba(255,170,60,.18) 40%,rgba(255,170,60,0) 70%);mix-blend-mode:screen;animation:rpFlick {{ g.dur }} ease-in-out infinite;animation-delay:{{ g.delay }};pointer-events:none;\">\u003C/div>\u003C/sc-for>\n              \u003Csc-for list=\"{{ flies }}\" as=\"f\" hint-placeholder-count=\"0\">\u003Cdiv style=\"position:absolute;left:{{ f.l }};top:{{ f.t }};width:4px;height:4px;border-radius:999px;background:#ffe58a;box-shadow:0 0 6px 2px rgba(255,220,120,.8);animation:rpTwinkle {{ f.dur }} ease-in-out infinite;animation-delay:{{ f.delay }};pointer-events:none;\">\u003C/div>\u003C/sc-for>\n              \u003Csc-for list=\"{{ carsH }}\" as=\"c\" hint-placeholder-count=\"0\">\u003Cdiv style=\"position:absolute;left:{{ c.l0 }};top:{{ c.t }};width:4.2%;aspect-ratio:160/100;background-image:url({{ RES.cars_h }});background-size:200% 1200%;background-position-x:0%;background-position-y:{{ c.row }};background-repeat:no-repeat;image-rendering:pixelated;animation:{{ c.anim }} {{ c.dur }} linear infinite,rpF2 .5s steps(2) infinite;animation-delay:{{ c.delay }},0s;pointer-events:none;\">\u003C/div>\u003C/sc-for>\n              \u003Csc-for list=\"{{ carsV }}\" as=\"c\" hint-placeholder-count=\"0\">\u003Cdiv style=\"position:absolute;left:{{ c.l }};top:{{ c.t0 }};width:2.3%;aspect-ratio:80/164;background-image:url({{ RES.cars_v }});background-size:300% 1200%;background-position-x:0%;background-position-y:{{ c.row }};background-repeat:no-repeat;image-rendering:pixelated;animation:{{ c.anim }} {{ c.dur }} linear infinite,rpF3 .6s steps(3) infinite;animation-delay:{{ c.delay }},0s;pointer-events:none;\">\u003C/div>\u003C/sc-for>\n              \u003Cdiv style=\"position:absolute;left:-34%;top:84.6%;width:31%;aspect-ratio:740/76;background-image:url({{ RES.train }});background-size:100% 100%;image-rendering:pixelated;animation:rpTrain 26s linear infinite;animation-delay:-6s;pointer-events:none;filter:drop-shadow(0 0 6px rgba(255,200,120,.45));\">\u003C/div>\n              \u003Csc-for list=\"{{ mapLocs }}\" as=\"b\" hint-placeholder-count=\"0\">\n                \u003Cbutton sc-camel-on-click=\"{{ b.onClick }}\" aria-label=\"{{ b.aria }}\" title=\"{{ b.place }}\" style=\"position:absolute;left:{{ b.l }};top:{{ b.t }};width:{{ b.w }};height:{{ b.h }};background:{{ b.shade }};border:2px solid {{ b.ring }};border-radius:14px;padding:0;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;transition:background .2s,border-color .2s,box-shadow .2s;\" style-hover=\"background:rgba(56,232,255,.14);border-color:#38e8ff;box-shadow:0 0 22px rgba(56,232,255,.55);\">\n                  \u003Cspan style=\"position:absolute;left:50%;top:{{ b.pinTop }};width:34%;aspect-ratio:1;transform:translate(-50%,0);border-radius:10px;animation:{{ b.pinAnim }};pointer-events:none;\">\u003C/span>\n                  \u003Csc-if value=\"{{ b.badgeOn }}\" hint-placeholder-val=\"{{ false }}\">\u003Cspan style=\"position:absolute;right:-2%;top:-6%;min-width:24px;height:24px;padding:0 6px;border-radius:999px;display:flex;align-items:center;justify-content:center;background:{{ b.badgeBg }};color:{{ b.badgeFg }};font-family:'Silkscreen',monospace;font-size:11px;border:2px solid #04060d;\">{{ b.badge }}\u003C/span>\u003C/sc-if>\n                  \u003Cspan style=\"margin-bottom:4%;font-family:'Silkscreen',monospace;font-size:clamp(8px,0.8vw,11px);line-height:1.1;padding:3px 7px;border-radius:999px;background:{{ b.tagBg }};color:{{ b.tagFg }};border:2px solid {{ b.tagBd }};white-space:nowrap;box-shadow:0 2px 0 #04060d;\">{{ b.label }}\u003C/span>\n                \u003C/button>\n              \u003C/sc-for>\n              \u003Cdiv aria-hidden=\"true\" style=\"position:absolute;left:{{ botL }};top:{{ botT }};width:4.2%;aspect-ratio:112/200;background-image:url({{ RES.robot_walk }});background-size:2700% 100%;background-position:{{ botPos }} 0%;background-repeat:no-repeat;image-rendering:pixelated;pointer-events:none;filter:drop-shadow(0 3px 2px rgba(0,0,0,.7)) drop-shadow(0 0 6px rgba(255,138,61,.5));animation:{{ botAnim }};\">\u003C/div>\n              \u003Cdiv style=\"position:absolute;left:1.5%;bottom:1.5%;font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;letter-spacing:.1em;background:rgba(4,6,13,.7);padding:3px 8px;border-radius:999px;\">NEW LIBERTY · CITY GRID\u003C/div>\n            \u003C/div>\n          \u003C/sc-if>\n        \u003C/div>\n      \u003C/section>\n\n      \u003Caside style=\"flex:1 1 280px;max-width:420px;min-width:0;display:flex;flex-direction:column;gap:12px;\">\n        \u003Cdiv style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:6px;\">\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;\">CURRENT OBJECTIVE\u003C/div>\n          \u003Cdiv style=\"font-size:15px;color:#e6ecff;text-wrap:pretty;\">{{ objective }}\u003C/div>\n          \u003Csc-if value=\"{{ locAmOn }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-size:13px;color:#9fb0e0;\">{{ locAm }}\u003C/div>\u003C/sc-if>\n        \u003C/div>\n        \u003Csc-if value=\"{{ hasNext }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cbutton sc-camel-on-click=\"{{ onNextStep }}\" style=\"text-align:left;display:flex;align-items:center;gap:12px;min-height:60px;padding:10px 14px;background:#38e8ff;border:3px solid #38e8ff;color:#04060d;cursor:pointer;box-shadow:4px 4px 0 #04060d;\" style-hover=\"background:#8ff3ff;\">\n            \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:22px;flex:none;\">▶\u003C/span>\n            \u003Cspan style=\"display:flex;flex-direction:column;gap:2px;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;\">DO THIS NEXT\u003C/span>\u003Cspan style=\"font-size:16px;font-weight:800;line-height:1.25;\">{{ nextLabel }}\u003C/span>\u003C/span>\n          \u003C/button>\n        \u003C/sc-if>\n        \u003Csc-if value=\"{{ isRoom }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Csc-if value=\"{{ hasTerminals }}\" hint-placeholder-val=\"{{ false }}\">\n            \u003Cdiv style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:8px;\">\n              \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">CASE TERMINALS\u003C/div>\n              \u003Csc-for list=\"{{ terminals }}\" as=\"p\" hint-placeholder-count=\"0\">\n                \u003Cbutton sc-camel-on-click=\"{{ p.onClick }}\" disabled=\"{{ p.disabled }}\" style=\"text-align:left;display:flex;gap:10px;align-items:center;min-height:44px;padding:6px 10px;background:{{ p.bg }};border:2px solid {{ p.bd }};color:{{ p.fg }};cursor:{{ p.cursor }};\" style-hover=\"filter:brightness(1.2);\">\n                  \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;flex:none;width:58px;\">{{ p.tag }}\u003C/span>\n                  \u003Cspan style=\"font-size:14px;font-weight:600;\">{{ p.title }}\u003Cspan style=\"display:block;font-weight:400;font-size:12px;color:#9fb0e0;\">{{ p.sub }}\u003C/span>\u003C/span>\n                \u003C/button>\n              \u003C/sc-for>\n            \u003C/div>\n          \u003C/sc-if>\n          \u003Cdiv style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:6px;\">\n            \u003Cdiv style=\"display:flex;justify-content:space-between;align-items:center;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">MORE TO EXPLORE (OPTIONAL)\u003C/span>\u003Cspan style=\"font-size:12px;color:#9fb0e0;\">{{ foundN }}\u003C/span>\u003C/div>\n            \u003Csc-for list=\"{{ inspect }}\" as=\"h\" hint-placeholder-count=\"0\">\n              \u003Cbutton sc-camel-on-click=\"{{ h.onClick }}\" style=\"text-align:left;display:flex;gap:8px;align-items:center;min-height:38px;padding:4px 8px;background:transparent;border:1px solid #1f2a5a;color:#e6ecff;cursor:pointer;font-size:14px;\" style-hover=\"background:#16204a;border-color:#38e8ff;\">\n                \u003Cspan style=\"width:18px;flex:none;font-family:'Silkscreen',monospace;font-size:11px;color:{{ h.mc }};\">{{ h.mark }}\u003C/span>\u003Cspan>{{ h.label }}\u003C/span>\n              \u003C/button>\n            \u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n        \u003Csc-if value=\"{{ isMap }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"padding:12px 14px;background:#0d1330;border:2px solid #1b2652;display:flex;flex-direction:column;gap:6px;\">\n            \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">LOCATIONS\u003C/div>\n            \u003Csc-for list=\"{{ mapLocs }}\" as=\"b\" hint-placeholder-count=\"0\">\n              \u003Cbutton sc-camel-on-click=\"{{ b.onClick }}\" style=\"text-align:left;display:flex;gap:8px;align-items:center;min-height:38px;padding:4px 8px;background:transparent;border:1px solid #1f2a5a;color:{{ b.listFg }};cursor:pointer;font-size:14px;\" style-hover=\"background:#16204a;border-color:#38e8ff;\">\n                \u003Cspan style=\"width:74px;flex:none;font-family:'Silkscreen',monospace;font-size:10px;color:{{ b.tagFg }};\">{{ b.listStatus }}\u003C/span>\u003Cspan>{{ b.place }}\u003C/span>\n              \u003C/button>\n            \u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n        \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n          \u003Csc-if value=\"{{ showBackMap }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onBackMap }}\" style=\"flex:1;min-height:44px;padding:0 14px;border:2px solid #38e8ff;background:#0d1330;color:#38e8ff;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"background:#13305a;\">◂ CITY MAP\u003C/button>\u003C/sc-if>\n          \u003Csc-if value=\"{{ showBackHq }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onBackHq }}\" style=\"flex:1;min-height:44px;padding:0 14px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">◂ R.R.U. HQ\u003C/button>\u003C/sc-if>\n        \u003C/div>\n      \u003C/aside>\n    \u003C/main>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003Csc-if value=\"{{ isVictory }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:absolute;inset:0;overflow:auto;background:{{ vicBg }};transition:background 2.5s ease;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;padding:40px 20px 200px;\">\n    \u003Cdiv style=\"font-family:'VT323',monospace;font-size:26px;color:{{ vicSubColor }};letter-spacing:.1em;text-align:center;\">{{ vicSub }}\u003C/div>\n    \u003Cdiv style=\"display:grid;grid-template-columns:repeat(5,minmax(0,120px));gap:12px;max-width:680px;width:100%;\">\n      \u003Csc-for list=\"{{ vicTiles }}\" as=\"t\" hint-placeholder-count=\"10\">\n        \u003Cdiv style=\"aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;border:3px solid {{ t.bd }};background:{{ t.bg }};box-shadow:{{ t.sh }};transition:all .6s ease;\">\n          \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:28px;color:{{ t.fg }};\">{{ t.roman }}\u003C/span>\n          \u003Cspan style=\"font-size:11px;color:{{ t.fg }};text-align:center;padding:0 4px;\">{{ t.title }}\u003C/span>\n        \u003C/div>\n      \u003C/sc-for>\n    \u003C/div>\n    \u003Csc-if value=\"{{ vicText }}\" hint-placeholder-val=\"{{ false }}\">\n      \u003Cdiv style=\"font-family:'VT323',monospace;font-size:28px;line-height:1.25;color:#4dff9a;text-align:center;animation:rpRise .6s ease-out;\">\n        \u003Cdiv>SYSTEM RESTORED\u003C/div>\u003Cdiv>BILL OF RIGHTS: 10/10\u003C/div>\u003Cdiv>NEW LIBERTY PROTOCOL: SECURE\u003C/div>\u003Cdiv style=\"color:#f5c542;\">INVESTIGATOR STATUS: CERTIFIED\u003C/div>\n      \u003C/div>\n    \u003C/sc-if>\n    \u003Csc-if value=\"{{ vicDone }}\" hint-placeholder-val=\"{{ false }}\">\n      \u003Cdiv style=\"display:flex;flex-direction:column;align-items:center;gap:18px;animation:rpRise .6s ease-out;\">\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:clamp(20px,3vw,34px);color:#f5c542;text-align:center;\">MISSION COMPLETE — THE CONSTITUTION IS BACK ONLINE.\u003C/div>\n        \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:12px;justify-content:center;\">\n          \u003Cbutton sc-camel-on-click=\"{{ onReport }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #f5c542;background:#f5c542;color:#04060d;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"background:#ffe08a;\">INVESTIGATOR REPORT\u003C/button>\n          \u003Cbutton sc-camel-on-click=\"{{ onDb }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #38e8ff;background:#0d1330;color:#38e8ff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"background:#13305a;\">REVIEW FILES\u003C/button>\n          \u003Cbutton sc-camel-on-click=\"{{ onPlayAgain }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">PLAY AGAIN\u003C/button>\n          \u003Cbutton sc-camel-on-click=\"{{ onBackHq }}\" style=\"min-height:52px;padding:0 24px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">EXPLORE CITY\u003C/button>\n        \u003C/div>\n      \u003C/div>\n    \u003C/sc-if>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003Csc-if value=\"{{ dlgOn }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv role=\"dialog\" aria-live=\"polite\" style=\"position:fixed;left:50%;bottom:14px;transform:translateX(-50%);width:min(900px,calc(100% - 20px));z-index:80;display:flex;gap:14px;align-items:stretch;padding:14px;background:#070b1c;border:3px solid {{ dlgColor }};box-shadow:0 0 0 3px #04060d,0 12px 40px rgba(0,0,0,.7);\">\n    \u003Csc-if value=\"{{ dlgHasImg }}\" hint-placeholder-val=\"{{ false }}\">\n      \u003Cdiv style=\"flex:none;width:96px;height:96px;border:2px solid {{ dlgColor }};background:#04060d;\">\u003Cdiv style=\"width:100%;height:100%;background-image:url({{ dlgImg }});background-size:100% 100%;image-rendering:pixelated;\">\u003C/div>\u003C/div>\n    \u003C/sc-if>\n    \u003Csc-if value=\"{{ dlgAnim }}\" hint-placeholder-val=\"{{ false }}\">\n      \u003Cdiv data-portrait=\"wallace\" aria-hidden=\"true\" style=\"flex:none;width:96px;height:131px;align-self:center;border:2px solid {{ dlgColor }};background-color:#04060d;background-image:url({{ RES.wallace }});background-size:1400% 100%;background-position:{{ dlgFramePos }};background-repeat:no-repeat;image-rendering:pixelated;\">\u003C/div>\n    \u003C/sc-if>\n    \u003Cdiv style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;\">\n      \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:13px;color:{{ dlgColor }};\">{{ dlgName }}\u003C/div>\n      \u003Cdiv style=\"font-size:19px;line-height:1.6;color:#eef2ff;min-height:56px;text-wrap:pretty;letter-spacing:.005em;\">\u003Csc-for list=\"{{ dlgSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/div>\n      \u003Cdiv style=\"display:flex;justify-content:flex-end;gap:8px;margin-top:auto;\">\n        \u003Cbutton sc-camel-on-click=\"{{ onSkipDlg }}\" style=\"min-height:40px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;font-size:13px;cursor:pointer;\" style-hover=\"color:#e6ecff;border-color:#9fb0e0;\">Skip scene\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onNext }}\" autofocus=\"{{ true }}\" style=\"min-height:40px;padding:0 18px;border:2px solid {{ dlgColor }};background:{{ dlgColor }};color:#04060d;font-family:'Silkscreen',monospace;font-size:13px;cursor:pointer;\" style-hover=\"filter:brightness(1.2);\">{{ dlgNextLabel }}\u003C/button>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003Csc-if value=\"{{ toastOn }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv role=\"status\" style=\"position:fixed;bottom:150px;right:16px;z-index:95;padding:10px 14px;background:#062a1a;border:2px solid #4dff9a;color:#bfffdc;font-family:'Silkscreen',monospace;font-size:12px;box-shadow:0 6px 20px rgba(0,0,0,.5);animation:rpRise .25s ease-out;\">{{ toastText }}\u003C/div>\n\u003C/sc-if>\n\n\u003C!-- PUZZLE TERMINAL -->\n\u003Csc-if value=\"{{ ovPz }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv data-pzscroll=\"1\" style=\"position:fixed;inset:0;z-index:60;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"{{ pzTitle }}\" style=\"width:100%;max-width:960px;margin:auto 0;background:#0a0f24;border:2px solid #38e8ff;box-shadow:0 0 0 4px #04060d,0 0 50px rgba(56,232,255,.22);display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;padding:10px 16px;background:#0e1a3a;border-bottom:2px solid #1b2652;\">\n        \u003Cspan style=\"font-family:'VT323',monospace;font-size:18px;color:#38e8ff;\">CASE TERMINAL · {{ pzCode }}\u003C/span>\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:15px;color:#e6ecff;flex:1;min-width:200px;\">{{ pzTitle }}\u003C/span>\n        \u003Cdiv style=\"display:flex;gap:4px;align-items:center;\">\u003Csc-for list=\"{{ pzDots }}\" as=\"d\" hint-placeholder-count=\"0\">\u003Cspan style=\"width:22px;height:8px;background:{{ d.bg }};\">\u003C/span>\u003C/sc-for>\u003Cspan style=\"font-size:12px;color:#9fb0e0;margin-left:6px;white-space:nowrap;\">{{ pzStepLabel }}\u003C/span>\u003C/div>\n        \u003Cbutton sc-camel-on-click=\"{{ closeOv }}\" aria-label=\"Close terminal\" style=\"min-height:36px;padding:0 10px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;font-size:13px;\" style-hover=\"color:#fff;border-color:#9fb0e0;\">Close ✕\u003C/button>\n      \u003C/div>\n      \u003Cdiv style=\"padding:18px 18px 8px;display:flex;flex-direction:column;gap:14px;\">\n        \u003Csc-if value=\"{{ pzRecall }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"align-self:flex-start;font-family:'Silkscreen',monospace;font-size:11px;padding:4px 8px;background:#3a0a2a;border:1px solid #ff3fb4;color:#ffc1e6;\">MEMORY CHECK · DATABASE LOCKED UNTIL YOU ANSWER\u003C/div>\u003C/sc-if>\n        \u003Csc-if value=\"{{ pzIsInfo }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:16px;color:#ffb347;\">{{ pzInfoTitle }}\u003C/div>\n          \u003Csc-if value=\"{{ pzHasExcerpt }}\" hint-placeholder-val=\"{{ false }}\">\u003Cblockquote style=\"margin:0;padding:14px 16px;background:#1c1508;border:2px solid #b8732a;color:#ffe2b8;font-family:Georgia,'Times New Roman',serif;font-size:17px;line-height:1.5;\">“{{ pzExcerpt }}”\u003Cdiv style=\"margin-top:6px;font-family:'Figtree',sans-serif;font-size:12px;color:#d9b27a;\">— Bill of Rights, National Archives transcription\u003C/div>\u003C/blockquote>\u003C/sc-if>\n          \u003Csc-for list=\"{{ pzInfoBody }}\" as=\"b\" hint-placeholder-count=\"0\">\u003Cp style=\"margin:0;font-size:17px;line-height:1.65;color:#dbe3ff;text-wrap:pretty;\">\u003Csc-for list=\"{{ b.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/p>\u003C/sc-for>\n        \u003C/sc-if>\n        \u003Csc-if value=\"{{ pzHasPrompt }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Csc-if value=\"{{ pzHasScenario }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"padding:12px 16px;background:#111c44;border:2px solid #2f4290;border-radius:8px;display:flex;flex-direction:column;gap:6px;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;\">THE SITUATION\u003C/span>\u003Cdiv style=\"width:100%;font-size:18px;line-height:1.6;color:#e6ecff;text-wrap:pretty;\">\u003Csc-for list=\"{{ pzScenSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/div>\u003C/div>\u003C/sc-if>\n          \u003Cdiv style=\"display:flex;gap:12px;align-items:flex-start;\">\u003Cspan style=\"flex:none;font-family:'Silkscreen',monospace;font-size:11px;padding:4px 7px;background:#38e8ff;color:#04060d;margin-top:3px;white-space:nowrap;\">YOUR TASK\u003C/span>\u003Cdiv style=\"flex:1;min-width:0;font-size:19px;line-height:1.5;font-weight:700;color:#ffffff;text-wrap:pretty;\">\u003Csc-for list=\"{{ pzTaskSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/div>\u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzIsChoice }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv role=\"radiogroup\" style=\"display:flex;flex-direction:column;gap:8px;\">\n            \u003Csc-for list=\"{{ pzOptions }}\" as=\"o\" hint-placeholder-count=\"0\">\n              \u003Cbutton role=\"radio\" aria-checked=\"{{ o.sel }}\" sc-camel-on-click=\"{{ o.onClick }}\" style=\"text-align:left;display:flex;gap:12px;align-items:flex-start;min-height:48px;padding:10px 14px;background:{{ o.bg }};border:2px solid {{ o.bd }};color:#e6ecff;cursor:pointer;font-size:16px;\" style-hover=\"border-color:#38e8ff;\">\n                \u003Cspan style=\"flex:none;font-family:'Silkscreen',monospace;font-size:13px;color:#04060d;background:{{ o.kc }};width:26px;height:26px;display:flex;align-items:center;justify-content:center;border-radius:4px;\">{{ o.key }}\u003C/span>\u003Cspan style=\"flex:1;min-width:0;line-height:1.5;font-size:17px;\">\u003Csc-for list=\"{{ o.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/span>\n              \u003C/button>\n            \u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzIsMulti }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Csc-if value=\"{{ pzMultiDoc }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-family:'VT323',monospace;font-size:20px;color:#ffb347;\">DOCUMENT: {{ pzMultiDocTitle }}\u003C/div>\u003C/sc-if>\n          \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n            \u003Csc-for list=\"{{ pzOptions }}\" as=\"o\" hint-placeholder-count=\"0\">\n              \u003Cbutton role=\"checkbox\" aria-checked=\"{{ o.sel }}\" sc-camel-on-click=\"{{ o.onClick }}\" style=\"text-align:left;flex:1 1 {{ o.basis }};min-height:46px;padding:8px 12px;background:{{ o.bg }};border:2px solid {{ o.bd }};color:#e6ecff;cursor:pointer;font-size:15px;display:flex;gap:10px;align-items:center;\" style-hover=\"border-color:#38e8ff;\">\n                \u003Cspan style=\"flex:none;width:18px;height:18px;border:2px solid {{ o.kc }};background:{{ o.box }};\">\u003C/span>\u003Cspan style=\"flex:1;min-width:0;line-height:1.45;\">\u003Csc-for list=\"{{ o.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/span>\n              \u003C/button>\n            \u003C/sc-for>\n          \u003C/div>\n          \u003Cdiv style=\"font-size:13px;color:#9fb0e0;\">Selected: {{ pzSelCount }}\u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzIsMatch }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"font-size:13px;color:#9fb0e0;\">Select a card, then select where it belongs. (You can also drag cards.)\u003C/div>\n          \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n            \u003Csc-for list=\"{{ pzItems }}\" as=\"it\" hint-placeholder-count=\"0\">\n              \u003Cbutton draggable=\"true\" sc-camel-on-drag-start=\"{{ it.onDrag }}\" sc-camel-on-click=\"{{ it.onClick }}\" aria-pressed=\"{{ it.sel }}\" style=\"text-align:left;flex:1 1 260px;min-height:48px;padding:8px 12px;background:{{ it.bg }};border:2px solid {{ it.bd }};color:#e6ecff;cursor:grab;font-size:16px;line-height:1.5;\" style-hover=\"border-color:#38e8ff;\">\u003Csc-for list=\"{{ it.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/button>\n            \u003C/sc-for>\n            \u003Csc-if value=\"{{ pzAllPlaced }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-size:14px;color:#4dff9a;\">All cards placed.\u003C/div>\u003C/sc-if>\n          \u003C/div>\n          \u003Cdiv style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax({{ pzBinMin }},1fr));gap:8px;\">\n            \u003Csc-for list=\"{{ pzBins }}\" as=\"c\" hint-placeholder-count=\"0\">\n              \u003Cdiv sc-camel-on-click=\"{{ c.onClick }}\" sc-camel-on-drag-over=\"{{ allowDrop }}\" sc-camel-on-drop=\"{{ c.onDrop }}\" role=\"button\" tabindex=\"0\" sc-camel-on-key-down=\"{{ c.onKey }}\" aria-label=\"{{ c.aria }}\" style=\"min-height:76px;padding:8px;background:{{ c.bg }};border:2px dashed {{ c.bd }};cursor:pointer;display:flex;flex-direction:column;gap:6px;\" style-hover=\"border-color:#38e8ff;background:#10204a;\">\n                \u003Cdiv style=\"display:flex;align-items:center;justify-content:space-between;gap:6px;\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:12px;color:{{ c.fg }};\">{{ c.label }} \u003Cspan style=\"color:#4dff9a;\">{{ c.count }}\u003C/span>\u003C/div>\u003Csc-if value=\"{{ c.hasWord }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ c.onWord }}\" aria-label=\"What does {{ c.label }} mean?\" style=\"flex:none;min-height:30px;padding:0 9px;border-radius:999px;border:2px solid {{ c.wordCol }};background:transparent;color:{{ c.wordCol }};font-size:12px;font-weight:800;cursor:help;\" style-hover=\"background:rgba(255,255,255,.08);\">? meaning\u003C/button>\u003C/sc-if>\u003C/div>\n                \u003Csc-for list=\"{{ c.placed }}\" as=\"pl\" hint-placeholder-count=\"0\">\u003Cdiv style=\"font-size:12px;line-height:1.3;color:#bfffdc;background:#062a1a;border:1px solid #1f9e5c;padding:4px 6px;\">✓ {{ pl }}\u003C/div>\u003C/sc-for>\n              \u003C/div>\n            \u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzIsOrder }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;\">YOUR RECONSTRUCTION (select a card to remove it)\u003C/div>\n          \u003Cdiv style=\"min-height:64px;padding:10px;background:#1c1508;border:2px solid #b8732a;display:flex;flex-wrap:wrap;gap:8px;align-items:center;\">\n            \u003Csc-for list=\"{{ pzSeq }}\" as=\"f\" hint-placeholder-count=\"0\">\u003Cbutton sc-camel-on-click=\"{{ f.onClick }}\" style=\"min-height:42px;padding:6px 10px;background:#3a2a10;border:2px solid #ffb347;color:#ffe2b8;cursor:pointer;font-size:15px;font-family:Georgia,serif;\" style-hover=\"background:#5a3a10;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:10px;color:#ffb347;margin-right:6px;\">{{ f.n }}\u003C/span>{{ f.t }}\u003C/button>\u003C/sc-for>\n            \u003Csc-if value=\"{{ pzSeqEmpty }}\" hint-placeholder-val=\"{{ true }}\">\u003Cspan style=\"color:#d9b27a;font-size:14px;\">Empty — add fragments from below.\u003C/span>\u003C/sc-if>\n          \u003C/div>\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">FRAGMENTS\u003C/div>\n          \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n            \u003Csc-for list=\"{{ pzPool }}\" as=\"f\" hint-placeholder-count=\"0\">\u003Cbutton sc-camel-on-click=\"{{ f.onClick }}\" style=\"min-height:42px;padding:6px 10px;background:#0d1330;border:2px solid #2f4290;color:#e6ecff;cursor:pointer;font-size:15px;font-family:Georgia,serif;\" style-hover=\"border-color:#38e8ff;\">{{ f.t }}\u003C/button>\u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzIsEvidence }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;\">\n            \u003Csc-for list=\"{{ pzEv }}\" as=\"e\" hint-placeholder-count=\"0\">\n              \u003Cdiv style=\"display:flex;flex-direction:column;background:{{ e.bg }};border:2px solid {{ e.bd }};\">\n                \u003Cbutton role=\"checkbox\" aria-checked=\"{{ e.sel }}\" sc-camel-on-click=\"{{ e.onClick }}\" style=\"flex:1;text-align:left;display:flex;gap:10px;align-items:center;padding:10px;background:transparent;border:none;color:#e6ecff;cursor:pointer;min-height:56px;\">\n                  \u003Cspan style=\"flex:none;font-family:'Silkscreen',monospace;font-size:9px;padding:3px 4px;background:{{ e.ic }};color:#04060d;\">{{ e.icon }}\u003C/span>\n                  \u003Cspan style=\"font-size:14px;font-weight:600;\">{{ e.name }}\u003C/span>\n                \u003C/button>\n                \u003Cbutton sc-camel-on-click=\"{{ e.onRead }}\" style=\"border:none;border-top:1px solid #1f2a5a;background:transparent;color:#38e8ff;font-size:12px;padding:6px;cursor:pointer;text-align:left;\" style-hover=\"background:#13305a;\">Re-read ›\u003C/button>\n              \u003C/div>\n            \u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzIsBuild }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"font-size:13px;color:#9fb0e0;\">Deduction board: choose one card in each column.\u003C/div>\n          \u003Cdiv style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px;\">\n            \u003Csc-for list=\"{{ pzCols }}\" as=\"col\" hint-placeholder-count=\"0\">\n              \u003Cdiv style=\"display:flex;flex-direction:column;gap:6px;padding:10px;background:#0d1330;border:2px solid #1b2652;\">\n                \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ff3fb4;\">{{ col.label }}\u003C/div>\n                \u003Csc-for list=\"{{ col.options }}\" as=\"o\" hint-placeholder-count=\"0\">\n                  \u003Cbutton role=\"radio\" aria-checked=\"{{ o.sel }}\" sc-camel-on-click=\"{{ o.onClick }}\" style=\"text-align:left;min-height:44px;padding:8px 10px;background:{{ o.bg }};border:2px solid {{ o.bd }};color:#e6ecff;cursor:pointer;font-size:15px;line-height:1.5;\" style-hover=\"border-color:#38e8ff;\">\u003Csc-for list=\"{{ o.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/button>\n                \u003C/sc-for>\n              \u003C/div>\n            \u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n\n        \u003Csc-if value=\"{{ pzFbOn }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv data-pzfb=\"1\" role=\"status\" aria-live=\"polite\" style=\"padding:12px 14px;background:{{ pzFbBg }};border:2px solid {{ pzFbBd }};display:flex;flex-direction:row;gap:14px;align-items:center;animation:rpRise .25s ease-out;\">\n            \u003Cdiv aria-hidden=\"true\" style=\"flex:none;width:76px;aspect-ratio:160/210;background-image:url({{ RES.robot_emote }});background-size:600% 100%;background-position:{{ pzEmoPos }} 0%;background-repeat:no-repeat;image-rendering:pixelated;animation:rpPop .45s ease-out;\">\u003C/div>\u003Cdiv style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:4px;\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:12px;color:{{ pzFbBd }};\">{{ pzFbHead }}\u003C/div>\n            \u003Cdiv style=\"font-size:17px;line-height:1.6;color:#eef2ff;text-wrap:pretty;\">\u003Csc-for list=\"{{ pzFbSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/div>\n          \u003C/div>\u003C/div>\n        \u003C/sc-if>\n      \u003C/div>\n      \u003Csc-if value=\"{{ pzTypeOn }}\" hint-placeholder-val=\"{{ false }}\">\n        \u003Cdiv style=\"margin:4px 18px 0;padding:14px 16px;background:#0b1a33;border:2px solid {{ pzTypeBd }};border-radius:8px;display:flex;flex-direction:column;gap:10px;\">\n          \u003Cdiv style=\"display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:12px;color:#ffb347;\">LOCK IT IN · TYPE THE CORRECT STATEMENT\u003C/span>\u003Cspan style=\"font-size:13px;color:#9fb0e0;\">{{ pzTypeCount }}\u003C/span>\u003C/div>\n          \u003Cdiv style=\"font-size:18px;line-height:1.6;color:#ffffff;padding:10px 12px;background:#04060d;border-radius:6px;border:1px dashed #2f4290;\">\u003Csc-for list=\"{{ pzTypeSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/div>\n          \u003Ctextarea value=\"{{ pzTyped }}\" sc-camel-on-input=\"{{ onTyped }}\" sc-camel-on-key-down=\"{{ onTypeKey }}\" sc-camel-on-paste=\"{{ onNoPaste }}\" sc-camel-on-drop=\"{{ onNoPaste }}\" rows=\"2\" spellcheck=\"false\" autocomplete=\"off\" aria-label=\"Type the correct statement\" placeholder=\"Start typing the statement above…\" style=\"width:100%;min-height:64px;padding:10px 12px;font:inherit;font-size:18px;line-height:1.5;background:#04060d;color:#e6ecff;border:2px solid {{ pzTypeBd }};border-radius:6px;resize:vertical;\">\u003C/textarea>\n          \u003Cdiv style=\"height:8px;background:#1b2652;border-radius:4px;overflow:hidden;\">\u003Cdiv style=\"height:100%;width:{{ pzTypePct }};background:{{ pzTypeBd }};transition:width .2s;\">\u003C/div>\u003C/div>\n          \u003Cdiv style=\"font-size:15px;color:{{ pzTypeBd }};font-weight:700;\">{{ pzTypeMsg }}\u003C/div>\n        \u003C/div>\n      \u003C/sc-if>\n      \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;align-items:center;padding:12px 18px 16px;\">\n        \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n          \u003Csc-if value=\"{{ pzCanHint }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onHint }}\" style=\"min-height:44px;padding:0 14px;border:2px solid #ffb347;background:#2a1a06;color:#ffd08a;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"background:#4a2e0a;\">{{ pzHintLabel }}\u003C/button>\u003C/sc-if>\n          \u003Cbutton sc-camel-on-click=\"{{ onInv }}\" style=\"min-height:44px;padding:0 12px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">EVIDENCE\u003C/button>\n          \u003Cbutton sc-camel-on-click=\"{{ onDb }}\" style=\"min-height:44px;padding:0 12px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">{{ pzDbLabel }}\u003C/button>\n          \u003Cbutton sc-camel-on-click=\"{{ onGloss }}\" style=\"min-height:44px;padding:0 12px;border:2px solid #2f4290;background:#0d1330;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">GLOSSARY\u003C/button>\n        \u003C/div>\n        \u003Cdiv style=\"display:flex;gap:8px;\">\n          \u003Csc-if value=\"{{ pzShowReset }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onPzReset }}\" style=\"min-height:44px;padding:0 14px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;font-size:14px;\" style-hover=\"color:#fff;\">Clear\u003C/button>\u003C/sc-if>\n          \u003Csc-if value=\"{{ pzShowCheck }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onCheck }}\" style=\"min-height:48px;padding:0 26px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:14px;cursor:pointer;\" style-hover=\"background:#8ff3ff;\">{{ pzCheckLabel }}\u003C/button>\u003C/sc-if>\n          \u003Csc-if value=\"{{ pzShowCont }}\" hint-placeholder-val=\"{{ false }}\">\u003Cbutton sc-camel-on-click=\"{{ onPzContinue }}\" style=\"min-height:48px;padding:0 26px;border:2px solid #4dff9a;background:#4dff9a;color:#04060d;font-family:'Silkscreen',monospace;font-size:14px;cursor:pointer;\" style-hover=\"background:#a8ffcf;\">{{ pzContLabel }}\u003C/button>\u003C/sc-if>\n        \u003C/div>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- DOCUMENT -->\n\u003Csc-if value=\"{{ ovDoc }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:72;background:rgba(2,4,12,.8);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"{{ docTitle }}\" style=\"width:100%;max-width:640px;margin:auto 0;display:flex;flex-direction:column;gap:0;box-shadow:0 20px 60px rgba(0,0,0,.6);animation:rpRise .25s ease-out;\">\n      \u003Cdiv style=\"background:{{ docPaper }};color:#1c1a16;padding:22px 24px;border:3px solid #04060d;display:flex;flex-direction:column;gap:10px;\">\n        \u003Cdiv style=\"display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap;\">\n          \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:10px;padding:3px 6px;background:#1c1a16;color:{{ docPaper }};\">{{ docIcon }}\u003C/span>\n          \u003Cspan style=\"font-size:12px;color:#5a5240;\">Found: {{ docFrom }} · {{ docPlace }}\u003C/span>\n        \u003C/div>\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:17px;line-height:1.25;color:#1c1a16;\">{{ docTitle }}\u003C/div>\n        \u003Csc-for list=\"{{ docBody }}\" as=\"b\" hint-placeholder-count=\"0\">\u003Cp style=\"margin:0;font-size:16px;line-height:1.5;padding:{{ b.pad }};background:{{ b.bg }};border-left:{{ b.bl }};font-weight:{{ b.fw }};color:{{ b.fg }};line-height:1.65;\">\u003Csc-for list=\"{{ b.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/p>\u003C/sc-for>\n      \u003C/div>\n      \u003Cdiv style=\"background:#0a0f24;border:3px solid #04060d;border-top:none;padding:12px 16px;display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;\">\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#4dff9a;\">{{ docStatus }}\u003C/span>\n        \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;\">\n          \u003Csc-for list=\"{{ docPuzzles }}\" as=\"p\" hint-placeholder-count=\"0\">\u003Cbutton sc-camel-on-click=\"{{ p.onClick }}\" style=\"min-height:44px;padding:0 14px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"background:#8ff3ff;\">OPEN: {{ p.title }}\u003C/button>\u003C/sc-for>\n          \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:44px;padding:0 18px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">CLOSE\u003C/button>\n        \u003C/div>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- TALK -->\n\u003Csc-if value=\"{{ ovTalk }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:60;background:rgba(2,4,12,.8);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"{{ talkName }}\" style=\"width:100%;max-width:760px;margin:auto 0;background:#0a0f24;border:3px solid {{ talkColor }};box-shadow:0 0 0 3px #04060d;display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;gap:16px;padding:16px;align-items:flex-start;flex-wrap:wrap;\">\n        \u003Csc-if value=\"{{ talkNoAnim }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"width:120px;height:120px;background-image:url({{ talkImg }});background-size:100% 100%;image-rendering:pixelated;border:2px solid {{ talkColor }};flex:none;\">\u003C/div>\u003C/sc-if>\n        \u003Csc-if value=\"{{ talkAnim }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv data-portrait=\"wallace-talk\" aria-hidden=\"true\" style=\"width:120px;height:164px;flex:none;border:2px solid {{ talkColor }};background-color:#04060d;background-image:url({{ RES.wallace }});background-size:1400% 100%;background-position:{{ talkFramePos }};background-repeat:no-repeat;image-rendering:pixelated;\">\u003C/div>\u003C/sc-if>\n        \u003Cdiv style=\"flex:1;min-width:220px;display:flex;flex-direction:column;gap:8px;\">\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:14px;color:{{ talkColor }};\">{{ talkName }}\u003C/div>\n          \u003Csc-for list=\"{{ talkLines }}\" as=\"l\" hint-placeholder-count=\"0\">\u003Cp style=\"margin:0;font-size:17px;line-height:1.6;color:#eef2ff;text-wrap:pretty;\">\u003Csc-for list=\"{{ l.seg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/p>\u003C/sc-for>\n          \u003Csc-if value=\"{{ talkGave }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#4dff9a;\">+ EVIDENCE ADDED: {{ talkGaveName }}\u003C/div>\u003C/sc-if>\n        \u003C/div>\n      \u003C/div>\n      \u003Cdiv style=\"padding:0 16px 16px;display:flex;flex-direction:column;gap:6px;\">\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#9fb0e0;\">ASK ABOUT…\u003C/div>\n        \u003Csc-for list=\"{{ talkTopics }}\" as=\"q\" hint-placeholder-count=\"0\">\u003Cbutton sc-camel-on-click=\"{{ q.onClick }}\" style=\"text-align:left;min-height:44px;padding:8px 12px;background:{{ q.bg }};border:2px solid {{ q.bd }};color:#e6ecff;cursor:pointer;font-size:15px;display:flex;gap:10px;\" style-hover=\"border-color:#38e8ff;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:{{ q.mc }};width:16px;flex:none;\">{{ q.mark }}\u003C/span>\u003Cspan style=\"flex:1;min-width:0;\">{{ q.q }}\u003C/span>\u003C/button>\u003C/sc-for>\n        \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-top:8px;\">\n          \u003Csc-for list=\"{{ talkPuzzles }}\" as=\"p\" hint-placeholder-count=\"0\">\u003Cbutton sc-camel-on-click=\"{{ p.onClick }}\" style=\"min-height:44px;padding:0 14px;border:2px solid #38e8ff;background:#38e8ff;color:#04060d;font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\" style-hover=\"background:#8ff3ff;\">OPEN: {{ p.title }}\u003C/button>\u003C/sc-for>\n          \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:44px;padding:0 18px;border:2px solid #2f4290;background:#0d1330;color:#e6ecff;font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"border-color:#38e8ff;\">DONE\u003C/button>\n        \u003C/div>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- INVENTORY -->\n\u003Csc-if value=\"{{ ovInv }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:70;background:rgba(2,4,12,.84);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"Evidence\" style=\"width:100%;max-width:900px;margin:auto 0;background:#0a0f24;border:2px solid #38e8ff;box-shadow:0 0 0 4px #04060d;display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:2px solid #1b2652;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:16px;color:#38e8ff;\">EVIDENCE LOCKER · {{ invCount }}\u003C/span>\u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:36px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;\" style-hover=\"color:#fff;\">Close ✕\u003C/button>\u003C/div>\n      \u003Cdiv style=\"padding:14px 16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;\">\n        \u003Csc-for list=\"{{ invList }}\" as=\"e\" hint-placeholder-count=\"0\">\n          \u003Cbutton sc-camel-on-click=\"{{ e.onClick }}\" style=\"text-align:left;display:flex;flex-direction:column;gap:4px;padding:10px 12px;background:#0d1330;border:2px solid #1f2a5a;color:#e6ecff;cursor:pointer;min-height:76px;\" style-hover=\"border-color:#38e8ff;background:#13204a;\">\n            \u003Cdiv style=\"display:flex;gap:8px;align-items:center;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:9px;padding:3px 4px;background:{{ e.ic }};color:#04060d;\">{{ e.icon }}\u003C/span>\u003Cspan style=\"font-size:15px;font-weight:700;\">{{ e.name }}\u003C/span>\u003C/div>\n            \u003Cspan style=\"font-size:12px;color:#9fb0e0;\">{{ e.place }} · {{ e.from }}\u003C/span>\n            \u003Cspan style=\"font-size:13px;color:#c6d2f5;\">{{ e.peek }}\u003C/span>\n          \u003C/button>\n        \u003C/sc-for>\n        \u003Csc-if value=\"{{ invEmpty }}\" hint-placeholder-val=\"{{ false }}\">\u003Cp style=\"margin:0;color:#9fb0e0;\">No evidence yet. Inspect objects in a room to collect clues.\u003C/p>\u003C/sc-if>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- DATABASE -->\n\u003Csc-if value=\"{{ ovDb }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:70;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"Constitutional Database\" style=\"width:100%;max-width:1000px;margin:auto 0;background:#06120c;border:2px solid #4dff9a;box-shadow:0 0 0 4px #04060d,0 0 40px rgba(77,255,154,.18);display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:2px solid #0f4f34;\">\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:16px;color:#4dff9a;\">CONSTITUTIONAL DATABASE · {{ filesN }}/10\u003C/span>\n        \u003Cdiv style=\"flex:1;min-width:160px;max-width:300px;height:12px;background:#0f2a1d;border:1px solid #1f9e5c;\">\u003Cdiv style=\"height:100%;width:{{ integrity }};background:#4dff9a;\">\u003C/div>\u003C/div>\n        \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:36px;padding:0 12px;border:1px solid #1f9e5c;background:transparent;color:#9fe8c0;cursor:pointer;\" style-hover=\"color:#fff;\">Close ✕\u003C/button>\n      \u003C/div>\n      \u003Csc-if value=\"{{ dbLocked }}\" hint-placeholder-val=\"{{ false }}\">\n        \u003Cdiv style=\"padding:30px 20px;display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;\">\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:18px;color:#ff3fb4;\">MEMORY CHECK IN PROGRESS\u003C/div>\n          \u003Cp style=\"margin:0;max-width:520px;color:#dbe3ff;\">Try this one from memory first. Submit any answer and the database unlocks right away — it’s here to help, not to lock you out.\u003C/p>\n          \u003Cp style=\"margin:0;max-width:520px;color:#9fb0e0;font-size:14px;\">The glossary and your evidence are still available.\u003C/p>\n        \u003C/div>\n      \u003C/sc-if>\n      \u003Csc-if value=\"{{ dbOpen }}\" hint-placeholder-val=\"{{ true }}\">\n        \u003Cdiv style=\"padding:14px 16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:10px;\">\n          \u003Csc-for list=\"{{ dbCards }}\" as=\"c\" hint-placeholder-count=\"10\">\n            \u003Cbutton sc-camel-on-click=\"{{ c.onClick }}\" disabled=\"{{ c.locked }}\" aria-label=\"{{ c.aria }}\" style=\"text-align:left;display:flex;flex-direction:column;gap:8px;padding:12px;min-height:170px;background:{{ c.bg }};border:2px solid {{ c.bd }};color:#e6ecff;cursor:{{ c.cursor }};\" style-hover=\"filter:brightness(1.2);\">\n              \u003Cdiv style=\"display:flex;justify-content:space-between;align-items:center;\">\n                \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:24px;color:{{ c.fg }};\">{{ c.roman }}\u003C/span>\n                \u003Cdiv style=\"width:48px;height:48px;background-color:{{ c.iconBg }};background-image:url({{ RES.icons }});background-size:480px 48px;background-position:{{ c.iconPos }};image-rendering:pixelated;opacity:{{ c.iconOp }};\">\u003C/div>\n              \u003C/div>\n              \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:12px;color:{{ c.fg }};\">{{ c.title }}\u003C/span>\n              \u003Cspan style=\"font-size:13px;color:#c6d2f5;\">{{ c.short }}\u003C/span>\n            \u003C/button>\n          \u003C/sc-for>\n        \u003C/div>\n      \u003C/sc-if>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- CARD DETAIL -->\n\u003Csc-if value=\"{{ ovCard }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:74;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"{{ cardHead }}\" style=\"width:100%;max-width:720px;margin:auto 0;background:#0a0f24;border:3px solid {{ cardColor }};box-shadow:0 0 0 4px #04060d,0 0 50px {{ cardGlow }};display:flex;flex-direction:column;animation:rpRise .3s ease-out;\">\n      \u003Cdiv style=\"display:flex;gap:16px;align-items:center;padding:16px;background:#0e1a3a;flex-wrap:wrap;\">\n        \u003Cdiv style=\"width:72px;height:72px;flex:none;background-color:{{ cardColor }};background-image:url({{ RES.icons }});background-size:720px 72px;background-position:{{ cardIconPos }};image-rendering:pixelated;\">\u003C/div>\n        \u003Cdiv style=\"flex:1;min-width:200px;\">\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:13px;color:{{ cardColor }};\">AMENDMENT {{ cardRoman }} · {{ cardNum }}\u003C/div>\n          \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:22px;color:#fff;\">{{ cardTitle }}\u003C/div>\n        \u003C/div>\n        \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:36px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;\" style-hover=\"color:#fff;\">Close ✕\u003C/button>\n      \u003C/div>\n      \u003Cdiv style=\"padding:16px 18px 20px;display:flex;flex-direction:column;gap:14px;\">\n        \u003Cblockquote style=\"margin:0;padding:12px 14px;background:#1c1508;border:2px solid #b8732a;color:#ffe2b8;font-family:Georgia,serif;font-size:16px;line-height:1.5;\">“{{ cardExcerpt }}”\u003C/blockquote>\n        \u003Cdiv>\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">PLAIN ENGLISH\u003C/div>\u003Cp style=\"margin:4px 0 0;font-size:17px;line-height:1.6;\">\u003Csc-for list=\"{{ cardPlainSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/p>\u003C/div>\n        \u003Cdiv>\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#38e8ff;\">EXAMPLE\u003C/div>\u003Cp style=\"margin:4px 0 0;font-size:17px;line-height:1.6;\">\u003Csc-for list=\"{{ cardExampleSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/p>\u003C/div>\n        \u003Cdiv style=\"padding:10px 12px;background:#2a1a06;border:2px solid #ffb347;\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;\">I NEED TO REMEMBER\u003C/div>\u003Cp style=\"margin:4px 0 0;font-size:16px;font-weight:700;color:#ffe2b8;\">{{ cardRemember }}\u003C/p>\u003C/div>\n        \u003Cdiv>\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ff3fb4;\">DON’T CONFUSE IT WITH\u003C/div>\u003Cp style=\"margin:4px 0 0;font-size:17px;line-height:1.6;\">\u003Csc-for list=\"{{ cardConfuseSeg }}\" as=\"sg\" hint-placeholder-count=\"0\">\u003Cspan sc-camel-on-click=\"{{ sg.on }}\" sc-camel-on-key-down=\"{{ sg.onk }}\" tabindex=\"{{ sg.ti }}\" role=\"{{ sg.role }}\" title=\"{{ sg.tip }}\" style=\"cursor:{{ sg.cur }};color:{{ sg.c }};font-weight:{{ sg.w }};font-style:{{ sg.i }};background:{{ sg.bg }};padding:{{ sg.p }};border-radius:4px;text-decoration:{{ sg.u }};text-decoration-thickness:2px;text-underline-offset:4px;\">{{ sg.t }}\u003C/span>\u003C/sc-for>\u003C/p>\u003C/div>\n        \u003Cdiv>\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#9fb0e0;\">HISTORY\u003C/div>\u003Cp style=\"margin:4px 0 0;font-size:15px;color:#c6d2f5;\">{{ cardHistory }}\u003C/p>\u003C/div>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- GLOSSARY -->\n\u003Csc-if value=\"{{ ovGloss }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:70;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"Glossary\" style=\"width:100%;max-width:780px;margin:auto 0;background:#0a0f24;border:2px solid #38e8ff;box-shadow:0 0 0 4px #04060d;display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:2px solid #1b2652;\">\n        \u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:16px;color:#38e8ff;\">GLOSSARY\u003C/span>\n        \u003Cinput value=\"{{ glossQ }}\" sc-camel-on-input=\"{{ onGlossQ }}\" placeholder=\"Search terms…\" aria-label=\"Search glossary\" style=\"flex:1;min-width:160px;min-height:40px;padding:0 12px;background:#04060d;border:2px solid #2f4290;color:#e6ecff;font-size:15px;border-radius:0;\">\n        \u003Cbutton sc-camel-on-click=\"{{ onToggleEs }}\" aria-pressed=\"{{ esOn }}\" style=\"min-height:40px;padding:0 12px;border:2px solid {{ esBd }};background:{{ esBg }};color:#e6ecff;cursor:pointer;font-size:13px;font-weight:700;\">Español {{ esLabel }}\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:40px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;\" style-hover=\"color:#fff;\">Close ✕\u003C/button>\n      \u003C/div>\n      \u003Cdiv style=\"padding:12px 16px 18px;display:flex;flex-direction:column;gap:8px;\">\n        \u003Csc-for list=\"{{ glossList }}\" as=\"g\" hint-placeholder-count=\"0\">\n          \u003Cdiv style=\"padding:10px 12px;background:#0d1330;border:1px solid #1f2a5a;display:flex;flex-direction:column;gap:3px;\">\n            \u003Cdiv style=\"font-weight:800;font-size:16px;color:#ffb347;\">{{ g.t }}\u003C/div>\n            \u003Cdiv style=\"font-size:15px;color:#e6ecff;\">{{ g.d }}\u003C/div>\n            \u003Csc-if value=\"{{ esOn }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-size:14px;color:#a8ffcf;border-top:1px dashed #1f9e5c;padding-top:4px;margin-top:2px;\">\u003Cb>ES:\u003C/b> {{ g.es }} — {{ g.esd }}\u003C/div>\u003C/sc-if>\n          \u003C/div>\n        \u003C/sc-for>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- SETTINGS -->\n\u003Csc-if value=\"{{ ovSet }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:76;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"Settings\" style=\"width:100%;max-width:560px;margin:auto 0;background:#0a0f24;border:2px solid #38e8ff;box-shadow:0 0 0 4px #04060d;display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:2px solid #1b2652;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:16px;color:#38e8ff;\">SETTINGS\u003C/span>\u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:36px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;\" style-hover=\"color:#fff;\">Close ✕\u003C/button>\u003C/div>\n      \u003Cdiv style=\"padding:14px 16px 18px;display:flex;flex-direction:column;gap:8px;\">\n        \u003Csc-for list=\"{{ setToggles }}\" as=\"t\" hint-placeholder-count=\"0\">\n          \u003Cbutton role=\"switch\" aria-checked=\"{{ t.on }}\" sc-camel-on-click=\"{{ t.onClick }}\" style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:8px 12px;background:#0d1330;border:1px solid #1f2a5a;color:#e6ecff;cursor:pointer;text-align:left;\" style-hover=\"border-color:#38e8ff;\">\n            \u003Cspan>\u003Cspan style=\"display:block;font-weight:700;font-size:15px;\">{{ t.label }}\u003C/span>\u003Cspan style=\"display:block;font-size:12px;color:#9fb0e0;\">{{ t.sub }}\u003C/span>\u003C/span>\n            \u003Cspan style=\"flex:none;width:48px;height:24px;border:2px solid {{ t.bd }};background:{{ t.bg }};position:relative;\">\u003Cspan style=\"position:absolute;top:2px;left:{{ t.knob }};width:16px;height:16px;background:{{ t.kc }};\">\u003C/span>\u003C/span>\n          \u003C/button>\n        \u003C/sc-for>\n        \u003Cdiv style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:8px 12px;background:#0d1330;border:1px solid #1f2a5a;flex-wrap:wrap;\">\n          \u003Cspan style=\"font-weight:700;font-size:15px;\">Text size\u003C/span>\n          \u003Cdiv style=\"display:flex;gap:4px;\">\u003Csc-for list=\"{{ sizeOpts }}\" as=\"o\" hint-placeholder-count=\"3\">\u003Cbutton sc-camel-on-click=\"{{ o.onClick }}\" aria-pressed=\"{{ o.on }}\" style=\"min-height:38px;min-width:54px;border:2px solid {{ o.bd }};background:{{ o.bg }};color:#e6ecff;cursor:pointer;font-weight:700;\">{{ o.label }}\u003C/button>\u003C/sc-for>\u003C/div>\n        \u003C/div>\n        \u003Clabel style=\"display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:8px 12px;background:#0d1330;border:1px solid #1f2a5a;\">\n          \u003Cspan style=\"font-weight:700;font-size:15px;\">Volume\u003C/span>\n          \u003Cinput type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" value=\"{{ vol }}\" sc-camel-on-input=\"{{ onVol }}\" style=\"flex:1;max-width:220px;accent-color:#38e8ff;\">\n        \u003C/label>\n        \u003Cp style=\"margin:4px 0 0;font-size:13px;color:#9fb0e0;\">{{ storageMsg }} Sound is never needed to solve a puzzle.\u003C/p>\n        \u003Csc-if value=\"{{ canRestart }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:6px;\">\n            \u003Cbutton sc-camel-on-click=\"{{ onRestartAsk }}\" style=\"min-height:44px;padding:0 14px;border:2px solid #ff3355;background:transparent;color:#ff8a9a;cursor:pointer;font-weight:700;\" style-hover=\"background:#2a0a12;\">Restart investigation…\u003C/button>\n            \u003Csc-if value=\"{{ confirmRestart }}\" hint-placeholder-val=\"{{ false }}\">\u003Cspan style=\"font-size:14px;color:#ffb3bf;\">Erase all progress?\u003C/span>\u003Cbutton sc-camel-on-click=\"{{ onRestartYes }}\" style=\"min-height:44px;padding:0 14px;border:2px solid #ff3355;background:#ff3355;color:#04060d;cursor:pointer;font-weight:800;\">Yes, erase\u003C/button>\u003C/sc-if>\n          \u003C/div>\n        \u003C/sc-if>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- HELP / MENU / HOW / SOURCES / TRANSCRIPT / BOARD / CONFIRM -->\n\u003Csc-if value=\"{{ ovInfo }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:66;background:rgba(2,4,12,.86);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"{{ infoTitle }}\" style=\"width:100%;max-width:760px;margin:auto 0;background:#0a0f24;border:2px solid {{ infoColor }};box-shadow:0 0 0 4px #04060d;display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"display:flex;justify-content:space-between;align-items:center;padding:12px 16px;border-bottom:2px solid #1b2652;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:16px;color:{{ infoColor }};\">{{ infoTitle }}\u003C/span>\u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:36px;padding:0 12px;border:1px solid #2f4290;background:transparent;color:#9fb0e0;cursor:pointer;\" style-hover=\"color:#fff;\">Close ✕\u003C/button>\u003C/div>\n      \u003Cdiv style=\"padding:14px 18px 18px;display:flex;flex-direction:column;gap:10px;\">\n        \u003Csc-for list=\"{{ infoBlocks }}\" as=\"b\" hint-placeholder-count=\"0\">\n          \u003Cdiv style=\"display:flex;flex-direction:column;gap:4px;padding:{{ b.pad }};background:{{ b.bg }};border:{{ b.border }};\">\n            \u003Csc-if value=\"{{ b.hasHead }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:12px;color:{{ b.hc }};\">{{ b.head }}\u003C/div>\u003C/sc-if>\n            \u003Cdiv style=\"font-size:15px;color:#e6ecff;text-wrap:pretty;white-space:pre-line;\">{{ b.text }}\u003C/div>\n            \u003Csc-if value=\"{{ b.hasLink }}\" hint-placeholder-val=\"{{ false }}\">\u003Ca href=\"{{ b.link }}\" target=\"_blank\" rel=\"noopener\" style=\"font-size:13px;word-break:break-all;\">{{ b.link }}\u003C/a>\u003C/sc-if>\n          \u003C/div>\n        \u003C/sc-for>\n        \u003Csc-if value=\"{{ infoHasActions }}\" hint-placeholder-val=\"{{ false }}\">\n          \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;\">\n            \u003Csc-for list=\"{{ infoActions }}\" as=\"a\" hint-placeholder-count=\"0\">\u003Cbutton sc-camel-on-click=\"{{ a.onClick }}\" style=\"min-height:46px;padding:0 16px;border:2px solid {{ a.bd }};background:{{ a.bg }};color:{{ a.fg }};font-family:'Silkscreen',monospace;font-size:12px;cursor:pointer;\" style-hover=\"filter:brightness(1.2);\">{{ a.label }}\u003C/button>\u003C/sc-for>\n          \u003C/div>\n        \u003C/sc-if>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- FREEDOM WORD -->\n\u003Csc-if value=\"{{ ovWord }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:90;background:rgba(2,4,12,.82);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv role=\"dialog\" aria-label=\"Meaning of {{ wW }}\" style=\"width:100%;max-width:600px;margin:auto 0;background:#0a0f24;border:3px solid {{ wCol }};border-radius:14px;box-shadow:0 0 0 4px #04060d,0 0 50px rgba(0,0,0,.6);display:flex;flex-direction:column;overflow:hidden;animation:rpRise .25s ease-out;\">\n      \u003Cdiv style=\"padding:16px 18px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;background:#0e1a3a;\">\n        \u003Cdiv style=\"display:flex;flex-direction:column;gap:4px;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#9fb0e0;\">FIRST AMENDMENT · WHAT IT MEANS TODAY\u003C/span>\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:30px;line-height:1.05;color:{{ wCol }};\">{{ wW }}\u003C/span>\u003Cspan style=\"font-size:19px;font-weight:800;color:#ffffff;\">“{{ wVibe }}”\u003C/span>\u003C/div>\n        \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"flex:none;min-height:40px;padding:0 14px;border:2px solid #2f4290;background:transparent;color:#e6ecff;cursor:pointer;font-weight:700;\" style-hover=\"border-color:#ffffff;\">Got it ✕\u003C/button>\n      \u003C/div>\n      \u003Cdiv style=\"padding:16px 18px 18px;display:flex;flex-direction:column;gap:14px;\">\n        \u003Cp style=\"margin:0;font-size:18px;line-height:1.6;color:#eef2ff;text-wrap:pretty;\">{{ wPlain }}\u003C/p>\n        \u003Cdiv style=\"display:flex;flex-direction:column;gap:6px;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:{{ wCol }};\">REAL-LIFE EXAMPLES\u003C/span>\n          \u003Csc-for list=\"{{ wNow }}\" as=\"n\" hint-placeholder-count=\"2\">\u003Cdiv style=\"display:flex;gap:10px;align-items:flex-start;font-size:16px;line-height:1.5;color:#dbe3ff;\">\u003Cspan style=\"flex:none;width:10px;height:10px;margin-top:7px;border-radius:999px;background:{{ wCol }};\">\u003C/span>\u003Cspan>{{ n }}\u003C/span>\u003C/div>\u003C/sc-for>\n        \u003C/div>\n        \u003Cdiv style=\"padding:10px 12px;background:#2a1a06;border:2px solid #ffb347;border-radius:8px;\">\u003Cspan style=\"font-family:'Silkscreen',monospace;font-size:11px;color:#ffb347;\">HEADS UP — THE LIMIT\u003C/span>\u003Cp style=\"margin:4px 0 0;font-size:16px;line-height:1.5;color:#ffe2b8;\">{{ wLimit }}\u003C/p>\u003C/div>\n        \u003Csc-if value=\"{{ wEsOn }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-size:15px;color:#a8ffcf;\">\u003Cb>ES:\u003C/b> {{ wEs }}\u003C/div>\u003C/sc-if>\n        \u003Cdiv style=\"display:flex;flex-wrap:wrap;gap:6px;\">\u003Csc-for list=\"{{ wOthers }}\" as=\"o\" hint-placeholder-count=\"5\">\u003Cbutton sc-camel-on-click=\"{{ o.onClick }}\" style=\"min-height:36px;padding:0 12px;border-radius:999px;border:2px solid {{ o.col }};background:{{ o.bg }};color:{{ o.fg }};font-family:'Silkscreen',monospace;font-size:11px;cursor:pointer;\">{{ o.label }}\u003C/button>\u003C/sc-for>\u003C/div>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- RECOVERY SEQUENCE -->\n\u003Csc-if value=\"{{ ovRec }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:85;background:rgba(2,8,6,.94);display:flex;justify-content:center;align-items:center;padding:16px;overflow:auto;\">\n    \u003Cdiv style=\"position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(77,255,154,.05) 0 1px,transparent 1px 3px);\">\u003C/div>\n    \u003Cdiv role=\"dialog\" aria-label=\"File recovered\" style=\"position:relative;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;max-width:620px;\">\n      \u003Cdiv style=\"font-family:'VT323',monospace;font-size:30px;color:#4dff9a;letter-spacing:.1em;\">&gt; FILE RECOVERED\u003C/div>\n      \u003Cdiv aria-hidden=\"true\" style=\"position:absolute;right:-150px;bottom:-10px;width:130px;aspect-ratio:190/205;background-image:url({{ RES.robot_pose }});background-size:700% 100%;background-position:{{ recPosePos }} 0%;background-repeat:no-repeat;image-rendering:pixelated;animation:rpBob 1.2s ease-in-out infinite;\">\u003C/div>\n      \u003Csc-if value=\"{{ recP1 }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"width:120px;height:120px;background-color:{{ recColor }};background-image:url({{ RES.icons }});background-size:1200px 120px;background-position:{{ recIconPos }};image-rendering:pixelated;box-shadow:0 0 60px {{ recColor }};animation:rpRise .5s ease-out;\">\u003C/div>\u003C/sc-if>\n      \u003Csc-if value=\"{{ recP2 }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:clamp(28px,5vw,48px);color:#fff;animation:rpRise .5s ease-out;\">AMENDMENT {{ recRoman }}\u003C/div>\u003C/sc-if>\n      \u003Csc-if value=\"{{ recP3 }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:clamp(14px,2.2vw,20px);color:{{ recColor }};animation:rpRise .5s ease-out;\">{{ recTitle }}\u003C/div>\u003Cdiv style=\"font-size:17px;color:#ffe2b8;max-width:520px;animation:rpRise .5s ease-out;\">{{ recRemember }}\u003C/div>\u003C/sc-if>\n      \u003Csc-if value=\"{{ recP4 }}\" hint-placeholder-val=\"{{ false }}\">\u003Cdiv style=\"font-family:'VT323',monospace;font-size:26px;color:#4dff9a;\">SYSTEM INTEGRITY RESTORED +10% · {{ integrity }}\u003C/div>\n        \u003Cbutton sc-camel-on-click=\"{{ onRecDone }}\" style=\"margin-top:8px;min-height:52px;padding:0 26px;border:2px solid #4dff9a;background:#4dff9a;color:#04060d;font-family:'Silkscreen',monospace;font-size:15px;cursor:pointer;\" style-hover=\"background:#a8ffcf;\">ADD TO DATABASE\u003C/button>\u003C/sc-if>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C!-- REPORT -->\n\u003Csc-if value=\"{{ ovReport }}\" hint-placeholder-val=\"{{ false }}\">\n  \u003Cdiv style=\"position:fixed;inset:0;z-index:78;background:rgba(2,4,12,.9);display:flex;justify-content:center;align-items:flex-start;padding:16px;overflow:auto;\">\n    \u003Cdiv data-print=\"1\" role=\"dialog\" aria-label=\"Investigator report\" style=\"width:100%;max-width:800px;margin:auto 0;background:#f3efe0;color:#1c1a16;border:3px solid #04060d;box-shadow:0 20px 60px rgba(0,0,0,.6);display:flex;flex-direction:column;\">\n      \u003Cdiv style=\"padding:20px 24px;border-bottom:3px double #1c1a16;display:flex;flex-direction:column;gap:4px;\">\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:12px;color:#8e1a30;\">RIGHTS RECOVERY UNIT · INVESTIGATOR REPORT\u003C/div>\n        \u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:24px;\">THE RIGHTS PROTOCOL\u003C/div>\n        \u003Cdiv style=\"font-size:14px;color:#4a4436;\">Mr. Wallace’s U.S. History · Generated from this browser’s saved game data\u003C/div>\n      \u003C/div>\n      \u003Cdiv style=\"padding:18px 24px;display:flex;flex-direction:column;gap:14px;\">\n        \u003Clabel data-noprint=\"1\" style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-weight:700;\">Name or initials (optional):\n          \u003Cinput value=\"{{ repName }}\" sc-camel-on-input=\"{{ onRepName }}\" maxlength=\"40\" style=\"min-height:40px;padding:0 10px;border:2px solid #1c1a16;background:#fff;color:#1c1a16;font-size:16px;flex:1;min-width:180px;\">\n        \u003C/label>\n        \u003Cdiv style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;\">\n          \u003Csc-for list=\"{{ repStats }}\" as=\"s\" hint-placeholder-count=\"0\">\u003Cdiv style=\"padding:10px;border:2px solid #1c1a16;background:#fff;\">\u003Cdiv style=\"font-size:11px;font-weight:800;letter-spacing:.06em;color:#5a5240;\">{{ s.k }}\u003C/div>\u003Cdiv style=\"font-size:18px;font-weight:800;\">{{ s.v }}\u003C/div>\u003C/div>\u003C/sc-for>\n        \u003C/div>\n        \u003Cdiv style=\"padding:12px 14px;border:3px solid {{ repRankBd }};background:#fff;\">\u003Cdiv style=\"font-size:11px;font-weight:800;letter-spacing:.06em;color:#5a5240;\">FINAL RANK\u003C/div>\u003Cdiv style=\"font-family:'Silkscreen',monospace;font-size:20px;\">{{ repRank }}\u003C/div>\u003Cdiv style=\"font-size:13px;color:#4a4436;\">{{ repRankNote }}\u003C/div>\u003C/div>\n        \u003Cdiv>\n          \u003Cdiv style=\"font-size:12px;font-weight:800;letter-spacing:.06em;margin-bottom:6px;\">AMENDMENT MASTERY (first-try accuracy on case challenges)\u003C/div>\n          \u003Cdiv style=\"display:flex;flex-direction:column;gap:4px;\">\n            \u003Csc-for list=\"{{ repAms }}\" as=\"a\" hint-placeholder-count=\"0\">\u003Cdiv style=\"display:flex;gap:10px;align-items:center;padding:6px 8px;background:#fff;border:1px solid #c9bf9c;font-size:14px;\">\u003Cspan style=\"width:44px;font-weight:800;\">{{ a.roman }}\u003C/span>\u003Cspan style=\"flex:1;\">{{ a.title }}\u003C/span>\u003Cspan style=\"width:120px;font-weight:700;\">{{ a.level }}\u003C/span>\u003Cspan style=\"width:70px;text-align:right;color:#4a4436;\">{{ a.score }}\u003C/span>\u003C/div>\u003C/sc-for>\n          \u003C/div>\n        \u003C/div>\n        \u003Cdiv>\u003Cdiv style=\"font-size:12px;font-weight:800;letter-spacing:.06em;margin-bottom:4px;\">CONCEPTS NEEDING REVIEW\u003C/div>\u003Cdiv style=\"font-size:14px;\">{{ repReview }}\u003C/div>\u003C/div>\n        \u003Cdiv style=\"font-size:12px;color:#5a5240;\">Report generated {{ repDate }}. Progress is stored only in this browser; nothing is sent anywhere.\u003C/div>\n      \u003C/div>\n      \u003Cdiv data-noprint=\"1\" style=\"padding:12px 24px 18px;display:flex;flex-wrap:wrap;gap:8px;border-top:2px solid #c9bf9c;\">\n        \u003Cbutton sc-camel-on-click=\"{{ onPrint }}\" style=\"min-height:44px;padding:0 16px;border:2px solid #1c1a16;background:#1c1a16;color:#f3efe0;font-weight:800;cursor:pointer;\">Print / Save PDF\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onDownload }}\" style=\"min-height:44px;padding:0 16px;border:2px solid #1c1a16;background:#fff;color:#1c1a16;font-weight:800;cursor:pointer;\">Download .txt\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ onCopy }}\" style=\"min-height:44px;padding:0 16px;border:2px solid #1c1a16;background:#fff;color:#1c1a16;font-weight:800;cursor:pointer;\">{{ copyLabel }}\u003C/button>\n        \u003Cbutton sc-camel-on-click=\"{{ closeTop }}\" style=\"min-height:44px;padding:0 16px;border:2px solid #8a8370;background:transparent;color:#1c1a16;font-weight:700;cursor:pointer;margin-left:auto;\">Close\u003C/button>\n      \u003C/div>\n    \u003C/div>\n  \u003C/div>\n\u003C/sc-if>\n\n\u003C/div>\n\u003C/x-dc>\n\u003Cscript type=\"text/x-dc\" data-dc-script=\"\">\nconst SK='rightsProtocol.save.v1', SS='rightsProtocol.settings.v1';\nconst DEF_SET={hl:true,rm:false,tw:true,fs:1,markers:true,es:false,sfx:false,music:false,vol:0.5};\nconst ROMAN=['','I','II','III','IV','V','VI','VII','VIII','IX','X'];\nconst SPR=[[6,120,52,67],[69,128,58,60],[184,129,67,61],[131,137,44,51],[67,192,59,61],[129,192,63,63],[195,197,59,73],[192,64,64,60]];\nconst TOWER=[5,196,23,71];\nconst ICON={news:['NEWS','#f5c542'],poster:['POSTER','#ff3fb4'],memo:['MEMO','#e6ecff'],text:['TEXT','#38e8ff'],tape:['TAPE','#a98bff'],log:['LOG','#4dff9a'],case:['CASE','#ffb347'],report:['REPORT','#7ad8c8'],photo:['PHOTO','#ff8a3d'],null:['NULL','#ff3fb4']};\nfunction lsGet(k){try{return JSON.parse(localStorage.getItem(k))}catch(e){return null}}\nfunction lsSet(k,v){try{localStorage.setItem(k,JSON.stringify(v));if(window.__rpSaveSnapshot)window.__rpSaveSnapshot(k,v);return true}catch(e){return false}}\nfunction crop(sp,img){const [x,y,w,h]=sp;return {img,ar:w+'/'+h,bs:(256/w*100)+'% '+(272/h*100)+'%',bp:(x/(256-w)*100)+'% '+(y/(272-h)*100)+'%'}}\nconst RICH=/(“[^”]{3,}”)|(\\b(?:First|Second|Third|Fourth|Fifth|Sixth|Seventh|Eighth|Ninth|Tenth|Fourteenth)(?: Amendment)?\\b|\\bAmendment [IVX]+\\b)|(\\b(?:Tinker|Heller|McDonald|Bruen|Rahimi|Miranda|Gideon|Crawford|Salerno|T\\.L\\.O\\.|Torcaso)\\b)|(\\b(?:NOT|not|never|always|only|every|cannot|can’t|must|isn’t|doesn’t|don’t)\\b)|(\\b(?:warrants?|probable cause|reasonable grounds|reasonable in scope|due process|double jeopardy|self-incrimination|incriminat\\w*|custody|custodial|interrogat\\w*|counsel|attorney|lawyer|acquitt\\w*|not guilty|civil|criminal|prosecutions?|bail|quarter(?:ed|ing)|petition|assembl(?:y|e)|freedom of the press|speech|religion|jury|juries|impartial|compulsory process|confront\\w*|cross-examin\\w*|delegated|reserved|enumerat\\w*|viewpoint|disrupt\\w*|searche?s?|searched|seiz\\w*|cruel and unusual|excessive)\\b)/g;\nconst RSTY={dark:{q:['#ffc9d2','600','italic','rgba(255,51,85,.16)','0 3px','none'],am:['#04060d','800','normal','#ffb347','0 5px','none'],cs:['#f5c542','800','italic','transparent','0','none'],tr:['#ffe08a','800','normal','transparent','0','underline'],tm:['#7ff0ff','700','normal','transparent','0','none']},\npaper:{q:['#8e1a30','700','italic','rgba(142,26,48,.08)','0 3px','none'],am:['#f3efe0','800','normal','#1c1a16','0 5px','none'],cs:['#7a4a00','800','italic','transparent','0','none'],tr:['#8e1a30','800','normal','transparent','0','underline'],tm:['#0e5a75','800','normal','transparent','0','none']}};\nfunction seg(t,c,w,i,bg,p,u){return {t,c:c||'inherit',w:w||'inherit',i:i||'normal',bg:bg||'transparent',p:p||'0',u:u||'none',cur:'inherit'}}\nconst FWRE=/\\b(religion|religious|speech|press|assembly|assemble|petition|petitions|petitioned)\\b/gi;const FWK=w=>{w=w.toLowerCase();return w.startsWith('relig')?'religion':w.startsWith('assem')?'assembly':w.startsWith('petit')?'petition':w}\nconst FWC={religion:'#a98bff',speech:'#38e8ff',press:'#f5c542',assembly:'#4dff9a',petition:'#ff8a3d'};\nfunction fwSplit(out,on,theme){const res=[];for(const g of out){let last=0;g.t.replace(FWRE,(m,_w,idx)=>{if(idx>last)res.push({...g,t:g.t.slice(last,idx)});const k=FWK(m);const col=FWC[k];const open=e=>{if(e){e.stopPropagation();e.preventDefault()}window.__rpWord&&window.__rpWord(k)};res.push({...g,t:m,c:theme==='paper'?'#1c1a16':col,w:'800',bg:theme==='paper'?col+'55':col+'22',p:'0 4px',u:'underline dotted',cur:'help',on:open,onk:e=>{if(e.key==='Enter'||e.key===' ')open(e)},ti:'0',role:'button',tip:'What does “'+m+'” mean today? Click to see.'});last=idx+m.length;return m});if(last\u003Cg.t.length)res.push(last?{...g,t:g.t.slice(last)}:g)}return res}\nfunction rich(text,on,theme,noWord){text=text||'';if(!on)return noWord?[seg(text)]:fwSplit([seg(text)],on,theme);const S=RSTY[theme||'dark'];const out=[];let last=0;text.replace(RICH,(m,q,am,cs,tr,tm,idx)=>{if(idx>last)out.push(seg(text.slice(last,idx)));const k=q?'q':am?'am':cs?'cs':tr?'tr':'tm';out.push(seg(m,...S[k]));last=idx+m.length;return m});if(last\u003Ctext.length)out.push(seg(text.slice(last)));return noWord?out:fwSplit(out,on,theme)}\nfunction splitPrompt(p){const parts=(p||'').split(/(?\u003C=[.?!”])\\s+(?=[A-Z“(])/);if(parts.length\u003C2)return ['',p||''];return [parts.slice(0,-1).join(' '),parts[parts.length-1]]}\nconst MAPPOS={hq:[828,355],m1:[160,170],m2:[563,165],m3:[835,175],m4:[1085,165],a9:[1483,165],a3:[170,550],m6:[565,560],m5:[825,565],a8:[1100,550],a10:[1487,565]};\nconst STAND={hq:[760,505],m1:[165,372],m2:[563,372],m3:[833,372],m4:[1085,372],a9:[1483,372],a3:[170,470],m6:[565,470],m5:[900,472],a8:[1100,470],a10:[1487,470],vault:[760,505]};\nconst SEL={bg:'#13305a',bd:'#3