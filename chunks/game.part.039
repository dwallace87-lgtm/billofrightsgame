ast?40:420);this.sfx('unlock')}\n  // ── report\n  report(){const s=this.state.save,D=this.D;const per={};for(let n=1;n\u003C=10;n++)per[n]={tot:0,first:0,done:0};let tot=0,first=0,done=0,recT=0,recF=0;const rev=[];\n    D.missions.forEach(m=>m.puzzles.forEach(p=>p.steps.forEach((st,i)=>{if(st.type==='info')return;const k=this.pKey(m.id,p.id,i);const ams=[].concat(st.am!=null?st.am:m.am).filter(x=>x>0);const d=!!s.steps[k];const x=s.stats[k]||{t:0,h:0};const f=d&&x.t===0;tot++;if(d)done++;if(f)first++;if('recall' in st&&d){recT++;if(f)recF++}if(d&&x.t>0&&st.concept&&!rev.includes(st.concept))rev.push(st.concept);ams.forEach(a=>{per[a].tot++;if(d)per[a].done++;if(f)per[a].first++})})));\n    const ams=D.amendments.map(a=>{const q=per[a.n];const got=s.files.includes(a.n);const pct=q.done?Math.round(q.first/q.done*100):0;return {roman:ROMAN[a.n],title:a.title,level:!got?'Not completed':pct>=80?'Strong':pct>=55?'Developing':'Needs review',score:q.done?q.first+'/'+q.done:'—'}});\n    const fr=done?first/done:0;const hr=done?s.hints/done:0;const score=Math.round(fr*100-Math.min(30,hr*30));\n    let rank,note;if(!s.done){rank='IN PROGRESS — NOT YET CERTIFIED';note='Finish all ten files and the Constitutional Vault to earn a rank.'}else{rank=score>=85?'CHIEF CONSTITUTIONAL INVESTIGATOR':score>=70?'SENIOR INVESTIGATOR':score>=50?'FIELD INVESTIGATOR':'INVESTIGATOR IN TRAINING';note='Based on first-try accuracy ('+Math.round(fr*100)+'%) and independence ('+s.hints+' hints used) — not speed.'}\n    const mains=D.missions.filter(m=>m.kind==='main'),minis=D.missions.filter(m=>m.kind==='mini');\n    return {ams,rank,note,stats:[{k:'STATUS',v:s.done?'Complete':'In progress'},{k:'AMENDMENT FILES',v:s.files.length+'/10'},{k:'MAIN MISSIONS',v:mains.filter(m=>this.mDone(m)).length+'/6'},{k:'SIDE FILES',v:minis.filter(m=>this.mDone(m)).length+'/4'},{k:'FINAL VAULT',v:s.done?'Unlocked & solved':'Not completed'},{k:'CASE CHALLENGES SOLVED',v:done+'/'+tot},{k:'CORRECT ON FIRST TRY',v:first+'/'+done},{k:'MEMORY CHECKS FIRST TRY',v:recF+'/'+recT},{k:'HINTS USED',v:String(s.hints)},{k:'COMPLETED',v:s.doneAt?new Date(s.doneAt).toLocaleDateString():'—'}],review:rev.length?rev.join('; '):(done?'None flagged — nice work.':'No challenges attempted yet.')}}\n  reportText(){const r=this.report();const s=this.state.save;return ['THE RIGHTS PROTOCOL — INVESTIGATOR REPORT','Mr. Wallace’s U.S. History','Investigator: '+(s.name||'(not entered)'),'Report date: '+new Date().toLocaleString(),'',...r.stats.map(x=>x.k+': '+x.v),'','FINAL RANK: '+r.rank,r.note,'','AMENDMENT MASTERY (first-try correct / solved):',...r.ams.map(a=>'  '+a.roman.padEnd(5)+a.title.padEnd(26)+a.level.padEnd(16)+a.score),'','CONCEPTS NEEDING REVIEW: '+r.review,'','Generated from this browser’s saved game data.'].join('\\n')}\n  download(){try{const b=new Blob([this.reportText()],{type:'text/plain'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='rights-protocol-report'+(this.state.save.name?'-'+this.state.save.name.replace(/\\W+/g,'_'):'')+'.txt';document.body.appendChild(a);a.click();a.remove()}catch(e){this.toast('Download blocked — use Copy instead.')}}\n  copy(){const t=this.reportText();const done=()=>{this.setState({copied:true});setTimeout(()=>this.setState({copied:false}),2000)};if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(done,()=>this.fallbackCopy(t,done));else this.fallbackCopy(t,done)}\n  fallbackCopy(t,done){const ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');done()}catch(e){this.toast('Copy failed — use Download.')}ta.remove()}\n  // ── objective text\n  nextStep(){const s=this.state.save;if(!s)return null;const loc=s.loc;const ORD=['m1','a3','m2','m3','m4','a8','m5','a9','m6','a10'];\n    if(loc==='hq'){if(s.done)return null;if(s.files.length===10)return {label:'Open the Constitutional Vault',hid:'vault',run:()=>this.enter('vau