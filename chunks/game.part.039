  <script type="__bundler/template">"\u003C!DOCTYPE html>\n\u003Chtml>\u003Chead>\u003Cscript>\n(function(){\n  const SAVE_KEY='rightsProtocol.save.v1';\n  const ATTEMPT_KEY='rightsProtocol.pendingAttempts.v1';\n  const SESSION_KEY='rightsProtocol.session.v1';\n  let saveTimer=null,pendingState=null,saving=false;\n  let sessionId=sessionStorage.getItem(SESSION_KEY);\n  if(!sessionId){sessionId=(crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random());sessionStorage.setItem(SESSION_KEY,sessionId)}\n  const uuid=()=>crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(16).slice(2);\n  const runner=()=>window.google&&google.script&&google.script.run;\n  const pendingAttempts=()=>{try{return JSON.parse(localStorage.getItem(ATTEMPT_KEY)||'[]')}catch(e){return []}};\n  const setAttempts=q=>{try{localStorage.setItem(ATTEMPT_KEY,JSON.stringify(q.slice(-100)))}catch(e){}};\n  function flushAttempts(){const q=pendingAttempts();if(!q.length||!runner())return;google.script.run.withSuccessHandler(()=>{const ids=new Set(q.map(x=>x.eventId));setAttempts(pendingAttempts().filter(x=>!ids.has(x.eventId)))}).withFailureHandler(()=>setTimeout(flushAttempts,5000)).recordAttempts(q.slice(0,50))}\n  function flushSave(){if(saving||!pendingState||!runner())return;saving=true;const value=pendingState;google.script.run.withSuccessHandler(()=>{saving=false;if(pendingState!==value)setTimeout(flushSave,50)}).withFailureHandler(()=>{saving=false;setTimeout(flushSave,5000)}).saveStudentProgress(value,new Date().toISOString())}\n  window.__rpSaveSnapshot=function(k,v){if(k!==SAVE_KEY)return;pendingState=JSON.stringify(v);clearTimeout(saveTimer);saveTimer=setTimeout(flushSave,700)};\n  function responseFor(c,z){const st=c.st||{};try{if(st.type==='choice')return z.sel==null?'':st.options[z.sel].t;if(st.type==='multi')return (z.multi||[]).map(i=>st.options[i].t).join(' | ');if(st.type==='order')return (z.seq||[]).map(id=>st.frags.find(f=>f.id===id)?.t||id).join(' → ');if(st.type==='evidence')return (z.ev||[]).map(id=>st.pool&&st.pool.includes(id)&&id||id).join(' | ');if(st.type==='build')return st.cols.map((col,i)=>col.label+': '+(col.options[(z.build||{})[i]]?.t||'')).join(' | ');if(st.type==='match')return Object.entries(z.assign||{}).map(([itemId,catId])=>{const item=st.items.find(x=>x.id===itemId);const cat=st.cats.find(x=>x.id===catId);return (item?.t||itemId)+' → '+(cat?.label||catId)}).join(' | ');return z.typed||''}catch(e){return '[response unavailable]'}}\n  window.__rpTrackAttempt=function(c,correct,z,feedback,responseOverride){if(!c)return;let studentName='';try{studentName=(JSON.parse(localStorage.getItem(SAVE_KEY)||'{}').name||'')}catch(e){}const e={eventId:uuid(),sessionId,studentName,mission:c.m&&c.m.title||c.z&&c.z.mid||'',puzzle:c.p&&c.p.title||'',step:(c.z&&c.z.step||0)+1,questionType:c.st&&c.st.type||'',response:responseOverride||responseFor(c,z||c.z||{}),correct:!!correct,feedback:feedback||'',missesBefore:z&&z.miss||0,hintsSeen:z&&z.hint>=0?z.hint+1:0,clientTime:new Date().toISOString()};const q=pendingAttempts();q.push(e);setAttempts(q);flushAttempts()};\n  window.__rpReady=new Promise(resolve=>{if(location.protocol==='file:'){resolve();return}const started=Date.now();function begin(){if(!runner()){if(Date.now()-started\u003C12000)return setTimeout(begin,100);resolve();return}google.script.run.withSuccessHandler(data=>{try{if(data&&data.stateJson)localStorage.setItem(SAVE_KEY,data.stateJson);window.__RP_USER__=data||null}catch(e){}flushAttempts();resolve()}).withFailureHandler(()=>resolve()).loadStudentProgress()}begin()});\n  window.addEventListener('beforeunload',()=>{if(pendingState)flushSave()});\n})();\n\u003C/script>\n\u003Cmeta charset=\"utf-8\">\n\u003Cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003Cscript src=\"9da3e17a-d5f2-4b85-9397-451559af6a1c\">\u003C/script>\n\u003C/head>\n\u003Cbody>\n\n\u003