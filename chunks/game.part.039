;ams.forEach(a=>{per[a].tot++;if(d)per[a].done++;if(f)per[a].first++})})));\n    const ams=D.amendments.map(a=>{const q=per[a.n];const got=s.files.includes(a.n);const pct=q.done?Math.round(q.first/q.done*100):0;return {roman:ROMAN[a.n],title:a.title,level:!got?'Not completed':pct>=80?'Strong':pct>=55?'Developing':'Needs review',score:q.done?q.first+'/'+q.done:'—'}});\n    const fr=done?first/done:0;const hr=done?s.hints/done:0;const score=Math.round(fr*100-Math.min(30,hr*30));\n    let rank,note;if(!s.done){rank='IN PROGRESS — NOT YET CERTIFIED';note='Finish all ten files and the Constitutional Vault to earn a rank.'}else{rank=score>=85?'CHIEF CONSTITUTIONAL INVESTIGATOR':score>=70?'SENIOR INVESTIGATOR':score>=50?'FIELD INVESTIGATOR':'INVESTIGATOR IN TRAINING';note='Based on first-try accuracy ('+Math.round(fr*100)+'%) and independence ('+s.hints+' hints used) — not speed.'}\n    const mains=D.missions.filter(m=>m.kind==='main'),minis=D.missions.filter(m=>m.kind==='mini');\n    return {ams,rank,note,stats:[{k:'STATUS',v:s.done?'Complete':'In progress'},{k:'AMENDMENT FILES',v:s.files.length+'/10'},{k:'MAIN MISSIONS',v:mains.filter(m=>this.mDone(m)).length+'/6'},{k:'SIDE FILES',v:minis.filter(m=>this.mDone(m)).length+'/4'},{k:'FINAL VAULT',v:s.done?'Unlocked & solved':'Not completed'},{k:'CASE CHALLENGES SOLVED',v:done+'/'+tot},{k:'CORRECT ON FIRST TRY',v:first+'/'+done},{k:'MEMORY CHECKS FIRST TRY',v:recF+'/'+recT},{k:'HINTS USED',v:String(s.hints)},{k:'COMPLETED',v:s.doneAt?new Date(s.doneAt).toLocaleDateString():'—'}],review:rev.length?rev.join('; '):(done?'None flagged — nice work.':'No challenges attempted yet.')}}\n  reportText(){const r=this.report();const s=this.state.save;return ['THE RIGHTS PROTOCOL — PROGRESS REPORT','Mr. Wallace’s U.S. History','Investigator: '+(s.name||'(not entered)'),'Report date: '+new Date().toLocaleString(),'',...r.stats.map(x=>x.k+': '+x.v),'','FINAL RANK: '+r.rank,r.note,'','AMENDMENT MASTERY (first-try correct / solved):',...r.ams