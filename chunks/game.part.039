#38e8ff';V.pzTypeMsg=ts.done?'You got it. Press Enter or CONTINUE.':ts.off?(ts.k===0?'Start with “'+ts.next+'.”':'Check the word after “'+this.normT(z.typeReq).split(' ').slice(Math.max(0,ts.k-2),ts.k).join(' ')+'” — next word should be “'+ts.next+'.”'):'Keep going. Word order matters, but punctuation, capitals, and small typos do not.'}V.pzContLabel=z.step+1\u003Cp.steps.length?'CONTINUE ▸':'RESTORE ▸';\n    V.pzShowReset=!z.ok&&(T==='order'||T==='multi'||T==='evidence'||T==='build');V.onPzReset=()=>this.setPz({seq:[],multi:[],ev:[],build:{},fb:null});\n    V.onCheck=()=>this.check();V.onPzContinue=()=>this.pzContinue();return V}\n  infoVals(kind){const D=this.D,s=this.state.save;const B=(head,text,o={})=>({head,hasHead:!!head,text,hc:o.hc||'#38e8ff',pad:o.pad||'10px 12px',bg:o.bg||'#0d1330',border:o.border||'1px solid #1f2a5a',hasLink:!!o.link,link:o.link||''});const A=(label,fn,pri)=>({label,onClick:fn,bg:pri?'#38e8ff':'#0d1330',fg:pri?'#04060d':'#e6ecff',bd:pri?'#38e8ff':'#2f4290'});\n    if(kind==='how')return {infoTitle:'HOW TO PLAY',infoColor:'#38e8ff',infoBlocks:[B('1 · EXPLORE','Click objects in the scene, or use the CHECK THE SCENE list. Orange diamonds mark anything you have not opened yet.'),B('2 · COLLECT','Clues save to YOUR EVIDENCE automatically. Some challenges ask you to choose evidence from there.'),B('3 · SOLVE','Case challenges open when you have enough clues. If an answer misses, the feedback tells you what to rethink.'),B('4 · RECOVER','Finish every challenge in a location to bring its amendment back to the Rights Database.'),B('5 · REMEMBER','Memory checks ask for one try without notes. Your Rights Database unlocks as soon as you answer.'),B('CONTROLS','Mouse, touch, or keyboard: Tab to move, Enter/Space to select, Esc to close a window, Space to advance dialogue. Drag-and-drop is optional — tapping always works.'),B('NO TIMER','The countdown is just for drama. Take your time. Hints are unlimited.')],infoHasActions:false,infoActions:[]};\n    if(kind==='help'){const inPz=this.state.ov==='pz';return {infoTitle:'NEED HELP?',infoColor:'#ffb347',infoBlocks:inPz?[B('IN A CASE TERMINAL','Press HINT inside a challenge. You can use up to three hints, and each one gets more specific.')]:this.roomHelp(),infoHasActions:true,infoActions:[A('HOW TO PLAY',()=>this.setState({info:'how'})),A('GLOSSARY',()=>this.panel('gloss')),A('WHAT HAPPENED SO FAR',()=>this.setState({info:'transcript'})),A('SOURCES',()=>this.setState({info:'sources'}))]}}\n    if(kind==='menu')return {infoTitle:'MENU',infoColor:'#38e8ff',infoBlocks:[B('','Progress saves automatically after every action. '+(this.state.storageOk?'':'(Saving is blocked in this browser.)'))],infoHasActions:true,infoActions:[A('RESUME',()=>this.closeOv(),true),A('PROGRESS REPORT',()=>{this.setState({ov:'report',sub:null,info:null})}),A('HOW TO PLAY',()=>this.setState({info:'how'})),A('WHAT HAPPENED SO FAR',()=>this.setState({info:'transcript'})),A('SOURCES & NOTES',()=>this.setState({info:'sources'})),A('TEACHER GUIDE',()=>window.open('Teacher Guide.dc.html','_blank')),A('QUIT TO TITLE',()=>this.toTitle())]};\n    if(kind==='sources')return {infoTitle:'SOURCES & HISTORICAL NOTES',infoColor:'#f5c542',infoBlocks:D.notes.map(n=>B('NOTE',n,{hc:'#f5c542'})).concat(D.sources.map(x=>B(x.t,x.note,{link:x.u}))),infoHasActions:false,infoActions:[]};\n    if(kind==='transcript'){const sp=D.speakers;const L=(s?s.log:[]).slice(-120).map(l=>{const n=l.w==='you'?'YOU':l.w==='doc'?'EVIDENCE':(sp[l.w]||sp.sys).name;return B(n,l.t,{pad:'6px 10px',hc:l.w==='you'?'#ffb347':l.w==='doc'?'#4dff9a':((sp[l.w]||sp.sys).color)})});return {infoTitle:'WHAT HAPPENED SO FAR',infoColor:'#38e8ff',infoBlocks:L.length?L:[B('','Nothing yet.')],infoHasActions:false,infoActions:[]}}\n    if(kind==='board'){const n=s.nulls.map(id=>this.EV[id]);const blocks=[B('THE NULL ARCHITECT','Fragments found: '+n.length+' of '+D.nulls.total+'. Optional clues are hidden in each main mission. Look for small, out-of-place objects.',{hc:'#ff3fb4'})].concat(n.map(e=>B(e.title+' · '+e.place,e.body.join('\\n'),{hc:'#ff3fb4',bg:'#1a0a18',border:'1px solid #5a1a48'})));if(n.length>=4)blocks.push(B('WALLACE’S THEORY','H.P. … Office of Civic Efficiency … “ARCHITECT.” Someone senior built CIVICLOCK and wants it to run without “friction.”',{hc:'#38e8ff'}));return {infoTitle:'EVIDENCE BOARD',infoColor:'#ff3fb4',infoBlocks:blocks,infoHasActions:false,infoActions:[]}}\n    if(kind==='confirmNew')return {infoTitle:'START A START NEW GAME?',infoColor:'#ff3355',infoBlocks:[B('','This erases your saved game. Want a copy first? Open your Progress Report from CONTINUE → MENU.')],infoHasActions:true,infoActions:[A('YES, START A NEW GAME',()=>{this.setState({ov:null,info:null});this.newGame()},true),A('CANCEL',()=>this.closeOv())]};\n    return {infoTitle:'',infoColor:'#38e8ff',infoBlocks:[],infoHasActions:false,infoActions:[]}}\n}\n\u003C/script>\n\n\n\u003C/body>\u003C/html>"</script>
