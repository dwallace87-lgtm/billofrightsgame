';\n    V.pzShowReset=!z.ok&&(T==='order'||T==='multi'||T==='evidence'||T==='build');V.onPzReset=()=>this.setPz({seq:[],multi:[],ev:[],build:{},fb:null});\n    V.onCheck=()=>this.check();V.onPzContinue=()=>this.pzContinue();return V}\n  infoVals(kind){const D=this.D,s=this.state.save;const B=(head,text,o={})=>({head,hasHead:!!head,text,hc:o.hc||'#38e8ff',pad:o.pad||'10px 12px',bg:o.bg||'#0d1330',border:o.border||'1px solid #1f2a5a',hasLink:!!o.link,link:o.link||''});const A=(label,fn,pri)=>({label,onClick:fn,bg:pri?'#38e8ff':'#0d1330',fg:pri?'#04060d':'#e6ecff',bd:pri?'#38e8ff':'#2f4290'});\n    if(kind==='how')return {infoTitle:'HOW TO PLAY',infoColor:'#38e8ff',infoBlocks:[B('1 · EXPLORE','Click objects in each scene — or use the INVESTIGATE list beside it. Orange diamonds mark things you haven’t checked.'),B('2 · COLLECT','Documents go into your EVIDENCE locker automatically. Some puzzles ask you to pick evidence from it.'),B('3 · SOLVE','Case terminals open once you’ve found enough clues. Read the feedback when you miss — it explains why.'),B('4 · RECOVER','Finish every terminal in a location to recover an Amendment File for your DATABASE.'),B('5 · REMEMBER','MEMORY CHECKS ask you to answer from memory first. The database unlocks as soon as you try.'),B('CONTROLS','Mouse, touch, or keyboard: Tab to move, Enter/Space to select, Esc to close a window, Space to advance dialogue. Drag-and-drop is optional — tapping always works.'),B('NO TIMER','The countdown is just for drama. Take your time. Hints are unlimited.')],infoHasActions:false,infoActions:[]};\n    if(kind==='help'){const inPz=this.state.ov==='pz';return {infoTitle:'HELP / CLUE',infoColor:'#ffb347',infoBlocks:inPz?[B('IN A CASE TERMINAL','Press the orange HINT button inside the terminal. Each press gives a stronger hint, up to 3.')]:this.roomHelp(),infoHasActions:true,infoActions:[A('HOW TO PLAY',()=>this.setState({info:'how'})),A('GLOSSARY',()=>this.panel('gloss')),A('CASE TRANSCRIPT',()=>this.setState({in