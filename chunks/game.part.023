.stat(c.key,(x,s)=>{x.h++;s.hints++});this.sfx('hint');this.setPz({hint:h,fb:{k:'hint',t:c.st.hints[h]},tried:c.z.tried})}\n  dbLocked(){const c=this.pzCur();if(!c||this.state.ov!=='pz')return false;const r=('recall' in c.st)||c.p.noDb;return r&&!c.z.tried&&!this.state.save.steps[c.key]}\n  panel(name){this.sfx('click');if(this.state.ov&&this.state.ov!==name)this.setState({sub:name});else this.setState({ov:name,sub:null})}\n  closeTop(){if(this.state.sub)this.setState({sub:null});else this.closeOv()}\n  closeOv(){this.setState({ov:null,pz:null,confirmRestart:false,info:null});this._confirmNew=false}\n  openInfo(kind){this.setState(p=>p.ov&&p.ov!=='info'?{sub:'info',info:kind}:{ov:'info',info:kind,sub:null})}\n  // ── victory\n  victory(){this.update(s=>{s.done=true;s.doneAt=s.doneAt||Date.now()});this.setState({screen:'victory',vic:0,vicDone:false,ov:null});const fast=this.state.set.rm;let v=0;const t=setInterval(()=>{v++;this.setState({vic:v});if(v>=13){clearInterval(t);setTimeout(()=>this.say(this.D.ending.reveal.concat(this.D.ending.final),()=>this.setState({vicDone:true})),fast?50:600)}},fast?40:420);this.sfx('unlock')}\n  // ── report\n  report(){const s=this.state.save,D=this.D;const per={};for(let n=1;n<=10;n++)per[n]={tot:0,first:0,done:0};let tot=0,first=0,done=0,recT=0,recF=0;const rev=[];\n    D.missions.forEach(m=>m.puzzles.forEach(p=>p.steps.forEach((st,i)=>{if(st.type==='info')return;const k=this.pKey(m.id,p.id,i);const ams=[].concat(st.am!=null?st.am:m.am).filter(x=>x>0);const d=!!s.steps[k];const x=s.stats[k]||{t:0,h:0};const f=d&&x.t===0;tot++;if(d)done++;if(f)first++;if('recall' in st&&d){recT++;if(f)recF++}if(d&&x.t>0&&st.concept&&!rev.includes(st.concept))rev.push(st.concept);ams.forEach(a=>{per[a].tot++;if(d)per[a].done++;if(f)per[a].first++})})));\n    const ams=D.amendments.map(a=>{const q=per[a.n];const got=s.files.includes(a.n);const pct=q.done?Math.round(q.first/q.done*100):0;return {roman:ROMAN[a.n],title:a.title,level:!got?'Not completed':pct>=80?'Strong':pct>=55?'Developing':'Needs review',score:q.done?q.first+'/'+q.done:'—'}});\n    const fr=done?first/done:0;const hr=done?s.hints/done:0;const score=Math.round(fr*100-Math.min(30,hr*30));\n    let rank,note;if(!s.done){rank='IN PROGRESS — NOT YET CERTIFIED';note='Finish all ten files and the Constitutional Vault to earn a rank.'}else{rank=score>=85?'CHIEF CONSTITUTIONAL INVESTIGATOR':score>=70?'SENIOR INVESTIGATOR':score>=50?'FIELD INVESTIGATOR':'INVESTIGATOR IN TRAINING';note='Based on first-try accuracy ('+Math.round(fr*100)+'%) and independence ('+s.hints+' hints used) — not speed.'}\n    const mains=D.missions.filter(m=>m.kind==='main'),minis=D.missions.filter(m=>m.kind==='mini');\n    return {ams,rank,note,stats:[{k:'STATUS',v:s.done?'Complete':'In progress'},{k:'AMENDMENT FILES',v:s.files.length+'/10'},{k:'MAIN MISSIONS',v:mains.filter(m=>this.mDone(m)).length+'/6'},{k:'SIDE FILES',v:minis.filter(m=>this.mDone(m)).length+'/4'},{k:'FINAL VAULT',v:s.done?'Unlocked & solved':'Not completed'},{k:'CASE CHALLENGES SOLVED',v:done+'/'+tot},{k:'CORRECT ON FIRST TRY',v:first+'/'+done},{k:'MEMORY CHECKS FIRST TRY',v:recF+'/'+recT},{k:'HINTS USED',v:String(s.hints)},{k:'COMPLETED',v:s.doneAt?new Date(s.doneAt).toLocaleDateString():'—'}],review:rev.length?rev.join('; '):(done?'None flagged — nice work.':'No challenges attempted yet.')}}\n  reportText(){const r=this.report();const s=this.state.save;return ['THE RIGHTS PROTOCOL — INVESTIGATOR REPORT','Mr. Wallace’s U.S. History','Investigator: '+(s.name||'(not entered)'),'Report date: '+new Date().toLocaleString(),'',...r.stats.map(x=>x.k+': '+x.v),'','FINAL RANK: '+r.rank,r.note,'','AMENDMENT MASTERY (first-try correct / solved):',...r.ams.map(a=>'  '+a.roman.padEnd(5)+a.title.padEnd(26)+a.level.padEnd(16)+a.score),'','CONCEPTS NEEDING REVIEW: '+r.review,'','Generated from this browser’s saved game data.'].join('\\n')}\n  download(){try{const b=new Blob([this.reportText()],{type:'text/plain'});const a=docu