monds mark things you haven’t checked.'),B('2 · COLLECT','Documents go into your EVIDENCE locker automatically. Some puzzles ask you to pick evidence from it.'),B('3 · SOLVE','Case terminals open once you’ve found enough clues. Read the feedback when you miss — it explains why.'),B('4 · RECOVER','Finish every terminal in a location to recover an Amendment File for your DATABASE.'),B('5 · REMEMBER','MEMORY CHECKS ask you to answer from memory first. The database unlocks as soon as you try.'),B('CONTROLS','Mouse, touch, or keyboard: Tab to move, Enter/Space to select, Esc to close a window, Space to advance dialogue. Drag-and-drop is optional — tapping always works.'),B('NO TIMER','The countdown is just for drama. Take your time. Hints are unlimited.')],infoHasActions:false,infoActions:[]};\n    if(kind==='help'){const inPz=this.state.ov==='pz';return {infoTitle:'HELP / CLUE',infoColor:'#ffb347',infoBlocks:inPz?[B('IN A CASE TERMINAL','Press the orange HINT button inside the terminal. Each press gives a stronger hint, up to 3.')]:this.roomHelp(),infoHasActions:true,infoActions:[A('HOW TO PLAY',()=>this.setState({info:'how'})),A('GLOSSARY',()=>this.panel('gloss')),A('CASE TRANSCRIPT',()=>this.setState({info:'transcript'})),A('SOURCES',()=>this.setState({info:'sources'}))]}}\n    if(kind==='menu')return {infoTitle:'MENU',infoColor:'#38e8ff',infoBlocks:[B('','Progress saves automatically after every action. '+(this.state.storageOk?'':'(Saving is blocked in this browser.)'))],infoHasActions:true,infoActions:[A('RESUME',()=>this.closeOv(),true),A('INVESTIGATOR REPORT',()=>{this.setState({ov:'report',sub:null,info:null})}),A('HOW TO PLAY',()=>this.setState({info:'how'})),A('CASE TRANSCRIPT',()=>this.setState({info:'transcript'})),A('SOURCES & NOTES',()=>this.setState({info:'sources'})),A('TEACHER GUIDE',()=>window.open('Teacher Guide.dc.html','_blank')),A('QUIT TO TITLE',()=>this.toTitle())]};\n    if(kind==='sources')return {infoTitle:'SOURCES & HISTORICAL NOTES',infoColor:'#f5c542',infoBlocks:D.notes.map(n=>B('NOTE',n,{hc:'#f5c542'})).concat(D.sources.map(x=>B(x.t,x.note,{link:x.u}))),infoHasActions:false,infoActions:[]};\n    if(kind==='transcript'){const sp=D.speakers;const L=(s?s.log:[]).slice(-120).map(l=>{const n=l.w==='you'?'YOU':l.w==='doc'?'EVIDENCE':(sp[l.w]||sp.sys).name;return B(n,l.t,{pad:'6px 10px',hc:l.w==='you'?'#ffb347':l.w==='doc'?'#4dff9a':((sp[l.w]||sp.sys).color)})});return {infoTitle:'CASE TRANSCRIPT',infoColor:'#38e8ff',infoBlocks:L.length?L:[B('','Nothing yet.')],infoHasActions:false,infoActions:[]}}\n    if(kind==='board'){const n=s.nulls.map(id=>this.EV[id]);const blocks=[B('THE NULL ARCHITECT','Fragments found: '+n.length+' of '+D.nulls.total+'. Optional clues are hidden in each main mission. Look for small, out-of-place objects.',{hc:'#ff3fb4'})].concat(n.map(e=>B(e.title+' · '+e.place,e.body.join('\\n'),{hc:'#ff3fb4',bg:'#1a0a18',border:'1px solid #5a1a48'})));if(n.length>=4)blocks.push(B('WALLACE’S THEORY','H.P. … Office of Civic Efficiency … “ARCHITECT.” Someone senior built CIVICLOCK and wants it to run without “friction.”',{hc:'#38e8ff'}));return {infoTitle:'EVIDENCE BOARD',infoColor:'#ff3fb4',infoBlocks:blocks,infoHasActions:false,infoActions:[]}}\n    if(kind==='confirmNew')return {infoTitle:'START A NEW INVESTIGATION?',infoColor:'#ff3355',infoBlocks:[B('','This erases the saved investigation in this browser. Want a copy first? Open your Investigator Report from CONTINUE → MENU.')],infoHasActions:true,infoActions:[A('YES, START OVER',()=>{this.setState({ov:null,info:null});this.newGame()},true),A('CANCEL',()=>this.closeOv())]};\n    return {infoTitle:'',infoColor:'#38e8ff',infoBlocks:[],infoHasActions:false,infoActions:[]}}\n}\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"</script>
</body>
