  <script type="__bundler/template">"<!DOCTYPE html>\n<html><head><script>\n(function(){\n  const SAVE_KEY='rightsProtocol.save.v1';\n  const ATTEMPT_KEY='rightsProtocol.pendingAttempts.v1';\n  const SESSION_KEY='rightsProtocol.session.v1';\n  let saveTimer=null,pendingState=null,saving=false;\n  let sessionId=sessionStorage.getItem(SESSION_KEY);\n  if(!sessionId){sessionId=(crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random());sessionStorage.setItem(SESSION_KEY,sessionId)}\n  const uuid=()=>crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random().toString(16).slice(2);\n  const runner=()=>window.google&&google.script&&google.script.run;\n  const pendingAttempts=()=>{try{return JSON.parse(localStorage.getItem(ATTEMPT_KEY)||'[]')}catch(e){return []}};\n  const setAttempts=q=>{try{localStorage.setItem(ATTEMPT_KEY,JSON.stringify(q.slice(-100)))}catch(e){}};\n  function flushAttempts(){const q=pendingAttempts();if(!q.length||!runner())return;google.script.run.withSuccessHandler(()=>{const ids=new Set(q.map(x=>x.eventId));setAttempts(pendingAttempts().filter(x=>!ids.has(x.eventId)))}).withFailureHandler(()=>setTimeout(flushAttempts,5000)).recordAttempts(q.slice(0,50))}\n  function flushSave(){if(saving||!pendingState||!runner())return;saving=true;const value=pendingState;google.script.run.withSuccessHandler(()=>{saving=false;if(pendingState!==value)setTimeout(flushSave,50)}).withFailureHandler(()=>{saving=false;setTimeout(flushSave,5000)}).saveStudentProgress(value,new Date().toISOString())}\n  window.__rpSaveSnapshot=function(k,v){if(k!==SAVE_KEY)return;pendingState=JSON.stringify(v);clearTimeout(saveTimer);saveTimer=setTimeout(flushSave,700)};\n  function responseFor(c,z){const st=c.st||{};try{if(st.type==='choice')return z.sel==null?'':st.options[z.sel].t;if(st.type==='multi')return (z.multi||[]).map(i=>st.options[i].t).join(' | ');if(st.type==='order')return (z.seq||[]).map(id=>st.frags.find(f=>f.id===id)?.t||id).join(' → ');if(st.type==='evidence')return (z.ev||[]).map(id=>st.pool&&st.pool.includes(id)&&id||id).join(' | ');if(st.type==='build')return st.cols.map((col,i)=>col.label+': '+(col.options[(z.build||{})[i]]?.t||'')).join(' | ');if(st.type==='match')return Object.entries(z.assign||{}).map(([itemId,catId])=>{const item=st.items.find(x=>x.id===itemId);const cat=st.cats.find(x=>x.id===catId);return (item?.t||itemId)+' → '+(cat?.label||catId)}).join(' | ');return z.typed||''}catch(e){return '[response unavailable]'}}\n  window.__rpTrackAttempt=function(c,correct,z,feedback,responseOverride){if(!c)return;let studentName='';try{studentName=(JSON.parse(localStorage.getItem(SAVE_KEY)||'{}').name||'')}catch(e){}const e={eventId:uuid(),sessionId,studentName,mission:c.m&&c.m.title||c.z&&c.z.mid||'',puzzle:c.p&&c.p.title||'',step:(c.z&&c.z.step||0)+1,questionType:c.st&&c.st.type||'',response:responseOverride||responseFor(c,z||c.z||{}),correct:!!correct,feedback:feedback||'',missesBefore:z&&z.miss||0,hintsSeen:z&&z.hint>=0?z.hint+1:0,clientTime:new Date().toISOString()};const q=pendingAttempts();q.push(e);setAttempts(q);flushAttempts()};\n  window.__rpReady=new Promise(resolve=>{if(location.protocol==='file:'){resolve();return}const started=Date.now();function begin(){if(!runner()){if(Date.now()-started<12000)return setTimeout(begin,100);resolve();return}google.script.run.withSuccessHandler(data=>{try{if(data&&data.stateJson)localStorage.setItem(SAVE_KEY,data.stateJson);window.__RP_USER__=data||null}catch(e){}flushAttempts();resolve()}).withFailureHandler(()=>resolve()).loadStudentProgress()}begin()});\n  window.addEventListener('beforeunload',()=>{if(pendingState)flushSave()});\n})();\n<\u002Fscript>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<script src=\"9da3e17a-d5f2-4b85-9397-451559af6a1c\"><\u002Fscript>\n<\u002Fhead>\n<body>\n\n<x-dc>\n<helmet>\n<title>The Rights Protocol — Mr. Wallace’s U.S. History<\u002Ftitle>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<style>/* latin-ext */\n@font-face {\n  font-family: 'Figtree';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"79086dc7-03a1-4d34-94f4-e13bc5fe60a3\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Figtree';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"9377a548-8133-4875-8312-1cdbc339d631\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Figtree';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"79086dc7-03a1-4d34-94f4-e13bc5fe60a3\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Figtree';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"9377a548-8133-4875-8312-1cdbc339d631\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Figtree';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"79086dc7-03a1-4d34-94f4-e13bc5fe60a3\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, 