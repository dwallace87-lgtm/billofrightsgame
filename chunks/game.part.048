(this.state.dlg&&(e.key===' '||e.key==='Enter')&&!['BUTTON','INPUT','TEXTAREA','A'].includes(tag)){e.preventDefault();this.next()}}\n  // ── flow\n  newGame(){if(this.state.saved&&this.state.saved.introDone&&!this._confirmNew){this._confirmNew=true;this.openInfo('confirmNew');return}this._confirmNew=false;const s=this.fresh();this.setState({save:s,saved:s,ov:null,sub:null,pz:null});lsSet(SK,s);this.boot()}\n  boot(){this.setState({screen:'boot',boot:0,showAccept:false});clearInterval(this._bt);const fast=this.state.set.rm;this._bt=setInterval(()=>{const b=this.state.boot+1;this.setState({boot:b});if(b>=4){clearInterval(this._bt);setTimeout(()=>this.say(this.D.intro.lines,()=>this.setState({showAccept:true})),fast?100:700)}},fast?150:750)}\n  accept(){this.sfx('unlock');this.update(s=>{s.introDone=true;s.loc='hq'});this.setState({screen:'game',showAccept:false});setTimeout(()=>this.say(this.D.intro.accept),250)}\n  cont(){const s=this.state.saved;if(!s)return;this.setState({save:s,ov:null,sub:null});if(!s.introDone){this.boot();return}this.setState({screen:'game'});if(s.done&&s.loc==='vault')this.update(x=>{x.loc='hq'})}\n  toTitle(){this.setState({screen:'title',ov:null,sub:null,dlg:null,pz:null});clearInterval(this._tw)}\n  enter(loc){this.sfx('click');if(loc==='map'){const prev=this.state.save&&this.state.save.loc;const P=STAND[prev]||STAND.hq;this.setState({bot:{x:P[0],y:P[1],f:0,moving:false}})}this.setState({ov:null,sub:null,pz:null});this.update(s=>{s.loc=loc});const m=this.M[loc];if(m&&!this.state.save.intro[loc]){this.update(s=>{s.intro[loc]=1});setTimeout(()=>this.say(m.intro),200)}}\n  mDone(m){const s=this.state.save;return m.kind==='vault'?!!s.done:s.files.includes(m.am)}\n  mOpen(m){return m.req.every(id=>this.mDone(this.M[id]))}\n  curM(){const l=this.state.save&&this.state.save.loc;return l==='hq'?this.HQ:this.M[l]}\n  // ── hotspots / evidence\n  markFound(mid,hid){const k=mid+'.'+hid;if(!this.state.save.found[k])this.update(s=>{s.found[k]=1})}\n  collect(id,silent){const e=this.EV[id];if(!e)return;const isNull=e.icon==='null';const s=this.state.save;if(isNull?s.nulls.includes(id):s.inv.includes(id))return false;this.update(x=>{(isNull?x.nulls:x.inv).push(id);this.addLog(x,'doc','Collected: '+e.name)});if(!silent){this.sfx('ok');this.toast(isNull?'NULL FRAGMENT FOUND: '+e.name:'+ EVIDENCE: '+e.name)}return true}\n  hsClick(m,h){this.sfx('click');this.markFound(m.id,h.id);\n    switch(h.kind){\n      case 'doc':case 'null':this.collect(h.doc.id);this.openDoc(h.doc.id,m.id,h.id);break;\n      case 'talk':this.setState({ov:'talk',talk:{mid:m.id,hid:h.id,who:h.who,last:null,gave:null},talkMouth:8});if((this.D.speakers[h.who]||{}).anim)this.speak('What do you want to know?',null,'talkMouth');break;\n      case 'flavor':this.say(h.lines);break;\n      case 'terminal':this.terminal(m,h.id);break;\n      case 'map':this.enter('map');break;\n      case 'board':this.openInfo('board');break;\n      case 'database':this.panel('db');break;\n      case 'vault':{const v=this.M.vault;if(this.mOpen(v))this.enter('vault');else this.say([{s:'wallace',t:'The vault is sealed. It needs all ten amendment files — you have '+this.state.save.files.length+' of 10.'}]);break}\n    }}\n  openDoc(id,mid,hid){this.setState(p=>p.ov==='pz'||(p.ov&&p.ov!=='doc')?{sub:'doc',doc:{id,mid,hid}}:{ov:'doc',doc:{id,mid,hid}})}\n  ask(t,i){const m=this.M[t.mid]||this.HQ;const h=m.hotspots.find(x=>x.id===t.hid);const q=h.topics[i];let gave=null;if(q.gives){if(this.collect(q.gives,true))gave=q.gives;else gave=q.gives}this.update(s=>{s.asked[t.mid+'.'+t.hid+'.'+i]=1;this.addLog(s,'you',q.q);q.a.forEach(l=>this.addLog(s,l.s,l.t))});this.sfx('click');this.setState({talk:{...t,last:i,gave}});if((this.D.speakers[h.who]||{}).anim)this.speak(q.a.map(l=>l.t).join(' '),q.a[q.a.length-1].e,'talkMouth');if(gave)this.toast('+ EVIDENCE: '+this.EV[gave].name)}\n  // ── puzzles\n  pKey(mid,pid,i){return mid+'.'+pid+'.'+i}\n  pState(m,idx){const s=this.state.save;const p=m.puzzles[idx];if(s.solved[m.id+'.'+p.id])return 'solved';if(idx>0&&!s.solved[m.id+'.'+m.puzzles[idx-1].id])return 'wait';return p.needs.some(e=>!s.inv.includes(e))?'needs':'open'}\n  terminal(m,hid){const ps=m.puzzles;const open=ps.findIndex((p,i)=>p.at===hid&&this.pState(m,i)==='open');if(open>=0)return this.openPz(m.id,open);\n    const any=ps.findIndex((p,i)=>this.pState(m,i)==='open');const j=ps.findIndex((p,i)=>this.pState(m,i)!=='solved');\n    if(j<0){this.say([{s:'sys',t:'All case terminals in this location are restored.'}]);return}\n    if(any>=0){this.openPz(m.id,any);return}\n    const miss=ps[j].needs.filter(e=>!this.state.save.inv.includes(e)).length;this.say([{s:'sys',t:'TERMINAL LOCKED — “'+ps[j].title+'” needs '+miss+' more clue'+(miss>1?'s':'')+'. Keep investigating the room.'}])}\n  openPz(mid,idx){const m=this.M[mid];const p=m.puzzles[idx];const s=this.state.save;const att=[...p.needs,...(p.attach||[])];p.steps.forEach(x=>{if(x.type==='evidence')att.push(...x.correct);if(x.doc)att.push(x.doc)});let added=0;[...new Set(att)].forEach(id=>{if(this.EV[id]&&this.collect(id,true))added++});if(added)setTimeout(()=>this.toast('+ '+added+' CASE FILE'+(added>1?'S':'')+' ATTACHED TO EVIDENCE'),50);let step=p.steps.findIndex((st,i)=>!s.steps[this.pKey(mid,p.id,i)]);if(step<0)step=0;this.sfx('click');this.setState({ov:'pz',sub:null,pz:this.blank(mid,idx,step)})}\n  blank(mid,idx,step){return {miss:0,typeReq:null,typed:'',mid,idx,step,sel:null,multi:[],assign:{},active:null,seq:[],ev:[],build:{},fb:null,ok:false,hint:-1,tried:false}}\n  pzCur(){const z=this.state.pz;if(!z)return null;const m=this.M[z.mid];const p=m.puzzles[z.idx];return {z,m,p,st:p.steps[z.step],key:this.pKey(m.id,p.id,z.step)}}\n  setPz(o){this.setState(p=>({pz:{...p.pz,...o}}))}\n  stat(key,fn){this.update(s=>{const x=s.stats[key]||(s.stats[key]={t:0,h:0});fn(x,s)})}\n  wrong(text,responseOverride){const c=this.pzCur();if(window.__rpTrackAttempt)window.__rpTrackAttempt(c,false,c.z,text,responseOverride);if(!this.state.save.steps[c.key])this.stat(c.key,x=>{x.t++});this.sfx('bad');this.setPz({fb:{k:'bad',t:text},tried:true,miss:(c.z.miss||0)+1})}\n  right(text){const c=this.pzCur();if(window.__rpTrackAttempt)window.__rpTrackAttempt(c,true,c.z,text||c.st.explain||'Correct');this.update(s=>{s.steps[c.key]=1;if(!s.stats[c.key])s.stats[c.key]={t:0,h:0}});this.sfx('ok');const tr=c.st.type==='choice'&&c.z.miss>0?c.st.options.find(o=>o.ok).t:null;this.setPz({ok:true,tried:true,typeReq:tr,typed:'',fb:{k:'ok',t:(text||c.st.explain||'Correct. Evidence and reasoning line up.')+(tr?' Now lock it in: type the correct statement below to continue.':'')}})}\n  walkTo(id,cb){const tgt=STAND[id];const cur=this.state.bot||{x:STAND.hq[0],y:STAND.hq[1],f:0};if(!tgt||this.state.set.rm){this.setState({bot:{x:tgt?tgt[0]:cur.x,y:tgt?tgt[1]:cur.y,f:0,moving:false}});cb&&cb();return}\n    const RY=422;const pts=[[cur.x,cur.y],[cur.x,RY],[tgt[0],RY],[tgt[0],tgt[1]]];const segs=[];let tot=0;for(let i=1;i<pts.length;i++){const L=Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1]);if(L>0.5){segs.push([pts[i-1],pts[i],L]);tot+=L}}\n    if(tot<2){cb&&cb();return}const dur=Math.min(1700,Math.max(500,tot/1.1));this._walking=true;const t0=performance.now();let lastF=0,step=0;this.sfx('click');\n    const tick=now=>{const p=Math.min(1,(now-t0)/dur);let dist=p*tot,x=pts[0][0],y=pts[0][1],dx=0,dy=1;for(const [a,b,L] of segs){if(dist<=L){const k=dist/L;x=a[0]+(b[0]-a[0])*k;y=a[1]+(b[1]-a[1])*k;dx=b[0]-a[0];dy=b[1]-a[1];break}dist-=L;x=b[0];y=b[1];dx=b[0]-a[0];dy=b[1]-a[1]}\n      if(now-lastF>75){step++;lastF=now}const base=Math.abs(dx)>Math.abs(dy)?(dx>0?14:21):(dy>0?0:7);const n=base===21?6:7;\n      this.setState({bot:{x,y,f:base+(step%n),moving:p<1}});if(p<1)this._raf=requestAnimationFrame(tick);else{this._walking=false;this.setState({bot:{x,y,f:0,moving:false}});setTimeout(()=>cb&&cb(),120)}};\n    this._raf=requestAnimationFrame(tick)}\n  perm(key,n){const seed=String((this.state.save&&this.state.save.started)||1)+'|'+key;let hsh=2166136261;for(let i=0;i<seed.length;i++){hsh^=seed.charCodeAt(i);hsh=Math.imul(hsh,16777619)>>>0}const a=Array.from({length:n},(_,i)=>i);let r=hsh||1;for(let i=n-1;i>0;i--){r=Math.imul(r^(r>>>15),2246822507)>>>0;r=(r^(r>>>13))>>>0;const j=r%(i+1);[a[i],a[j]]=[a[j],a[i]]}return a}\n  openWord(k){if(!this.D.freedomWords[k])return;this.sfx('click');this.setState(p=>p.ov?{word:k,sub:'word'}:{word:k,ov:'word'})}\n  normT(t){return (t||'').toLowerCase().replace(/['’‘`“”]/g,'').replace(/[^a-z0-9 ]+/g,' ').replace(/\\s+/g,' ').trim()}\n  typeState(z){if(!z||!z.typeReq)return null;const tw=this.normT(z.typeReq).split(' '),uw=this.normT(z.typed).split(' ').filter(Boolean);const eq=(a,b)=>{if(a===b)return true;if(b.length<5||Math.abs(a.length-b.length)>1)return false;let i=0,j=0,e=0;while(i<a.length&&j<b.length){if(a[i]===b[j]){i++;j++;continue}if(++e>1)return false;if(a.length>b.length)i++;else if(a.length<b.length)j++;else{i++;j++}}return e+(a.length-i)+(b.length-j)<=1};let k=0;while(k<uw.length&&k<tw.length&&eq(uw[k],tw[k]))k++;const partial=k<uw.length&&k<tw.length&&tw[k].startsWith(uw[k])&&k===uw.length-1;const done=k===tw.length&&uw.length===tw.length;const off=!done&&k<uw.length&&!partial;return {done,k,total:tw.length,off,next:tw[k]||''}}\n  check(){const c=this.pzCur();if(!c||c.z.ok)return;const {st,z}=c;\n    if(st.type==='choice'){if(z.sel==null)return this.setPz({fb:{k:'hint',t:'Pick an answer first.'}});const o=st.options[z.sel];return o.ok?this.right(o.why):this.wrong(o.fb||'Not quite. Re-read the evidence and try again.')}\n    if(st.type==='multi'){if(!z.multi.length)return this.setPz({fb:{k:'hint',t:'Select at least one.'}});const bad=z.multi.map(i=>st.options[i]).find(o=>!o.ok);if(bad)return this.wrong(bad.fb||'One of your selections doesn’t fit.');const need=st.options.filter(o=>o.ok).length;if(z.multi.length<need)return this.wrong('Everything you picked is correct — but you’re missing '+(need-z.multi.length)+'.');return this.right()}\n    if(st.type==='order'){const seq=z.seq;const bad=seq.map(id=>st.frags.find(f=>f.id===id)).find(f=>!st.answer.includes(f.id));if(bad)return this.wrong(bad.fb||'One fragment doesn’t belong.');if(seq.length<st.answer.length)return this.wrong('Not complete yet — '+(st.answer.length-seq.length)+' more real fragment(s) needed.');if(seq.join()!==st.answer.join())return this.wrong('All the right pieces — but the order doesn’t read correctly yet.');return this.right()}\n    if(st.type==='evidence'){if(!z.ev.length)return this.setPz({fb:{k:'hint',t:'Select evidence first.'}});const bad=z.ev.find(id=>!st.correct.includes(id));if(bad)return this.wrong((st.fb&&st.fb[bad])||'That piece doesn’t support this conclusion.');if(z.ev.length<st.correct.length)return this.wrong('Good start. You need '+st.correct.length+' pieces of evidence.');return this.right()}\n    if(st.type==='build'){if(st.cols.some((c,i)=>z.build[i]==null))return this.setPz({fb:{k:'hint',t:'Choose one card in every column.'}});for(let i=0;i<st.cols.length;i++){const o=st.cols[i].options[z.build[i]];if(!o.ok)return this.wrong(st.cols[i].label+': '+(o.fb||'Not quite.'))}return this.right()}\n  }\n  place(itemId,catId){const c=this.pzCur();if(!c||c.z.ok)return;const it=c.st.items.find(x=>x.id===itemId);if(!it||c.z.assign[itemId])return;\n    if(it.cat===catId){const assign={...c.z.assign,[itemId]:catId};this.sfx('click');if(Object.keys(assign).length===c.st.items.length){this.setPz({assign,active:null});setTimeout(()=>this.right(),10)}else this.setPz({assign,active:null,tried:true,fb:{k:'ok',t:'Match confirmed. '+(Object.keys(assign).length)+' of '+c.st.items.length+' placed.'}})}\n    else{const cat=c.st.cats.find(x=>x.id===catId);this.setPz({active:null});this.wrong((it.fb&&it.fb[catId])||('Not “'+cat.label+'.” Re-read the case: what exactly is happening, and who is doing it?'),it.t+' → '+cat.label)}}\n  pzContinue(){const c=this.pzCur();if(!c)return;const {z,p,m,st}=c;if(st.type==='info'){this.update(s=>{s.steps[c.key]=1})}\n    if(z.step+1<p.steps.length){this.setState({pz:this.blank(m.id,z.idx,z.step+1)});return}\n    this.update(s=>{s.solved[m.id+'.'+p.id]=1});this.setState({ov:null,pz:null,sub:null});this.sfx('unlock');\n    this.say(p.after||[],()=>{this.checkMission(m);if(!m.puzzles.every(q=>this.state.save.solved[m.id+'.'+q.id])){const n=this.nextStep();if(n&&n.pz)setTimeout(()=>n.run(),150)}})}\n  checkMission(m){const s=this.state.save;if(!m.puzzles.every(p=>s.solved[m.id+'.'+p.id]))return;if(m.kind==='vault'){this.victory();return}if(s.files.includes(m.am))return;\n    this.update(x=>{x.files.push(m.am)});this.setState({ov:'rec',rec:{am:m.am,mid:m.id,ph:0}});const fast=this.state.set.rm;let ph=0;const t=setInterval(()=>{ph++;this.setState(p=>({rec:p.rec?{...p.rec,ph}:null}));if(ph>=4)clearInterval(t)},fast?60:650)}\n  recDone(){const r=this.state.rec;this.setState({ov:null,rec:null});const m=this.M[r.mid];this.say(m.complete,()=>this.enter('map'))}\n  hint(){const c=this.pzCur();if(!c||!c.st.hints)return;const h=Math.min(c.z.hint+1,c.st.hints.length-1);this.stat(c.key,(x,s)=>{x.h++;s.hints++});this.sfx('hint');this.setPz({hint:h,fb:{k:'hint',t:c.st.hints[h]},tried:c.z.tried})}\n  dbLocked(){const c=this.pzCur();if(!c||this.state.ov!=='pz')return false;const r=('recall' in c.st)||c.p.noDb;return r&&!c.z.tried&&!this.state.save.steps[c.key]}\n  panel(name){this.sfx('click');if(this.state.ov&&this.state.ov!==name)this.setState({sub:name});else this.setState({ov:name,sub:null})}\n  closeTop(){if(this.state.sub)this.setState({sub:null});else this.closeOv()}\n  closeOv(){this.setState({ov:null,pz:null,confirmRestart:false,info:null});this._confirmNew=false}\n  openInfo(kind){this.setState(p=>p.ov&&p.ov!=='info'?{sub:'info',info:kind}:{ov:'info',info:kind,sub:null})}\n  // ── victory\n  victory(){this.update(s=>{s.done=true;s.doneAt=s.doneAt||Date.now()});this.setState({screen:'victory',vic:0,vicDone:false,ov:null});const fast=this.state.set.rm;let v=0;const t=setInterval(()=>{v++;this.setState({vic:v});if(v>=13){clearInterval(t);setTimeout(()=>this.say(this.D.ending.reveal.concat(this.D.ending.final),()=>this.setState({vicDone:true})),fast?50:600)}},fast?40:420);this.sfx('unlock')}\n  // ── report\n  report(){const s=this.state.save,D=this.D;const per={};for(let n=1;n<=10;n++)per[n]={tot:0,first:0,done:0};let tot=0,first=0,done=0,recT=0,recF=0;const rev=[];\n    D.missions.forEach(m=>m.puzzles.forEach(p=>p.steps.forEach((st,i)=>{if(st.type==='info')return;const k=this.pKey(m.id,p.id,i);const ams=[].concat(st.am!=null?st.am:m.am).filter(x=>x>0);const d=!!s.steps[k];const x=s.stats[k]||{t:0,h:0};const f=d&&x.t===0;tot++;if(d)done++;if(f)first++;if('recall' in st&&d){recT++;if(f)recF++}if(d&&x.t>0&&st.concept&&!rev.includes(st.concept))rev.push(st.concept);ams.forEach(a=>{per[a].tot++;if(d)per[a].done++;if(f)per[a].first++})})));\n    const ams=D.amendments.map(a=>{const q=per[a.n];const got=s.files.includes(a.n);const pct=q.done?Math.round(q.first/q.done*100):0;return {roman:ROMAN[a.n],title:a.title,level:!got?'Not completed':pct>=80?'Strong':pct>=55?'Developing':'Needs review',score:q.done?q.first+'/'+q.done:'—'}});\n    const fr=done?first/done:0;const hr=done?s.hints/done:0;const score=Math.round(fr*100-Math.min(30,hr*30));\n    let rank,note;if(!s.done){rank='IN PROGRESS — NOT YET CERTIFIED';note='Finish all ten files and the Constitutional Vault to earn a rank.'}else{rank=score>=85?'CHIEF CONSTITUTIONAL INVESTIGATOR':score>=70?'SENIOR INVESTIGATOR':score>=50?'FIELD INVESTIGATOR':'INVESTIGATOR IN TRAINING';note='Based on first-try accuracy ('+Math.round(fr*100)+'%) and independence ('+s.hints+' hints used) — not speed.'}\n    const mains=D.missions.filter(m=>m.kind==='main'),minis=D.missions.filter(m=>m.kind==='mini');\n    return {ams,rank,note,stats:[{k:'STATUS',v:s.done?'Complete':'In progress'},{k:'AMENDMENT FILES',v:s.files.length+'/10'},{k:'MAIN MISSIONS',v:mains.filter(m=>this.mDone(m)).length+'/6'},{k:'SIDE FILES',v:minis.filter(m=>this.mDone(m)).length+'/4'},{k:'FINAL VAULT',v:s.done?'Unlocked & solved':'Not completed'},{k:'CASE CHALLENGES SOLVED',v:done+'/'+tot},{k:'CORRECT ON FIRST TRY',v:first+'/'+done},{k:'MEMORY CHECKS FIRST TRY',v:recF+'/'+recT},{k:'HINTS USED',v:String(s.hints)},{k:'COMPLETED',v:s.doneAt?new Date(s.doneAt).toLocaleDateString():'—'}],review:rev.length?rev.join('; '):(done?'None flagged — nice work.':'No challenges attempted yet.')}}\n  reportText(){const r=this.report();const s=this.state.save;return ['THE RIGHTS PROTOCOL — INVESTIGATOR REPORT','Mr. Wallace’s U.S. History','Investigator: '+(s.name||'(not entered)'),'Report date: '+new Date().toLocaleString(),'',...r.stats.map(x=>x.k+': '+x.v),'','FINAL RANK: '+r.rank,r.note,'','AMENDMENT MASTERY (first-try correct / solved):',...r.ams.map(a=>'  '+a.roman.padEnd(5)+a.title.padEnd(26)+a.level.padEnd(16)+a.score),'','CONCEPTS NEEDING REVIEW: '+r.review,'','Generated from this browser’s saved game data.'].join('\\n')}\n  download(){try{const b=new Blob([this.reportText()],{type:'text/plain'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='rights-protocol-report'+(this.state.save.name?'-'+this.state.save.name.replace(/\\W+/g,'_'):'')+'.txt';document.body.appendChild(a);a.click();a.remove()}catch(e){this.toast('Download blocked — use Copy instead.')}}\n  copy(){const t=this.reportText();const done=()=>{this.setState({copied:true});setTimeout(()=>this.setState({copied:false}),2000)};if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(t).then(done,()=>this.fallbackCopy(t,done));else this.fallbackCopy(t,done)}\n  fallbackCopy(t,done){const ta=document.createElement('textarea');ta.value=t;document.body.appendChild(ta);ta.select();try{document.execCommand('copy');done()}catch(e){this.toast('Copy failed — use Download.')}ta.remove()}\n  // ── objective text\n  nextStep(){const s=this.state.save;if(!s)return null;const loc=s.loc;const ORD=['m1','a3','m2','m3','m4','a8','m5','a9','m6','a10'];\n    if(loc==='hq'){if(s.done)return null;if(s.files.length===10)return {label:'Open the Constitutional Vault',hid:'vault',run:()=>this.enter('vault')};return {label:'Open the city map',hid:'map',run:()=>this.enter('map')}}\n    if(loc==='map'){if(s.files.length===10&&!s.done)return {label:'Return to HQ and open the vault',mapId:'hq',run:()=>this.enter('hq')};const id=ORD.find(x=>this.mOpen(this.M[x])&&!this.mDone(this.M[x]));return id?{label:'Go to '+this.M[id].place,mapId:id,run:()=>this.enter(id)}:null}\n    const m=this.M[loc];if(!m)return null;if(this.mDone(m))return {label:'Return to the city map',run:()=>this.enter('map')};\n    const j=m.puzzles.findIndex((p,i)=>this.pState(m,i)!=='solved');if(j<0)return null;const p=m.puzzles[j];const miss=p.needs.find(e=>!s.inv.includes(e));\n    if(miss){const hs=m.hotspots.find(x=>x.doc&&x.doc.id===miss)||m.hotspots.find(x=>x.topics&&x.topics.some(t=>t.gives===miss));if(hs)return {label:'Inspect the '+hs.label.charAt(0).toLowerCase()+hs.label.slice(1),hid:hs.id,run:()=>this.hsClick(m,hs)}}\n    return {label:'Open the case terminal “'+p.title+'”',hid:p.at,pz:true,run:()=>this.openPz(m.id,j)}}\n  objective(){const s=this.state.save;if(!s)return '';{const n=this.nextStep();if(s.loc!=='hq'&&s.loc!=='map'&&n)return 'Next step: '+n.label+'.'}const loc=s.loc;const D=this.D;\n    if(loc==='hq'){if(s.done)return 'Mission complete. Review your files or open your Investigator Report from the menu.';if(s.files.length===10)return 'All ten files recovered. Open the Constitutional Vault.';if(!s.files.length)return 'Open the city map and head to Signal District.';return 'Open the city map and choose your next location.'}\n    if(loc==='map'){if(s.files.length===10&&!s.done)return 'All ten files recovered! Return to HQ and open the vault.';const open=D.missions.filter(m=>m.kind!=='vault'&&this.mOpen(m)&&!this.mDone(m)).map(m=>m.place);return open.length?'Choose a location. Open now: '+open.join(', ')+'.':'Choose a location to review.'}\n    const m=this.M[loc];if(!m)return '';if(this.mDone(m))return 'File recovered. Return to the city map.';const j=m.puzzles.findIndex((p,i)=>this.pState(m,i)!=='solved');if(j<0)return '';const p=m.puzzles[j];const st=this.pState(m,j);\n    if(st==='needs'){const have=p.needs.filter(e=>s.inv.includes(e)).length;return m.explore+' ('+have+'/'+p.needs.length+' clues for “'+p.title+'”)'}return 'Open the case terminal: “'+p.title+'.”'}\n  roomHelp(){const s=this.state.save;const m=this.curM();const L=[];if(!m||this.state.save.loc==='map'){L.push({head:'WHERE TO GO',text:this.objective()})}else{L.push({head:'OBJECTIVE',text:this.objective()});const j=m.puzzles.findIndex((p,i)=>this.pState(m,i)!=='solved');if(j>=0&&this.pState(m,j)==='needs'){const miss=m.puzzles[j].needs.filter(e=>!s.inv.includes(e));const labels=miss.map(e=>{const ev=this.EV[e];const h=m.hotspots.find(x=>x.id===ev.hid);return h?h.label:(ev.from||ev.name)});L.push({head:'CLUE',text:'Unread evidence is waiting. Objects with an orange diamond haven’t been inspected yet. Try: '+labels.slice(0,2).join(', ')+(labels.length>2?'…':'')})}}\n    L.push({head:'HOW HINTS WORK',text:'Inside any case terminal, press HINT. Each press gives a stronger hint (up to 3). Hints are unlimited — they’re noted on your report, but slow reading never costs you anything.'});return L}\n  // ── render\n  renderVals(){const __V=this.__rv();__V.RES=RES;return __V}\n  __rv(){\n    const st=this.state,set=st.set,s=st.save,D=this.D;\n    const V={loading:!st.ready,rm:set.rm?'1':'0',fs:(16*set.fs)+'px',isTitle:st.ready&&st.screen==='title',isBoot:st.screen==='boot',isGame:st.screen==='game'&&!!s,isVictory:st.screen==='victory'};\n    const filesN=s?s.files.length:0;\n    Object.assign(V,{filesN,integrity:(filesN*10)+'%',closeOv:()=>this.closeOv(),closeTop:()=>this.closeTop(),allowDrop:e=>e.preventDefault(),\n      onInv:()=>this.panel('inv'),onDb:()=>this.panel('db'),onGlos